{lib, ...}: let
  inherit (lib) fileset;
  # flake.nix is generated by flake-file in its own style, so only hand-written
  # Nix under modules/ and packages/ is linted.
  nixSources = fileset.toSource {
    root = ../..;
    fileset =
      fileset.intersection
      (fileset.unions [../../modules ../../packages])
      (fileset.fileFilter (file: file.hasExt "nix") ../..);
  };
  # Repository shell scripts; the vendored pstack skills are imported unchanged.
  shellScripts = fileset.toSource {
    root = ../..;
    fileset =
      fileset.intersection
      (fileset.unions [
        ../../scripts
        ../../.github/scripts
        (fileset.difference ../../modules ../../modules/development/ai-skills/pstack)
      ])
      (fileset.fileFilter (file: file.hasExt "sh" || file.hasExt "command") ../..);
  };
  # Repository Python, again without the vendored pstack skills.
  pythonSources = fileset.toSource {
    root = ../..;
    fileset =
      fileset.intersection
      (fileset.difference ../.. ../../modules/development/ai-skills/pstack)
      (fileset.fileFilter (file: file.hasExt "py") ../..);
  };
in {
  perSystem = {pkgs, ...}: {
    formatter = pkgs.alejandra;
    checks.lint = pkgs.runCommand "repository-lint" {nativeBuildInputs = with pkgs; [actionlint alejandra deadnix findutils ruff shellcheck statix];} ''
      alejandra --check ${nixSources}
      deadnix --fail ${nixSources}
      statix check --config ${../../statix.toml} ${nixSources}
      find ${shellScripts} -type f -print0 | xargs -0 shellcheck --external-sources
      ruff check --no-cache --config ${../../ruff.toml} ${pythonSources}
      actionlint ${../../.github/workflows}/*.yml
      touch "$out"
    '';
  };
}
