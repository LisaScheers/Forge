{lib, ...}: let
  # flake.nix is generated by flake-file in its own style, so only hand-written
  # Nix under modules/ and packages/ is linted.
  sources = lib.fileset.toSource {
    root = ../..;
    fileset =
      lib.fileset.intersection
      (lib.fileset.unions [../../modules ../../packages])
      (lib.fileset.fileFilter (file: file.hasExt "nix") ../..);
  };
in {
  perSystem = {pkgs, ...}: {
    formatter = pkgs.alejandra;
    checks.lint = pkgs.runCommand "nix-lint" {nativeBuildInputs = with pkgs; [alejandra deadnix statix];} ''
      alejandra --check ${sources}
      deadnix --fail ${sources}
      statix check --config ${../../statix.toml} ${sources}
      touch "$out"
    '';
  };
}
