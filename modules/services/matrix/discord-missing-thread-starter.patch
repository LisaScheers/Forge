diff --git a/missing_thread_starter_test.go b/missing_thread_starter_test.go
new file mode 100644
index 0000000..9290e8a
--- /dev/null
+++ b/missing_thread_starter_test.go
@@ -0,0 +1,63 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/bwmarrin/discordgo"
+	"maunium.net/go/mautrix/event"
+)
+
+func TestMissingStarterRequiresConfirmedUnknownMessage(t *testing.T) {
+	for _, tc := range []struct {
+		status, code int
+		allowed      bool
+	}{
+		{404, discordgo.ErrCodeUnknownMessage, true},
+		{403, discordgo.ErrCodeMissingAccess, false},
+		{404, discordgo.ErrCodeUnknownChannel, false},
+		{500, discordgo.ErrCodeUnknownMessage, false},
+	} {
+		err := &discordgo.RESTError{Response: &http.Response{StatusCode: tc.status}, Message: &discordgo.APIErrorMessage{Code: tc.code}}
+		if confirmedMissingThreadStarter(err) != tc.allowed {
+			t.Fatalf("status=%d code=%d", tc.status, tc.code)
+		}
+	}
+	for _, err := range []error{nil, errors.New("network unavailable"), &discordgo.RESTError{}} {
+		if confirmedMissingThreadStarter(err) {
+			t.Fatal("unconfirmed failure accepted as missing source")
+		}
+	}
+}
+
+func TestMissingStarterNoticeHasExplicitImportProvenance(t *testing.T) {
+	content := missingThreadStarterContent(&discordgo.Channel{ID: "thread", Name: "Example <thread>"}, "guild")
+	parsed := content.Parsed.(*event.MessageEventContent)
+	if parsed.MsgType != event.MsgNotice || parsed.FormattedBody != "" || !strings.Contains(parsed.Body, "created at import time") || !strings.Contains(parsed.Body, "https://discord.com/channels/guild/thread") {
+		t.Fatalf("incorrect migration notice: %#v", parsed)
+	}
+	provenance := content.Raw["fi.mau.discord.missing_thread_starter"].(map[string]interface{})
+	if provenance["thread_id"] != "thread" || provenance["original_starter_available"] != false {
+		t.Fatal("missing explicit unavailable-source metadata")
+	}
+}
+
+func TestRecipientRemovalKeepsNativeTimestampCapablePart(t *testing.T) {
+	var portal *Portal
+	got := portal.convertDiscordTextMessage(context.Background(), nil, &discordgo.Message{Type: discordgo.MessageTypeRecipientRemove})
+	if got == nil || got.Type != event.EventMessage || got.Content.MsgType != event.MsgEmote || got.Content.Body != "removed a recipient" {
+		t.Fatal("empty recipient removal was lost")
+	}
+}
+
+func TestRecipientRemovalKeepsRecipientIdentityAndText(t *testing.T) {
+ var portal *Portal
+ got := portal.convertDiscordTextMessage(context.Background(), nil, &discordgo.Message{Type: discordgo.MessageTypeRecipientRemove, Content: "source detail", Mentions: []*discordgo.User{{ID: "123", Username: "Example"}}})
+ if got == nil { t.Fatal("recipient removal disappeared") }
+ for _, text := range []string{"removed a recipient", "Example", "Discord ID 123", "source detail"} {
+  if !strings.Contains(got.Content.Body, text) { t.Fatalf("recipient removal lost %q", text) }
+ }
+}
