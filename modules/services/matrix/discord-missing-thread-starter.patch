+
+func confirmedMissingThreadStarter(err error) bool {
+	var restError *discordgo.RESTError
+	return errors.As(err, &restError) && restError.Response != nil && restError.Response.StatusCode == http.StatusNotFound && restError.Message != nil && restError.Message.Code == discordgo.ErrCodeUnknownMessage
+}
+
+func missingThreadStarterContent(meta *discordgo.Channel, guildID string) *event.Content {
+	return &event.Content{
+		Parsed: &event.MessageEventContent{
+			MsgType: event.MsgNotice,
+			Body:    fmt.Sprintf("Imported Discord thread: %s\nThe original starter is unavailable (Discord returned Unknown Message). This migration notice was created at import time.\nhttps://discord.com/channels/%s/%s", meta.Name, guildID, meta.ID),
+		},
+		Raw: map[string]interface{}{
+			"fi.mau.discord.missing_thread_starter": map[string]interface{}{"thread_id": meta.ID, "original_starter_available": false},
+		},
+	}
+}
