@@ -0,0 +1,33 @@
+package main
+
+import (
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"maunium.net/go/mautrix/event"
+)
+
+func TestRelayReactionAttribution(t *testing.T) {
+	if got := relayReactionText("Alice", "👍"); got != "Alice (Matrix) reacted 👍" {
+		t.Fatal(got)
+	}
+	got := relayReactionText("Alice\n**Moderator**", "👍\nspoofed message")
+	if strings.Contains(got, "\n") || strings.Contains(got, "**Moderator**") {
+		t.Fatalf("unescaped attribution: %q", got)
+	}
+	got = relayReactionText(strings.Repeat("😀", 1000), strings.Repeat("👍", 1000))
+	if !utf8.ValidString(got) || len([]rune(got)) > 300 {
+		t.Fatal("oversized or invalid Unicode reaction notice")
+	}
+}
+
+func TestRelayThreadUnicodeName(t *testing.T) {
+	for _, body := range []string{"", "  \n\t", strings.Repeat("😀", 100), "SEC-Hive\nthread root"} {
+		evt := &event.Event{Content: event.Content{Parsed: &event.MessageEventContent{Body: body}}}
+		name := genThreadName(evt)
+		if !utf8.ValidString(name) || len([]rune(name)) > 40 || name == "" || strings.Contains(name, "\n") {
+			t.Fatalf("invalid thread name: %q", name)
+		}
+	}
+}
