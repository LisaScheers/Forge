+package main
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/bwmarrin/discordgo"
+	"maunium.net/go/mautrix/event"
+)
+
+// Thread creation needs a bot session; webhook sends still retain each Matrix
+// member's name. Never select a personal Discord session for this fallback.
+func (portal *Portal) relayBotSession() *discordgo.Session {
+	if portal.RelayWebhookID == "" || portal.GuildID == "" {
+		return nil
+	}
+	for _, userID := range portal.bridge.DB.GetUsersInPortal(portal.GuildID) {
+		user := portal.bridge.GetCachedUserByMXID(userID)
+		if user != nil && user.Session != nil && !user.Session.IsUser {
+			return user.Session
+		}
+	}
+	return nil
+}
+
+func relayReactionText(name, key string) string {
+	// Matrix reaction keys are arbitrary strings. Bound the notice and prevent
+	// formatting or line breaks from making the attribution look like a message.
+	nameRunes := []rune(strings.Join(strings.Fields(name), " "))
+	keyRunes := []rune(strings.Join(strings.Fields(key), " "))
+	name = string(nameRunes[:min(len(nameRunes), 150)])
+	key = string(keyRunes[:min(len(keyRunes), 100)])
+	return fmt.Sprintf("%s (Matrix) reacted %s", escapeDiscordMarkdown(name), escapeDiscordMarkdown(key))
+}
+
+func (portal *Portal) handleRelayReaction(sender *User, evt *event.Event) {
+	relation := evt.Content.AsReaction().RelatesTo
+	if relation.Type != event.RelAnnotation {
+		go portal.sendMessageMetrics(evt, errUnknownRelationType, "Ignoring")
+		return
+	}
+	target := portal.bridge.DB.Message.GetByMXID(portal.Key, relation.EventID)
+	if target == nil {
+		go portal.sendMessageMetrics(evt, errTargetNotFound, "Ignoring")
+		return
+	}
+	// A Matrix ID cannot collide with a numeric Discord user ID. Persist both
+	// the reaction identity and its webhook notice using existing mappings.
+	if portal.bridge.DB.Reaction.GetByDiscordID(portal.Key, target.DiscordID, sender.MXID.String(), relation.Key) != nil ||
+		portal.bridge.DB.Message.GetByMXID(portal.Key, evt.ID) != nil {
+		go portal.sendMessageMetrics(evt, nil, "")
+		return
+	}
+	name, _ := portal.getRelayUserMeta(sender)
+	params := &discordgo.WebhookParams{
+		Content:         relayReactionText(name, relation.Key),
+		Username:        "Matrix reactions",
+		AllowedMentions: &discordgo.MessageAllowedMentions{Parse: []discordgo.AllowedMentionType{}},
+		Embeds: []*discordgo.MessageEmbed{{
+			Description: fmt.Sprintf("[Reacted to message](https://discord.com/channels/%s/%s/%s)", portal.GuildID, target.DiscordProtoChannelID(), target.DiscordID),
+			Footer:      &discordgo.MessageEmbedFooter{Text: sender.MXID.String()},
+		}},
+	}
+	notice, err := relayClient.WebhookThreadExecute(portal.RelayWebhookID, portal.RelayWebhookSecret, true, target.ThreadID, params)
+	go portal.sendMessageMetrics(evt, err, "Error sending reaction notice")
+	if err != nil || notice == nil {
+		return
+	}
+	mapping := portal.bridge.DB.Message.New()
+	mapping.Channel = portal.Key
+	mapping.DiscordID = notice.ID
+	mapping.MXID = evt.ID
+	mapping.SenderID = portal.RelayWebhookID
+	mapping.SenderMXID = sender.MXID
+	mapping.Timestamp, _ = discordgo.SnowflakeTimestamp(notice.ID)
+	mapping.ThreadID = target.ThreadID
+	mapping.Insert()
+	first := portal.bridge.DB.Message.GetFirstByDiscordID(portal.Key, target.DiscordID)
+	reaction := portal.bridge.DB.Reaction.New()
+	reaction.Channel = portal.Key
+	reaction.MessageID = target.DiscordID
+	reaction.FirstAttachmentID = first.AttachmentID
+	reaction.Sender = sender.MXID.String()
+	reaction.EmojiName = relation.Key
+	reaction.ThreadID = target.ThreadID
+	reaction.MXID = evt.ID
+	reaction.Insert()
+}
