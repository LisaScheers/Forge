+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"go.mau.fi/mautrix-discord/database"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+	"maunium.net/go/mautrix/appservice"
+	"maunium.net/go/mautrix/bridge/bridgeconfig"
+	"maunium.net/go/mautrix/bridge/commands"
+	"maunium.net/go/mautrix/id"
+)
+
+type historicalReaction struct {
+	Reaction *discordgo.MessageReaction
+	Actor    *discordgo.User
+	Kinds    []int
+	Done     chan struct{}
+	Applied  bool
+}
+
+type reactionActor struct {
+	User  *discordgo.User
+	Kinds []int
+}
+
+type sourceReaction struct {
+	Count  int `json:"count"`
+	Counts *struct {
+		Normal int `json:"normal"`
+		Burst  int `json:"burst"`
+	} `json:"count_details"`
+	Emoji discordgo.Emoji `json:"emoji"`
+}
+
+func (reaction sourceReaction) kinds() []int {
+	if reaction.Count == 0 {
+		return nil
+	}
+	if reaction.Counts == nil {
+		return []int{0, 1}
+	}
+	var kinds []int
+	if reaction.Counts.Normal > 0 {
+		kinds = append(kinds, 0)
+	}
+	if reaction.Counts.Burst > 0 {
+		kinds = append(kinds, 1)
+	}
+	return kinds
+}
+
+// Discord paginates each reaction kind separately; a person may have both kinds.
+func collectReactionActors(kinds []int, fetch func(int, string) ([]*discordgo.User, error)) ([]reactionActor, error) {
+	actors := make(map[string]*reactionActor)
+	for _, kind := range kinds {
+		after := ""
+		seen := make(map[string]bool)
+		for {
+			users, err := fetch(kind, after)
+			if err != nil {
+				return nil, err
+			}
+			var cursor uint64
+			for _, user := range users {
+				if user == nil {
+					return nil, fmt.Errorf("nil reaction user")
+				}
+				numeric, err := strconv.ParseUint(user.ID, 10, 64)
+				if err != nil || seen[user.ID] {
+					return nil, fmt.Errorf("invalid or repeated reaction user ID")
+				}
+				seen[user.ID] = true
+				if numeric > cursor {
+					cursor = numeric
+				}
+				actor := actors[user.ID]
+				if actor == nil {
+					actor = &reactionActor{User: user}
+					actors[user.ID] = actor
+				}
+				actor.Kinds = append(actor.Kinds, kind)
+			}
+			if len(users) < 100 {
+				break
+			}
+			next := strconv.FormatUint(cursor, 10)
+			previous, _ := strconv.ParseUint(after, 10, 64)
+			if cursor <= previous {
+				return nil, fmt.Errorf("reaction pagination did not advance")
+			}
+			after = next
+		}
+	}
+	result := make([]reactionActor, 0, len(actors))
+	for _, actor := range actors {
+		result = append(result, *actor)
+	}
+	sort.Slice(result, func(i, j int) bool { return compareMessageIDs(result[i].User.ID, result[j].User.ID) < 0 })
+	return result, nil
+}
+
+func reactionActors(ctx context.Context, session *discordgo.Session, channelID, messageID string, emoji discordgo.Emoji, kinds []int) ([]reactionActor, error) {
+	return collectReactionActors(kinds, func(kind int, after string) ([]*discordgo.User, error) {
+		return session.MessageReactions(channelID, messageID, emoji.APIName(), 100, "", after, discordgo.WithQueryParam("type", strconv.Itoa(kind)), discordgo.WithContext(ctx))
+	})
+}
+
+func (puppet *Puppet) reactionRemovalIntent(portal *Portal, originalSender id.UserID) *appservice.IntentAPI {
+	if originalSender == puppet.MXID {
+		return puppet.DefaultIntent()
+	}
+	current := puppet.IntentFor(portal)
+	if current.UserID == originalSender {
+		return current
+	}
+	// Linking/unlinking must not leave a source reaction that the bridge can't remove.
+	return portal.MainIntent()
+}
+
+var cmdImportReactions = &commands.FullHandler{
+	Func:           wrapCommand(fnImportReactions),
+	Name:           "import-reactions",
+	Help:           commands.HelpMeta{Section: HelpSectionPortalManagement, Description: "Import current Discord reactors for already bridged messages (bridge admins only)", Args: "<message ID> [message ID...]"},
+	RequiresPortal: true, RequiresLogin: true, RequiresEventLevel: roomModerator,
+}
+
+func fnImportReactions(ce *WrappedCommandEvent) {
+	if ce.User.PermissionLevel < bridgeconfig.PermissionLevelAdmin || ce.Portal.GuildID == "" || len(ce.Args) == 0 || len(ce.Args) > 20 {
+		ce.Reply("Bridge administrators may specify 1–20 already bridged guild message IDs")
+		return
+	}
+	for _, messageID := range ce.Args {
+		if _, err := strconv.ParseUint(messageID, 10, 64); err != nil {
+			ce.Reply("Invalid message ID")
+			return
+		}
+		if ce.Bridge.DB.Message.GetFirstByDiscordID(ce.Portal.Key, messageID) == nil {
+			ce.Reply("Import and verify every target message first")
+			return
+		}
+	}
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Minute)
+		defer cancel()
+		imported := 0
+		for _, messageID := range ce.Args {
+			count, err := ce.Portal.importMessageReactions(ctx, ce.User, messageID)
+			if err != nil {
+				ce.Reply("Reaction import stopped after %d mappings: %v", imported, err)
+				return
+			}
+			imported += count
+		}
+		ce.Reply("Verified %d Discord reactor mappings. Reaction times are unavailable; imported events use the import time.", imported)
+	}()
+}
+
+func (portal *Portal) importMessageReactions(ctx context.Context, user *User, messageID string) (int, error) {
+	message := portal.bridge.DB.Message.GetFirstByDiscordID(portal.Key, messageID)
+	if message == nil {
+		return 0, fmt.Errorf("target message is no longer bridged")
+	}
+	channelID := portal.Key.ChannelID
+	var thread *Thread
+	if message.ThreadID != "" {
+		meta, err := user.Session.Channel(message.ThreadID, discordgo.WithContext(ctx))
+		if err != nil || !canImportPublicThread(meta, channelID) {
+			return 0, fmt.Errorf("thread is not an accessible public thread in this portal")
+		}
+		channelID = message.ThreadID
+		thread = portal.bridge.GetThreadByID(message.ThreadID, nil)
+	}
+	body, err := user.Session.RequestWithBucketID("GET", discordgo.EndpointChannelMessage(channelID, messageID), nil, discordgo.EndpointChannelMessage(channelID, ""), discordgo.WithContext(ctx))
+	if err != nil {
+		return 0, err
+	}
+	var snapshot struct {
+		ID        string           `json:"id"`
+		ChannelID string           `json:"channel_id"`
+		Reactions []sourceReaction `json:"reactions"`
+	}
+	if err = json.Unmarshal(body, &snapshot); err != nil {
+		return 0, err
+	}
+	if snapshot.ID != messageID || snapshot.ChannelID != channelID {
+		return 0, fmt.Errorf("reaction source does not match target")
+	}
+	total := 0
+	for _, reaction := range snapshot.Reactions {
+		actors, err := reactionActors(ctx, user.Session, channelID, messageID, reaction.Emoji, reaction.kinds())
+		if err != nil {
+			return total, err
+		}
+		for _, actor := range actors {
+			request := &historicalReaction{Reaction: &discordgo.MessageReaction{UserID: actor.User.ID, MessageID: messageID, ChannelID: channelID, GuildID: portal.GuildID, Emoji: reaction.Emoji}, Actor: actor.User, Kinds: actor.Kinds, Done: make(chan struct{})}
+			// The portal loop serializes these with live reactions and Matrix writes.
+			select {
+			case portal.discordMessages <- portalDiscordMessage{msg: request, user: user, thread: thread}:
+			case <-ctx.Done():
+				return total, ctx.Err()
+			}
+			select {
+			case <-request.Done:
+			case <-ctx.Done():
+				return total, ctx.Err()
+			}
+			if !request.Applied || portal.reactionMapping(messageID, actor.User.ID, reaction.Emoji) == nil {
+				return total, fmt.Errorf("reaction mapping was not created for %s", messageID)
+			}
+			total++
+		}
+	}
+	return total, nil
+}
+
+// Custom emoji IDs remain stable when their human-readable names change.
+func (portal *Portal) reactionMapping(messageID, userID string, emoji discordgo.Emoji) *database.Reaction {
+	existing := portal.bridge.DB.Reaction.GetByDiscordID(portal.Key, messageID, userID, emoji.APIName())
+	if existing != nil || emoji.ID == "" {
+		return existing
+	}
+	for _, candidate := range portal.bridge.DB.Reaction.GetAllForMessage(portal.Key, messageID) {
+		if candidate.Sender == userID && strings.HasSuffix(candidate.EmojiName, ":"+emoji.ID) {
+			return candidate
+		}
+	}
+	return nil
+}
+
+func importedReactionActorPresent(user *User, channelID, messageID, userID string, emoji discordgo.Emoji) (bool, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	actors, err := reactionActors(ctx, user.Session, channelID, messageID, emoji, []int{0, 1})
+	if err != nil {
+		return false, err
+	}
+	for _, actor := range actors {
+		if actor.User.ID == userID {
+			return true, nil
+		}
+	}
+	return false, nil
+}
