+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/bwmarrin/discordgo"
+	"go.mau.fi/mautrix-discord/database"
+	"maunium.net/go/mautrix/appservice"
+)
+
+func TestReactionHistoryIncludesEveryPageAndBothKinds(t *testing.T) {
+	calls := 0
+	actors, err := collectReactionActors([]int{0, 1}, func(kind int, after string) ([]*discordgo.User, error) {
+		calls++
+		if kind == 1 {
+			return []*discordgo.User{{ID: "101"}, {ID: "102"}}, nil
+		}
+		if after == "100" {
+			return []*discordgo.User{{ID: "101"}}, nil
+		}
+		if after != "" {
+			t.Fatalf("wrong pagination cursor: %s", after)
+		}
+		users := make([]*discordgo.User, 100)
+		for i := range users {
+			users[i] = &discordgo.User{ID: fmt.Sprint(i + 1)}
+		}
+		return users, nil
+	})
+	if err != nil || calls != 3 || len(actors) != 102 {
+		t.Fatalf("roster incomplete: actors=%d calls=%d error=%v", len(actors), calls, err)
+	}
+	if actors[100].User.ID != "101" || len(actors[100].Kinds) != 2 || actors[101].User.ID != "102" {
+		t.Fatal("normal/burst overlap lost its identity or kinds")
+	}
+	_, err = collectReactionActors([]int{0}, func(int, string) ([]*discordgo.User, error) { return []*discordgo.User{{ID: "1"}, {ID: "1"}}, nil })
+	if err == nil {
+		t.Fatal("repeated source user must fail rather than silently double counting")
+	}
+}
+
+func TestSourceReactionKindsSurviveSDKMetadataLimit(t *testing.T) {
+	var reaction sourceReaction
+	if err := json.Unmarshal([]byte(`{"count":2,"count_details":{"normal":1,"burst":1},"emoji":{"name":"x"}}`), &reaction); err != nil {
+		t.Fatal(err)
+	}
+	if kinds := reaction.kinds(); len(kinds) != 2 || kinds[0] != 0 || kinds[1] != 1 {
+		t.Fatalf("superreactions omitted: %v", kinds)
+	}
+	reaction.Counts = nil
+	if len(reaction.kinds()) != 2 {
+		t.Fatal("missing count details must not silently omit a kind")
+	}
+}
+
+func TestReactionRemovalRetainsOriginalGhostAfterAccountLink(t *testing.T) {
+	as := appservice.Create()
+	as.HomeserverDomain = "test"
+	as.Registration = &appservice.Registration{AppToken: "test-only", SenderLocalpart: "bot"}
+	if err := as.SetHomeserverURL("https://test"); err != nil {
+		t.Fatal(err)
+	}
+	br := &DiscordBridge{}
+	br.AS = as
+	bot := as.Intent("@bot:test")
+	br.Bot = bot
+	custom := as.Intent("@linked:test")
+	custom.IsCustomPuppet = true
+	puppet := &Puppet{bridge: br, MXID: "@discord_actor:test", customIntent: custom}
+	portal := &Portal{bridge: br, Portal: &database.Portal{Key: database.NewPortalKey("channel", "")}}
+	ghost := puppet.reactionRemovalIntent(portal, puppet.MXID)
+	if ghost.IsCustomPuppet || ghost.UserID != puppet.MXID {
+		t.Fatal("linked user could not redact the original historical ghost reaction")
+	}
+	if puppet.reactionRemovalIntent(portal, custom.UserID) != custom {
+		t.Fatal("ordinary linked reaction lost its author")
+	}
+	if puppet.reactionRemovalIntent(portal, "@formerly-linked:test") != bot {
+		t.Fatal("changed account link would leave a permanent stale reaction")
+	}
+}
