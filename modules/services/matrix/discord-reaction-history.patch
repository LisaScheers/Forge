+func TestReactionImportCompletionBindsExactCommandAndTargets(t *testing.T) {
+	for _, failure := range []error{nil, fmt.Errorf("source changed")} {
+		requested := []string{"100", "200"}
+		content := reactionImportReplyContent("$command:test", "channel", requested, 7, failure)
+		requested[0] = "different"
+		payload, err := json.Marshal(content)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var decoded struct {
+			MsgType event.MessageType     `json:"msgtype"`
+			Receipt reactionImportReceipt `json:"dev.bylisa.sec_hive.reaction_import"`
+		}
+		if err = json.Unmarshal(payload, &decoded); err != nil {
+			t.Fatal(err)
+		}
+		wantStatus := "complete"
+		if failure != nil {
+			wantStatus = "error"
+		}
+		if decoded.MsgType != event.MsgNotice || decoded.Receipt.Version != 1 || decoded.Receipt.CommandEventID != "$command:test" || decoded.Receipt.ChannelID != "channel" || decoded.Receipt.Status != wantStatus || decoded.Receipt.ReactorMappings != 7 || len(decoded.Receipt.RequestedMessageIDs) != 2 || decoded.Receipt.RequestedMessageIDs[0] != "100" || decoded.Receipt.RequestedMessageIDs[1] != "200" {
+			t.Fatal("completion receipt lost exact command, target, status or count binding")
+		}
+	}
+}
