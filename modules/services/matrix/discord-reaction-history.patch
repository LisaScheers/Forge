+func TestHistoricalReactionKindRefreshPreservesActorEmojiAndTarget(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		kinds   []int
+		change  string
+		refresh bool
+	}{
+		{name: "changed imported kinds", kinds: []int{1}, refresh: true},
+		{name: "matching kinds", kinds: []int{0}},
+		{name: "ordinary live request", kinds: nil},
+		{name: "ordinary live event", kinds: []int{1}, change: "live"},
+		{name: "human sender", kinds: []int{1}, change: "human"},
+		{name: "invalid imported tag", kinds: []int{1}, change: "invalid"},
+		{name: "wrong native target", kinds: []int{1}, change: "target"},
+		{name: "wrong emoji", kinds: []int{1}, change: "emoji"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			raw, err := sql.Open("sqlite3", ":memory:")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer raw.Close()
+			raw.SetMaxOpenConns(1)
+			base, err := dbutil.NewWithDB(raw, "sqlite3")
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, statement := range []string{
+				"CREATE TABLE message (dcid TEXT, dc_attachment_id TEXT, dc_chan_id TEXT, dc_chan_receiver TEXT, dc_sender TEXT, timestamp BIGINT, dc_edit_timestamp BIGINT, dc_thread_id TEXT, mxid TEXT, sender_mxid TEXT)",
+				"CREATE TABLE reaction (dc_msg_id TEXT, dc_first_attachment_id TEXT, dc_sender TEXT, dc_emoji_name TEXT, dc_chan_id TEXT, dc_chan_receiver TEXT, dc_thread_id TEXT, mxid TEXT)",
+			} {
+				if _, err = raw.Exec(statement); err != nil {
+					t.Fatal(err)
+				}
+			}
+			room, ghost := id.RoomID("!room:test"), id.UserID("@discord_actor:test")
+			original := map[string]any{"event_id": "$old:test", "room_id": room, "type": "m.reaction", "sender": ghost,
+				"content": map[string]any{"m.relates_to": map[string]any{"rel_type": "m.annotation", "event_id": "$part:test", "key": "👍"},
+					"fi.mau.discord.source_reaction": true, "fi.mau.discord.imported_reaction": map[string]any{"types": []int{0}, "original_timestamp_available": false}}}
+			content := original["content"].(map[string]any)
+			switch test.change {
+			case "live":
+				delete(content, "fi.mau.discord.imported_reaction")
+			case "human":
+				original["sender"] = "@human:test"
+			case "invalid":
+				content["fi.mau.discord.imported_reaction"] = map[string]any{"types": []int{0, 0}, "original_timestamp_available": false}
+			case "target":
+				content["m.relates_to"].(map[string]any)["event_id"] = "$outside:test"
+			case "emoji":
+				content["m.relates_to"].(map[string]any)["key"] = "other"
+			}
+			redactions, sends, unexpected := 0, 0, 0
+			var sent map[string]any
+			hs := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				switch {
+				case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/event/"):
+					_ = json.NewEncoder(w).Encode(original)
+				case request.Method == http.MethodPut && strings.Contains(request.URL.Path, "/redact/"):
+					redactions++
+					if request.URL.Query().Get("user_id") != string(ghost) {
+						t.Error("refresh redacted as a different actor")
+					}
+					_ = json.NewEncoder(w).Encode(map[string]string{"event_id": "$redaction:test"})
+				case request.Method == http.MethodPut && strings.Contains(request.URL.Path, "/send/m.reaction/"):
+					sends++
+					if request.URL.Query().Get("user_id") != string(ghost) {
+						t.Error("refresh sent as a different actor")
+					}
+					if err := json.NewDecoder(request.Body).Decode(&sent); err != nil {
+						t.Error(err)
+					}
+					_ = json.NewEncoder(w).Encode(map[string]string{"event_id": "$new:test"})
+				default:
+					unexpected++
+					http.Error(w, "unexpected membership or external request", http.StatusBadRequest)
+				}
+			}))
+			defer hs.Close()
+			as := appservice.Create()
+			as.HomeserverDomain = "test"
+			as.Registration = &appservice.Registration{AppToken: "test-only", SenderLocalpart: "bot"}
+			if err = as.SetHomeserverURL(hs.URL); err != nil {
+				t.Fatal(err)
+			}
+			for _, actor := range []id.UserID{ghost, "@bot:test"} {
+				as.StateStore.MarkRegistered(actor)
+				as.StateStore.SetMembership(room, actor, event.MembershipJoin)
+			}
+			br := &DiscordBridge{Config: &config.Config{}, DB: database.New(base, maulogger.Create()), puppets: make(map[string]*Puppet)}
+			br.AS, br.Bot = as, as.Intent("@bot:test")
+			br.puppets["actor"] = &Puppet{Puppet: &database.Puppet{ID: "actor"}, bridge: br, MXID: ghost}
+			portal := &Portal{Portal: &database.Portal{Key: database.NewPortalKey("channel", ""), MXID: room, GuildID: "guild"}, bridge: br, log: zerolog.Nop()}
+			message := br.DB.Message.New()
+			message.DiscordID, message.Channel, message.SenderID = "message", portal.Key, "author"
+			message.Timestamp, message.SenderMXID = time.UnixMilli(42), ghost
+			message.MassInsertParts([]database.MessagePart{{AttachmentID: "", MXID: "$primary:test"}, {AttachmentID: "file", MXID: "$part:test"}})
+			reaction := br.DB.Reaction.New()
+			reaction.Channel, reaction.MessageID, reaction.FirstAttachmentID, reaction.Sender, reaction.EmojiName, reaction.MXID = portal.Key, "message", "file", "actor", "👍", "$old:test"
+			reaction.Insert()
+			portal.handleDiscordReactionWithHistory(nil, &discordgo.MessageReaction{UserID: "actor", MessageID: "message", ChannelID: "channel", GuildID: "guild", Emoji: discordgo.Emoji{Name: "👍"}}, true, nil, nil, test.kinds)
+			mapped := portal.reactionMapping("message", "actor", discordgo.Emoji{Name: "👍"})
+			if unexpected != 0 {
+				t.Fatal("kind refresh changed membership or made an unrelated request")
+			}
+			if test.refresh {
+				if redactions != 1 || sends != 1 || mapped == nil || mapped.MXID != "$new:test" {
+					t.Fatal("changed kinds were not replaced exactly once")
+				}
+				relation := sent["m.relates_to"].(map[string]any)
+				metadata := sent["fi.mau.discord.imported_reaction"].(map[string]any)
+				if relation["event_id"] != "$part:test" || strings.ReplaceAll(relation["key"].(string), "\ufe0f", "") != "👍" || len(metadata["types"].([]any)) != 1 || metadata["types"].([]any)[0] != float64(1) {
+					t.Fatal("refresh changed native part, emoji or current kinds")
+				}
+			} else if redactions != 0 || sends != 0 || mapped == nil || mapped.MXID != "$old:test" {
+				t.Fatal("matching, ordinary or unproven reaction was changed")
+			}
+		})
+	}
+}
