+func TestReactionRemovalRetainsOriginalGhostAfterAccountLink(t *testing.T) {
+	as := appservice.Create()
+	as.HomeserverDomain = "test"
+	as.Registration = &appservice.Registration{AppToken: "test-only", SenderLocalpart: "bot"}
+	if err := as.SetHomeserverURL("https://test"); err != nil {
+		t.Fatal(err)
+	}
+	br := &DiscordBridge{}
+	br.AS = as
+	bot := as.Intent("@bot:test")
+	br.Bot = bot
+	custom := as.Intent("@linked:test")
+	custom.IsCustomPuppet = true
+	puppet := &Puppet{bridge: br, MXID: "@discord_actor:test", customIntent: custom}
+	portal := &Portal{bridge: br, Portal: &database.Portal{Key: database.NewPortalKey("channel", "")}}
+	ghost := puppet.reactionRemovalIntent(portal, puppet.MXID)
+	if ghost.IsCustomPuppet || ghost.UserID != puppet.MXID {
+		t.Fatal("linked user could not redact the original historical ghost reaction")
+	}
+	if puppet.reactionRemovalIntent(portal, custom.UserID) != custom {
+		t.Fatal("ordinary linked reaction lost its author")
+	}
+	if puppet.reactionRemovalIntent(portal, "@formerly-linked:test") != bot {
+		t.Fatal("changed account link would leave a permanent stale reaction")
+	}
+}
