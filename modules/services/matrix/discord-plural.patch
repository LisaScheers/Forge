+++ b/plural_queue_test.go
@@ -0,0 +1,75 @@
+package main
+
+import (
+	"database/sql"
+	"path/filepath"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+	"maunium.net/go/mautrix/appservice"
+	"maunium.net/go/mautrix/id"
+)
+
+func TestPluralIdentityIsLocal(t *testing.T) {
+	br := &DiscordBridge{}
+	br.AS = &appservice.AppService{HomeserverDomain: "test"}
+	for user, expected := range map[id.UserID]bool{
+		"@plural_bot:test": true, "@_plural_owner_alice:test": true,
+		"@plural_bot:other": false, "@_plural_owner_alice:other": false, "@alice:test": false,
+	} {
+		if br.isPluralIdentity(user) != expected {
+			t.Fatalf("incorrect identity classification: %s", user)
+		}
+	}
+	t.Setenv("PLURALMATRIX_ROOMS", "!reviewed:test")
+	if !pluralRoomEnabled("!reviewed:test") || pluralRoomEnabled("!unreviewed:test") || pluralRoomEnabled("") {
+		t.Fatal("room allowlist widened")
+	}
+}
+
+func TestPluralSpoolPersistsAndKeepsRoomOrder(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "queue.sqlite")
+	db, err := sql.Open("sqlite3", filename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec(pluralQueueSchema); err != nil {
+		t.Fatal(err)
+	}
+	for _, row := range []struct {
+		id, room       string
+		timestamp, due int64
+	}{{"first", "A", 1, 100}, {"second", "A", 2, 0}, {"independent", "B", 3, 0}} {
+		if _, err = db.Exec(`INSERT INTO sec_hive_plural_pending(event_id,room_id,payload,queued_at,next_attempt) VALUES(?,?,?,?,?)`, row.id, row.room, "{}", row.timestamp, row.due); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err = db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	db, err = sql.Open("sqlite3", filename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	rows, err := db.Query(pluralPendingQuery, 50)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	var ids []string
+	for rows.Next() {
+		var eventID, room, payload string
+		var attempts int
+		if err = rows.Scan(&eventID, &room, &payload, &attempts); err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, eventID)
+	}
+	if err = rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	if len(ids) != 1 || ids[0] != "independent" {
+		t.Fatalf("backoff allowed overtaking or blocked another room: %v", ids)
+	}
+}
