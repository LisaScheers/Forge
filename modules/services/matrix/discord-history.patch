+package main
+
+import (
+	"context"
+	"testing"
+
+	"github.com/bwmarrin/discordgo"
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/appservice"
+	"go.mau.fi/mautrix-discord/database"
+)
+
+func TestHistoricalSystemEventsSurviveConversion(t *testing.T) {
+	for _, test := range []struct { kind discordgo.MessageType; body string }{
+		{discordgo.MessageTypeChannelPinnedMessage, "pinned a message"},
+		{discordgo.MessageTypeUserPremiumGuildSubscription, "boosted the server"},
+		{discordgo.MessageTypeUserPremiumGuildSubscriptionTierOne, "boosted the server (boost level 1 reached)"},
+		{discordgo.MessageTypeUserPremiumGuildSubscriptionTierTwo, "boosted the server (boost level 2 reached)"},
+		{discordgo.MessageTypeUserPremiumGuildSubscriptionTierThree, "boosted the server (boost level 3 reached)"},
+	} {
+		// Exercise the real text-conversion entry point; these events have no text.
+		var portal *Portal
+		got := portal.convertDiscordTextMessage(context.Background(), nil, &discordgo.Message{Type: test.kind})
+		if got == nil || got.Type != event.EventMessage || got.Content.MsgType != event.MsgEmote || got.Content.Body != test.body {
+			t.Fatalf("system event %d was not preserved: %#v", test.kind, got)
+		}
+	}
+	if convertDiscordSystemMessage(&discordgo.Message{Type: discordgo.MessageTypeDefault, Content: "ordinary text"}) != nil {
+		t.Fatal("ordinary text must retain the existing converter")
+	}
+	var portal *Portal
+	starter := portal.convertDiscordTextMessage(context.Background(), nil, &discordgo.Message{Type: discordgo.MessageTypeThreadStarterMessage})
+	if starter == nil || starter.Content.MsgType != event.MsgNotice || starter.Content.Body == "" {
+		t.Fatal("empty thread-starter wrappers must retain a mapped structural notice")
+	}
+}
+
+func TestThreadHistoryImportDoesNotWidenPrivateOrUnrelatedAccess(t *testing.T) {
+	for _, test := range []struct { meta *discordgo.Channel; allowed bool }{
+		{nil, false},
+		{&discordgo.Channel{Type: discordgo.ChannelTypeGuildPublicThread, ParentID: "approved"}, true},
+		{&discordgo.Channel{Type: discordgo.ChannelTypeGuildPublicThread, ParentID: "other"}, false},
+		{&discordgo.Channel{Type: discordgo.ChannelTypeGuildPrivateThread, ParentID: "approved"}, false},
+		{&discordgo.Channel{Type: discordgo.ChannelTypeGuildText, ParentID: "approved"}, false},
+	} {
+		if got := canImportPublicThread(test.meta, "approved"); got != test.allowed {
+			t.Fatalf("unexpected import permission for %#v: %v", test.meta, got)
+		}
+	}
+}
+
+func TestHistoricalMessagesUseTimestampCapableGhostAndKeepLiveIdentity(t *testing.T) {
+	as := appservice.Create()
+	as.HomeserverDomain = "bridge.test"
+	as.Registration = &appservice.Registration{AppToken: "test-only", SenderLocalpart: "bot"}
+	if err := as.SetHomeserverURL("https://bridge.test"); err != nil { t.Fatal(err) }
+	br := &DiscordBridge{}
+	br.AS = as
+	custom := &appservice.IntentAPI{IsCustomPuppet: true}
+	puppet := &Puppet{bridge: br, MXID: "@discord_source:bridge.test", customIntent: custom}
+	portal := &Portal{Portal: &database.Portal{Key: database.NewPortalKey("channel", "")}}
+	historical := puppet.messageIntent(portal, true)
+	if historical.IsCustomPuppet || !historical.SetAppServiceUserID || historical.UserID != puppet.MXID {
+		t.Fatal("historical import would use a real account token and lose its timestamp")
+	}
+	if puppet.messageIntent(portal, false) != custom {
+		t.Fatal("live messages must retain the linked identity")
+	}
+}
+
+func TestReadOnlyMirrorIsScopedAndReportsPermanentPermissionFailure(t *testing.T) {
+	t.Setenv("SEC_HIVE_READ_ONLY_CHANNELS", "rules, other")
+	for _, test := range []struct { id string; blocked bool }{{"rules", true}, {"other", true}, {"rule", false}, {"", false}, {"chat", false}} {
+		if readOnlyMirrorChannel(test.id) != test.blocked { t.Fatalf("wrong read-only policy for %q", test.id) }
+	}
+	reason, status, certain, notice, message, _ := errorToStatusReason(errReadOnlyMirror)
+	if reason != event.MessageStatusNoPermission || status != event.MessageStatusFail || !certain || !notice || message == "" {
+		t.Fatal("read-only writes must fail clearly without retrying")
+	}
+}
