+package main
+
+import (
+	"fmt"
+	"html"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+)
+
+// Snapshot media belongs to the forwarding message, not its inaccessible source
+// portal. Copy slices so later edits of the cached raw message remain independent.
+func withForwardedMedia(msg *discordgo.Message) *discordgo.Message {
+	if msg.MessageReference == nil || msg.MessageReference.Type != discordgo.MessageReferenceTypeForward || len(msg.MessageSnapshots) == 0 {
+		return msg
+	}
+	copy := *msg
+	copy.Attachments = append([]*discordgo.MessageAttachment{}, msg.Attachments...)
+	copy.StickerItems = append([]*discordgo.StickerItem{}, msg.StickerItems...)
+	copy.Embeds = append([]*discordgo.MessageEmbed{}, msg.Embeds...)
+	for _, snapshot := range msg.MessageSnapshots {
+		if snapshot.Message == nil {
+			continue
+		}
+		copy.Attachments = append(copy.Attachments, snapshot.Message.Attachments...)
+		copy.StickerItems = append(copy.StickerItems, snapshot.Message.StickerItems...)
+		copy.Embeds = append(copy.Embeds, snapshot.Message.Embeds...)
+	}
+	return &copy
+}
+
+func pollMediaText(media *discordgo.PollMedia) string {
+	if media == nil {
+		return ""
+	}
+	text := media.Text
+	if emoji := media.Emoji; emoji != nil {
+		label := emoji.Name
+		if emoji.ID != "" {
+			label = fmt.Sprintf("<:%s:%s>", emoji.Name, emoji.ID)
+		}
+		text = strings.TrimSpace(label + " " + text)
+	}
+	return text
+}
+
+func discordPollHTML(poll *discordgo.Poll) string {
+	if poll == nil {
+		return ""
+	}
+	var body strings.Builder
+	body.WriteString("<blockquote><strong>Discord poll snapshot</strong><br>" + html.EscapeString(pollMediaText(&poll.Question)) + "<ul>")
+	counts := map[int]int{}
+	finalized := poll.Results != nil && poll.Results.Finalized
+	if poll.Results != nil {
+		for _, count := range poll.Results.AnswerCounts {
+			if count != nil {
+				counts[count.ID] = count.Count
+			}
+		}
+	}
+	for _, answer := range poll.Answers {
+		label := html.EscapeString(pollMediaText(answer.Media))
+		count, known := counts[answer.AnswerID]
+		if known || finalized {
+			label += fmt.Sprintf(" — %d votes", count)
+		} else {
+			label += " — vote count unavailable"
+		}
+		fmt.Fprintf(&body, "<li>%s</li>", label)
+	}
+	body.WriteString("</ul>")
+	if poll.AllowMultiselect {
+		body.WriteString("Multiple answers allowed. ")
+	} else {
+		body.WriteString("Single answer. ")
+	}
+	if finalized {
+		body.WriteString("Final results. ")
+	} else {
+		body.WriteString("Results are not final. ")
+	}
+	if poll.Expiry != nil {
+		body.WriteString("Closes: " + poll.Expiry.UTC().Format(time.RFC3339) + ". ")
+	}
+	body.WriteString("Voting remains on Discord.</blockquote>")
+	return body.String()
+}
+
+func discordComponentsHTML(components []discordgo.MessageComponent) string {
+	var body strings.Builder
+	for _, component := range components {
+		switch item := component.(type) {
+		case *discordgo.Container:
+			body.WriteString(discordComponentsHTML(item.Components))
+		case *discordgo.ActionsRow:
+			body.WriteString(discordComponentsHTML(item.Components))
+		case *discordgo.Section:
+			body.WriteString(discordComponentsHTML(item.Components))
+			if item.Accessory != nil {
+				body.WriteString(discordComponentsHTML([]discordgo.MessageComponent{item.Accessory}))
+			}
+		case *discordgo.TextDisplay:
+			body.WriteString("<p>" + strings.ReplaceAll(html.EscapeString(item.Content), "\n", "<br>") + "</p>")
+		case *discordgo.Button:
+			body.WriteString("<p>Discord button: " + html.EscapeString(item.Label) + "</p>")
+			body.WriteString(componentMediaLink(item.URL, "Button link"))
+		case *discordgo.MediaGallery:
+			for _, entry := range item.Items {
+				label := "Discord gallery media"
+				if entry.Description != nil && *entry.Description != "" {
+					label = *entry.Description
+				}
+				body.WriteString(componentMediaLink(entry.Media.URL, label))
+			}
+		case *discordgo.FileComponent:
+			body.WriteString(componentMediaLink(item.File.URL, "Discord component file"))
+		}
+	}
+	return body.String()
+}
+
+func componentMediaLink(rawURL, label string) string {
+	parsed, err := url.Parse(rawURL)
+	if err != nil || parsed.Host == "" || (parsed.Scheme != "https" && parsed.Scheme != "http") {
+		return ""
+	}
+	return "<p><a href=\"" + html.EscapeString(rawURL) + "\">" + html.EscapeString(label) + "</a></p>"
+}
