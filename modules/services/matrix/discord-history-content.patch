+package main
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/bwmarrin/discordgo"
+	"go.mau.fi/mautrix-discord/config"
+)
+
+func TestDiscordPollHistoryKeepsAnswersAndCounts(t *testing.T) {
+	portal := &Portal{bridge: &DiscordBridge{Config: &config.Config{}}}
+	poll := &discordgo.Poll{Question: discordgo.PollMedia{Text: "<question>"}, Answers: []discordgo.PollAnswer{{AnswerID: 1, Media: &discordgo.PollMedia{Text: "one"}}, {AnswerID: 2, Media: &discordgo.PollMedia{Text: "two"}}}, Results: &discordgo.PollResults{Finalized: true, AnswerCounts: []*discordgo.PollAnswerCount{{ID: 2, Count: 7}}}}
+	got := portal.convertDiscordTextMessage(context.Background(), nil, &discordgo.Message{Poll: poll})
+	if got == nil {
+		t.Fatal("poll-only message disappeared")
+	}
+	for _, text := range []string{"<question>", "one — 0 votes", "two — 7 votes", "Final results", "Voting remains on Discord"} {
+		if !strings.Contains(got.Content.Body, text) {
+			t.Fatalf("poll lost %q: %q", text, got.Content.Body)
+		}
+	}
+	if strings.Contains(got.Content.FormattedBody, "<question>") {
+		t.Fatal("poll text was interpreted as HTML")
+	}
+	poll.Results = nil
+	unknown := discordPollHTML(poll)
+	if !strings.Contains(unknown, "vote count unavailable") || strings.Contains(unknown, "0 votes") {
+		t.Fatal("unknown results were invented")
+	}
+}
+
+func TestDiscordPollResultEmbedSurvivesConversion(t *testing.T) {
+	portal := &Portal{bridge: &DiscordBridge{Config: &config.Config{}}}
+	got := portal.convertDiscordTextMessage(context.Background(), nil, &discordgo.Message{Type: discordgo.MessageType(46), Embeds: []*discordgo.MessageEmbed{{Type: discordgo.EmbedType("poll_result"), Fields: []*discordgo.MessageEmbedField{{Name: "poll_question_text", Value: "A question"}, {Name: "victor_answer_text", Value: "An answer"}, {Name: "total_votes", Value: "17"}}}}})
+	if got == nil {
+		t.Fatal("poll-result message disappeared")
+	}
+	for _, text := range []string{"A question", "An answer", "17"} {
+		if !strings.Contains(got.Content.Body, text) {
+			t.Fatalf("poll result lost %q", text)
+		}
+	}
+}
+
+func TestForwardedMediaStaysWithForwardingMessage(t *testing.T) {
+	original := &discordgo.Message{ID: "forward", Attachments: []*discordgo.MessageAttachment{{ID: "own"}}, MessageReference: &discordgo.MessageReference{Type: discordgo.MessageReferenceTypeForward}, MessageSnapshots: []discordgo.MessageSnapshot{{Message: &discordgo.Message{Attachments: []*discordgo.MessageAttachment{{ID: "snapshot"}}, StickerItems: []*discordgo.StickerItem{{ID: "sticker"}}, Embeds: []*discordgo.MessageEmbed{{URL: "snapshot-embed"}}}}, {Message: nil}}}
+	got := withForwardedMedia(original)
+	if got.ID != "forward" || len(got.Attachments) != 2 || got.Attachments[1].ID != "snapshot" || len(got.StickerItems) != 1 || len(got.Embeds) != 1 {
+		t.Fatal("forwarded media was dropped or reassigned")
+	}
+	got.Attachments[0] = nil
+	if original.Attachments[0] == nil || len(original.Attachments) != 1 || len(original.Embeds) != 0 {
+		t.Fatal("normalization changed cached source data")
+	}
+	reply := *original
+	reply.MessageReference = &discordgo.MessageReference{Type: discordgo.MessageReferenceTypeDefault}
+	if withForwardedMedia(&reply) != &reply {
+		t.Fatal("ordinary replies must not import the referenced message's media")
+	}
+}
+
+func TestNestedDiscordComponentTextIsPreserved(t *testing.T) {
+	var message discordgo.Message
+	err := json.Unmarshal([]byte(`{"components":[{"type":17,"components":[{"type":10,"content":"First line\n<second>"},{"type":12,"items":[{"media":{"url":"https://example.test/image"},"description":"Image caption"}]},{"type":1,"components":[{"type":2,"label":"Continue","custom_id":"action"}]}]}]}`), &message)
+	if err != nil {
+		t.Fatal(err)
+	}
+	portal := &Portal{bridge: &DiscordBridge{Config: &config.Config{}}}
+	got := portal.convertDiscordTextMessage(context.Background(), nil, &message)
+	if got == nil {
+		t.Fatal("component-only message disappeared")
+	}
+	for _, text := range []string{"First line", "<second>", "Image caption", "Continue", "Use the Discord app"} {
+		if !strings.Contains(got.Content.Body, text) {
+			t.Fatalf("component lost %q: %q", text, got.Content.Body)
+		}
+	}
+	if !strings.Contains(got.Content.FormattedBody, "https://example.test/image") || strings.Contains(got.Content.FormattedBody, "<second>") {
+		t.Fatal("component media/text were not represented safely")
+	}
+	if componentMediaLink("javascript:bad()", "x") != "" {
+		t.Fatal("unsafe component link")
+	}
+}
