@@ -0,0 +1,90 @@
+package main
+
+import (
+	"fmt"
+	"sort"
+
+	"go.mau.fi/util/dbutil"
+
+	"go.mau.fi/mautrix-discord/database"
+)
+
+type relayBackfillKey struct {
+	database.PortalKey
+	ThreadID string
+}
+
+// Snapshot before dispatching READY: queued Matrix sends and later gateway
+// events must not advance the cursor past Discord messages missed offline.
+const relayBackfillSnapshotSQL = `
+	SELECT p.dcid, p.receiver, '', '0'
+	FROM portal p
+	WHERE COALESCE(p.mxid, '') <> '' AND COALESCE(p.relay_webhook_id, '') <> ''
+	UNION ALL
+	SELECT p.dcid, p.receiver, t.dcid, '0'
+	FROM portal p JOIN thread t ON t.parent_chan_id=p.dcid
+	WHERE COALESCE(p.mxid, '') <> '' AND COALESCE(p.relay_webhook_id, '') <> ''
+	UNION ALL
+	SELECT m.dc_chan_id, m.dc_chan_receiver, COALESCE(m.dc_thread_id, ''),
+	       CAST(MAX(CAST(m.dcid AS BIGINT)) AS TEXT)
+	FROM message m JOIN portal p ON p.dcid=m.dc_chan_id AND p.receiver=m.dc_chan_receiver
+	WHERE COALESCE(p.mxid, '') <> '' AND COALESCE(p.relay_webhook_id, '') <> ''
+	  AND m.dc_sender<>p.relay_webhook_id
+	GROUP BY m.dc_chan_id, m.dc_chan_receiver, m.dc_thread_id
+`
+
+func readRelayBackfillSnapshot(db *dbutil.Database) (map[relayBackfillKey]string, error) {
+	rows, err := db.Query(relayBackfillSnapshotSQL)
+	if err != nil {
+		return nil, fmt.Errorf("snapshot relay recovery cursors: %w", err)
+	}
+	defer rows.Close()
+	anchors := make(map[relayBackfillKey]string)
+	for rows.Next() {
+		var key relayBackfillKey
+		var messageID string
+		if err = rows.Scan(&key.ChannelID, &key.Receiver, &key.ThreadID, &messageID); err != nil {
+			return nil, err
+		}
+		if _, exists := anchors[key]; !exists || messageID != "0" {
+			anchors[key] = messageID
+		}
+	}
+	return anchors, rows.Err()
+}
+
+func (user *User) captureRelayBackfillSnapshot() {
+	anchors, err := readRelayBackfillSnapshot(user.bridge.DB.Database)
+	if err != nil {
+		panic(err)
+	}
+	user.relayBackfillLock.Lock()
+	user.relayBackfillAnchors = anchors
+	user.relayBackfillLock.Unlock()
+}
+
+func (user *User) takeRelayBackfillAnchor(portal database.PortalKey, threadID string) (string, bool) {
+	key := relayBackfillKey{PortalKey: portal, ThreadID: threadID}
+	user.relayBackfillLock.Lock()
+	defer user.relayBackfillLock.Unlock()
+	anchor, exists := user.relayBackfillAnchors[key]
+	delete(user.relayBackfillAnchors, key)
+	return anchor, exists
+}
+
+func (user *User) backfillKnownRelayThreads(portal *Portal) {
+	user.relayBackfillLock.Lock()
+	var threadIDs []string
+	for key := range user.relayBackfillAnchors {
+		if key.PortalKey == portal.Key && key.ThreadID != "" {
+			threadIDs = append(threadIDs, key.ThreadID)
+		}
+	}
+	user.relayBackfillLock.Unlock()
+	sort.Strings(threadIDs)
+	for _, threadID := range threadIDs {
+		if thread := user.bridge.GetThreadByID(threadID, nil); thread != nil {
+			portal.ForwardBackfillMissed(user, "", thread)
+		}
+	}
+}
