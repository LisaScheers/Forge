+package main
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+	"go.mau.fi/util/dbutil"
+
+	"go.mau.fi/mautrix-discord/database"
+)
+
+func TestRelayRecoverySnapshot(t *testing.T) {
+	raw, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	raw.SetMaxOpenConns(1)
+	db, err := dbutil.NewWithDB(raw, "sqlite3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, statement := range []string{
+		`CREATE TABLE portal (dcid TEXT, receiver TEXT, mxid TEXT, relay_webhook_id TEXT)`,
+		`CREATE TABLE thread (dcid TEXT, parent_chan_id TEXT)`,
+		`CREATE TABLE message (dcid TEXT, dc_chan_id TEXT, dc_chan_receiver TEXT, dc_thread_id TEXT, dc_sender TEXT)`,
+		`INSERT INTO portal VALUES ('channel','','!room','hook'), ('empty','','!empty','hook'), ('unlinked','','','hook'), ('nonrelay','','!other','')`,
+		`INSERT INTO thread VALUES ('thread','channel'), ('outbound-only','channel')`,
+		`INSERT INTO message VALUES ('9','channel','','','human'), ('100','channel','','','human'), ('200','channel','','','hook'), ('50','channel','','thread','human'), ('300','channel','','thread','hook'), ('400','channel','','outbound-only','hook'), ('999','unlinked','','','human'), ('999','nonrelay','','','human')`,
+	} {
+		if _, err = raw.Exec(statement); err != nil {
+			t.Fatal(err)
+		}
+	}
+	anchors, err := readRelayBackfillSnapshot(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	channel := database.NewPortalKey("channel", "")
+	for key, expected := range map[relayBackfillKey]string{
+		{PortalKey: channel}:                            "100",
+		{PortalKey: channel, ThreadID: "thread"}:        "50",
+		{PortalKey: channel, ThreadID: "outbound-only"}: "0",
+		{PortalKey: database.NewPortalKey("empty", "")}: "0",
+	} {
+		if anchors[key] != expected {
+			t.Fatalf("cursor for %+v = %q, want %q", key, anchors[key], expected)
+		}
+	}
+	if len(anchors) != 4 {
+		t.Fatalf("unlinked or non-relay portal included: %+v", anchors)
+	}
+	// A live Discord event after READY must not erase the offline interval.
+	if _, err = raw.Exec(`INSERT INTO message VALUES ('500','channel','','','human')`); err != nil {
+		t.Fatal(err)
+	}
+	user := &User{relayBackfillAnchors: anchors}
+	if cursor, ok := user.takeRelayBackfillAnchor(channel, ""); !ok || cursor != "100" {
+		t.Fatalf("startup cursor changed after live traffic: %q, %v", cursor, ok)
+	}
+	if _, ok := user.takeRelayBackfillAnchor(channel, ""); ok {
+		t.Fatal("startup cursor reused for an ordinary guild update")
+	}
+	if cursor, ok := user.takeRelayBackfillAnchor(channel, "thread"); !ok || cursor != "50" {
+		t.Fatalf("root cursor affected thread cursor: %q, %v", cursor, ok)
+	}
+	if cursor, ok := user.takeRelayBackfillAnchor(channel, "outbound-only"); !ok || cursor != "0" {
+		t.Fatalf("empty incoming history lost its explicit zero cursor: %q, %v", cursor, ok)
+	}
+	fresh, err := readRelayBackfillSnapshot(db)
+	if err != nil || fresh[relayBackfillKey{PortalKey: channel}] != "500" {
+		t.Fatalf("next READY did not capture current incoming cursor: %+v, %v", fresh, err)
+	}
+}
