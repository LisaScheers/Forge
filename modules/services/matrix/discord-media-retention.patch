+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"net/url"
+	"path"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+	"maunium.net/go/mautrix/event"
+)
+
+const mediaRetentionKey = "dev.bylisa.sec_hive.media_retention"
+
+type mediaOmission struct {
+	Kind               string `json:"kind"`
+	AssetID            string `json:"asset_id"`
+	URLSHA256          string `json:"url_sha256"`
+	EffectiveTimestamp string `json:"effective_timestamp"`
+}
+
+type mediaRetentionReceipt struct {
+	Version   int             `json:"version"`
+	GuildID   string          `json:"guild_id"`
+	ChannelID string          `json:"channel_id"`
+	MessageID string          `json:"message_id"`
+	Cutoff    string          `json:"cutoff"`
+	Permalink string          `json:"permalink"`
+	Omissions []mediaOmission `json:"omissions"`
+}
+
+func snowflakeMediaTime(value string) (time.Time, bool) {
+	snowflake, err := strconv.ParseUint(value, 10, 64)
+	if err != nil || snowflake == 0 {
+		return time.Time{}, false
+	}
+	return time.UnixMilli(int64(snowflake>>22) + 1420070400000).UTC(), true
+}
+
+func latestMediaTime(current time.Time, candidate time.Time) time.Time {
+	if candidate.After(current) {
+		return candidate
+	}
+	return current
+}
+
+func messageMediaTime(msg *discordgo.Message) (time.Time, bool) {
+	if msg == nil {
+		return time.Time{}, false
+	}
+	timestamp, known := snowflakeMediaTime(msg.ID)
+	if !known {
+		return time.Time{}, false
+	}
+	timestamp = latestMediaTime(timestamp, msg.Timestamp)
+	if msg.EditedTimestamp != nil {
+		timestamp = latestMediaTime(timestamp, *msg.EditedTimestamp)
+	}
+	// A new forwarding message or a newer source edit protects reused old media.
+	for _, snapshot := range msg.MessageSnapshots {
+		if source := snapshot.Message; source != nil {
+			if sourceTime, ok := snowflakeMediaTime(source.ID); ok {
+				timestamp = latestMediaTime(timestamp, sourceTime)
+			}
+			timestamp = latestMediaTime(timestamp, source.Timestamp)
+			if source.EditedTimestamp != nil {
+				timestamp = latestMediaTime(timestamp, *source.EditedTimestamp)
+			}
+		}
+	}
+	if msg.MessageReference != nil && msg.MessageReference.Type == discordgo.MessageReferenceTypeForward {
+		if sourceTime, ok := snowflakeMediaTime(msg.MessageReference.MessageID); ok {
+			timestamp = latestMediaTime(timestamp, sourceTime)
+		}
+	}
+	return timestamp, true
+}
+
+func canonicalMediaURL(raw string) string {
+	parsed, err := url.Parse(raw)
+	if err != nil || (!strings.EqualFold(parsed.Scheme, "http") && !strings.EqualFold(parsed.Scheme, "https")) || parsed.Hostname() == "" {
+		return ""
+	}
+	parsed.RawQuery, parsed.Fragment, parsed.RawFragment, parsed.ForceQuery, parsed.User = "", "", "", false, nil
+	parsed.Scheme, parsed.Host = strings.ToLower(parsed.Scheme), strings.ToLower(parsed.Host)
+	return parsed.String()
+}
+
+func mediaURLAttachmentID(raw string) string {
+	parsed, err := url.Parse(raw)
+	if err != nil {
+		return ""
+	}
+	switch strings.ToLower(parsed.Hostname()) {
+	case "cdn.discordapp.com", "media.discordapp.net", "cdn.discordapp.net":
+	default:
+		return ""
+	}
+	segments := strings.Split(strings.Trim(parsed.Path, "/"), "/")
+	if len(segments) >= 4 && (segments[0] == "attachments" || segments[0] == "ephemeral-attachments") {
+		return segments[2]
+	}
+	return ""
+}
+
+func imageVideoAttachment(att *discordgo.MessageAttachment) bool {
+	mime := strings.ToLower(strings.TrimSpace(strings.SplitN(att.ContentType, ";", 2)[0]))
+	if strings.HasPrefix(mime, "image/") || strings.HasPrefix(mime, "video/") {
+		return true
+	}
+	if mime != "" && mime != "application/octet-stream" {
+		return false
+	}
+	if att.Width > 0 || att.Height > 0 {
+		return true
+	}
+	switch strings.ToLower(path.Ext(att.Filename)) {
+	case ".png", ".apng", ".jpg", ".jpeg", ".gif", ".webp", ".avif", ".bmp", ".ico", ".heic", ".heif", ".svg", ".tif", ".tiff", ".mp4", ".webm", ".mov", ".m4v", ".mkv", ".avi", ".mpeg", ".mpg", ".3gp":
+		return true
+	default:
+		return false
+	}
+}
+
+func (portal *Portal) mediaCutoff() (time.Time, bool) {
+	if portal.bridge == nil || portal.bridge.Config == nil || portal.GuildID == "" {
+		return time.Time{}, false
+	}
+	raw, configured := portal.bridge.Config.Bridge.MediaRetentionBefore[portal.GuildID]
+	if !configured {
+		return time.Time{}, false
+	}
+	cutoff, err := time.Parse(time.RFC3339, raw)
+	return cutoff.UTC(), err == nil && !cutoff.IsZero()
+}
+
+func (portal *Portal) mediaOmission(msg *discordgo.Message, kind, assetID, sourceURL string, otherURLs ...string) *mediaOmission {
+	cutoff, enabled := portal.mediaCutoff()
+	timestamp, known := messageMediaTime(msg)
+	if !enabled || !known {
+		return nil
+	}
+	if assetTime, ok := snowflakeMediaTime(assetID); ok {
+		timestamp = latestMediaTime(timestamp, assetTime)
+	}
+	for _, assetURL := range append([]string{sourceURL}, otherURLs...) {
+		if assetTime, ok := snowflakeMediaTime(mediaURLAttachmentID(assetURL)); ok {
+			timestamp = latestMediaTime(timestamp, assetTime)
+		}
+	}
+	if !timestamp.Before(cutoff) {
+		return nil
+	}
+	var assetURL string
+	for _, candidate := range append([]string{sourceURL}, otherURLs...) {
+		if assetURL = canonicalMediaURL(candidate); assetURL != "" {
+			break
+		}
+	}
+	digest := sha256.Sum256([]byte(assetURL))
+	return &mediaOmission{Kind: kind, AssetID: assetID, URLSHA256: hex.EncodeToString(digest[:]), EffectiveTimestamp: timestamp.UTC().Format(time.RFC3339Nano)}
+}
+
+func (portal *Portal) mediaReceipt(msg *discordgo.Message, omissions []mediaOmission) mediaRetentionReceipt {
+	cutoff, _ := portal.mediaCutoff()
+	channelID := msg.ChannelID
+	if channelID == "" {
+		channelID = portal.Key.ChannelID
+	}
+	return mediaRetentionReceipt{Version: 1, GuildID: portal.GuildID, ChannelID: channelID, MessageID: msg.ID, Cutoff: cutoff.Format(time.RFC3339), Permalink: fmt.Sprintf("https://discord.com/channels/%s/%s/%s", portal.GuildID, channelID, msg.ID), Omissions: omissions}
+}
+
+func (portal *Portal) mediaOmissionBody(msg *discordgo.Message) string {
+	receipt := portal.mediaReceipt(msg, nil)
+	return fmt.Sprintf("[SEC-Hive media cutoff %s] Image/video omitted. Original: %s", receipt.Cutoff, receipt.Permalink)
+}
+
+func (portal *Portal) omittedMediaPart(msg *discordgo.Message, nativeID string, omission mediaOmission) *ConvertedMessage {
+	return &ConvertedMessage{AttachmentID: nativeID, Type: event.EventMessage, Content: &event.MessageEventContent{MsgType: event.MsgNotice, Body: portal.mediaOmissionBody(msg)}, Extra: map[string]any{mediaRetentionKey: portal.mediaReceipt(msg, []mediaOmission{omission})}}
+}
+
+// Only images actually rendered by rich/link embeds are filtered. Author/footer
+// icons remain reusable identity assets and never inherit message retention.
+func (portal *Portal) retainedEmbed(msg *discordgo.Message, embed *discordgo.MessageEmbed, index int, embedType BridgeEmbedType) (*discordgo.MessageEmbed, []mediaOmission) {
+	filtered := *embed
+	var omissions []mediaOmission
+	if embedType != EmbedRich && embedType != EmbedLinkPreview {
+		return embed, nil
+	}
+	if embed.Image != nil {
+		if omission := portal.mediaOmission(msg, "embed_image", fmt.Sprintf("embed:%d:image", index), embed.Image.ProxyURL, embed.Image.URL, embed.URL); omission != nil {
+			filtered.Image = nil
+			omissions = append(omissions, *omission)
+		}
+	}
+	// An omitted image makes a thumbnail eligible for rendering. Apply the same
+	// cutoff to that fallback, while preserving a newer attachment thumbnail.
+	if embedType == EmbedLinkPreview && filtered.Image == nil && embed.Thumbnail != nil {
+		if omission := portal.mediaOmission(msg, "embed_thumbnail", fmt.Sprintf("embed:%d:thumbnail", index), embed.Thumbnail.ProxyURL, embed.Thumbnail.URL, embed.URL); omission != nil {
+			filtered.Thumbnail = nil
+			omissions = append(omissions, *omission)
+		}
+	}
+	return &filtered, omissions
+}
