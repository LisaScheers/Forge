+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/bwmarrin/discordgo"
+	"go.mau.fi/util/dbutil"
+	"maunium.net/go/maulogger/v2"
+	"maunium.net/go/mautrix/event"
+	"maunium.net/go/mautrix/id"
+
+	"go.mau.fi/mautrix-discord/config"
+	"go.mau.fi/mautrix-discord/database"
+)
+
+var retentionTestCutoff = time.Date(2025, 4, 26, 22, 0, 0, 0, time.UTC)
+
+func retentionTestID(timestamp time.Time) string {
+	return fmt.Sprint((uint64(timestamp.UnixMilli()-1420070400000) << 22) | 1)
+}
+
+func retentionTestPortal(t *testing.T, assetURL string) *Portal {
+	t.Helper()
+	raw, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = raw.Close() })
+	raw.SetMaxOpenConns(1)
+	base, err := dbutil.NewWithDB(raw, "sqlite3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = raw.Exec("CREATE TABLE discord_file (url TEXT, encrypted BOOLEAN, mxc TEXT, id TEXT, emoji_name TEXT, size BIGINT, width INTEGER, height INTEGER, mime_type TEXT, decryption_info TEXT, timestamp BIGINT)"); err != nil {
+		t.Fatal(err)
+	}
+	br := &DiscordBridge{Config: &config.Config{}, DB: database.New(base, maulogger.Create())}
+	br.Config.Bridge.MediaRetentionBefore = map[string]string{"1293572131086667827": retentionTestCutoff.Format(time.RFC3339)}
+	br.Config.Bridge.CacheMedia = "always"
+	file := br.DB.File.New()
+	file.URL, file.MXC, file.MimeType, file.Size = assetURL, id.ContentURI{Homeserver: "test", FileID: "reused-old-media"}, "image/png", 42
+	file.Insert(nil)
+	return &Portal{Portal: &database.Portal{Key: database.NewPortalKey("1293576317773676584", ""), GuildID: "1293572131086667827"}, bridge: br}
+}
+
+func TestMediaRetentionBoundaryAndConservativeAge(t *testing.T) {
+	assetURL := "https://cdn.discordapp.com/attachments/1293576317773676584/1000000000000000000/image.png?ex=signed&hm=must-not-leak"
+	oldID := retentionTestID(retentionTestCutoff.Add(-time.Hour))
+	newID := retentionTestID(retentionTestCutoff.Add(time.Millisecond))
+	for _, test := range []struct {
+		name                                     string
+		messageTime                              time.Time
+		edit                                     *time.Time
+		attachmentID, guild, messageID, assetURL string
+		omitted                                  bool
+	}{
+		{name: "one millisecond before", messageTime: retentionTestCutoff.Add(-time.Millisecond), omitted: true},
+		{name: "exact cutoff", messageTime: retentionTestCutoff},
+		{name: "one millisecond after", messageTime: retentionTestCutoff.Add(time.Millisecond)},
+		{name: "new message reuses old attachment", messageTime: retentionTestCutoff.Add(time.Hour), attachmentID: oldID},
+		{name: "new attachment on old message", messageTime: retentionTestCutoff.Add(-time.Hour), attachmentID: newID},
+		{name: "new edit on old message", messageTime: retentionTestCutoff.Add(-time.Hour), edit: &retentionTestCutoff},
+		{name: "CDN attachment ID protects newer asset", messageTime: retentionTestCutoff.Add(-time.Hour), assetURL: "https://cdn.discordapp.com/attachments/1293576317773676584/" + newID + "/image.png"},
+		{name: "unrelated guild", messageTime: retentionTestCutoff.Add(-time.Hour), guild: "999999999999999999"},
+		{name: "unknown message age", messageID: "unknown"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			sourceURL := assetURL
+			if test.assetURL != "" {
+				sourceURL = test.assetURL
+			}
+			portal := retentionTestPortal(t, sourceURL)
+			if test.guild != "" {
+				portal.GuildID = test.guild
+			}
+			messageID := test.messageID
+			if messageID == "" {
+				messageID = retentionTestID(test.messageTime)
+			}
+			attachmentID := test.attachmentID
+			if attachmentID == "" {
+				attachmentID = oldID
+			}
+			msg := &discordgo.Message{ID: messageID, EditedTimestamp: test.edit}
+			part := portal.convertDiscordAttachment(context.Background(), nil, msg, &discordgo.MessageAttachment{ID: attachmentID, URL: sourceURL, ContentType: "image/png", Filename: "image.png"})
+			if test.omitted {
+				if part.Content.MsgType != event.MsgNotice || part.Content.URL != "" || part.Content.File != nil || part.AttachmentID != attachmentID {
+					t.Fatal("old cached image was not replaced by its native notice")
+				}
+				receipt, ok := part.Extra[mediaRetentionKey].(mediaRetentionReceipt)
+				if !ok || receipt.MessageID != msg.ID || receipt.ChannelID != portal.Key.ChannelID || receipt.Cutoff != "2025-04-26T22:00:00Z" || len(receipt.Omissions) != 1 || receipt.Omissions[0].AssetID != attachmentID {
+					t.Fatal("missing exact omission receipt")
+				}
+				if !strings.Contains(part.Content.Body, "[SEC-Hive media cutoff 2025-04-26T22:00:00Z]") || !strings.Contains(part.Content.Body, receipt.Permalink) {
+					t.Fatal("omission notice lacks cutoff or durable source permalink")
+				}
+				encoded, err := json.Marshal(receipt)
+				if err != nil || strings.Contains(string(encoded), "must-not-leak") || strings.Contains(string(encoded), "signed") {
+					t.Fatal("receipt leaked signed asset URL")
+				}
+			} else if part.Content.MsgType != event.MsgImage || part.Content.URL != "mxc://test/reused-old-media" || part.Extra[mediaRetentionKey] != nil {
+				t.Fatal("retained asset lost its ordinary cached conversion")
+			}
+		})
+	}
+}
+
+func TestMediaRetentionRealMessageMediaPaths(t *testing.T) {
+	assetURL := "https://media.example.test/cached.gif?signature=not-a-credential"
+	portal := retentionTestPortal(t, assetURL)
+	oldID := retentionTestID(retentionTestCutoff.Add(-time.Hour))
+	image := &discordgo.MessageEmbedImage{URL: assetURL, ProxyURL: assetURL}
+	thumbnail := &discordgo.MessageEmbedThumbnail{URL: assetURL, ProxyURL: assetURL}
+	msg := &discordgo.Message{ID: oldID, Content: "Preserved text", Attachments: []*discordgo.MessageAttachment{{ID: oldID, URL: assetURL, Filename: "clip.webm", ContentType: "video/webm"}}, StickerItems: []*discordgo.StickerItem{{ID: retentionTestID(retentionTestCutoff.Add(-2 * time.Hour)), Name: "Sticker", FormatType: discordgo.StickerFormatTypeGIF}}, Embeds: []*discordgo.MessageEmbed{
+		{Type: discordgo.EmbedTypeRich, Title: "Preserved embed title", Description: "Preserved description", Image: image, Author: &discordgo.MessageEmbedAuthor{Name: "Preserved author", ProxyIconURL: assetURL}, Footer: &discordgo.MessageEmbedFooter{Text: "Preserved footer", ProxyIconURL: assetURL}},
+		{Type: discordgo.EmbedTypeLink, URL: "https://example.test/article", Title: "Preserved link title", Image: image, Thumbnail: thumbnail},
+		{Type: discordgo.EmbedTypeGifv, URL: "https://example.test/gif", Video: &discordgo.MessageEmbedVideo{ProxyURL: assetURL}},
+	}}
+	parts := portal.convertDiscordMessage(context.Background(), nil, nil, msg)
+	if len(parts) != 4 {
+		t.Fatalf("expected text plus attachment, sticker and GIF notices, got %d", len(parts))
+	}
+	text := parts[0]
+	if !strings.Contains(text.Content.Body, "Preserved text") || !strings.Contains(text.Content.Body, "Preserved embed title") || !strings.Contains(text.Content.Body, "Preserved description") || !strings.Contains(text.Content.Body, "Preserved footer") {
+		t.Fatal("text or embed metadata was lost")
+	}
+	if !strings.Contains(text.Content.FormattedBody, "mxc://test/reused-old-media") {
+		t.Fatal("identity icons should remain available")
+	}
+	receipt := text.Extra[mediaRetentionKey].(mediaRetentionReceipt)
+	if len(receipt.Omissions) != 3 || receipt.Omissions[0].Kind != "embed_image" || receipt.Omissions[1].AssetID != "embed:1:image" {
+		t.Fatal("rich/link media omission receipts are incomplete")
+	}
+	previews := text.Extra["com.beeper.linkpreviews"].([]*BeeperLinkPreview)
+	if len(previews) != 1 || previews[0].Title != "Preserved link title" || previews[0].ImageURL != "" {
+		t.Fatal("preview text or omitted image is wrong")
+	}
+	for _, part := range parts[1:] {
+		if part.Content.MsgType != event.MsgNotice || part.Content.URL != "" || part.Extra[mediaRetentionKey] == nil {
+			t.Fatal("message media bypassed the cutoff")
+		}
+	}
+	if msg.Embeds[0].Image != image || msg.Embeds[1].Thumbnail != thumbnail {
+		t.Fatal("retention mutated the cached source message")
+	}
+	// A new forward must preserve the original old media even though its asset ID is old.
+	forward := &discordgo.Message{ID: retentionTestID(retentionTestCutoff.Add(time.Hour)), Content: "Forwarded text", MessageReference: &discordgo.MessageReference{Type: discordgo.MessageReferenceTypeForward, MessageID: oldID}, MessageSnapshots: []discordgo.MessageSnapshot{{Message: &discordgo.Message{ID: oldID, Attachments: []*discordgo.MessageAttachment{{ID: oldID, URL: assetURL, ContentType: "image/gif", Filename: "old.gif"}}}}}}
+	forwarded := portal.convertDiscordMessage(context.Background(), nil, nil, forward)
+	if len(forwarded) != 2 || forwarded[1].Content.URL != "mxc://test/reused-old-media" {
+		t.Fatal("new forward lost reusable old media")
+	}
+	forward.ID = retentionTestID(retentionTestCutoff.Add(-time.Minute))
+	forwarded = portal.convertDiscordMessage(context.Background(), nil, nil, forward)
+	if len(forwarded) != 2 || forwarded[1].Content.MsgType != event.MsgNotice || forwarded[1].AttachmentID != oldID {
+		t.Fatal("old forwarded media bypassed the cutoff or lost its native mapping")
+	}
+	audio := portal.convertDiscordAttachment(context.Background(), nil, msg, &discordgo.MessageAttachment{ID: oldID, URL: assetURL, ContentType: "audio/ogg", Filename: "voice.ogg"})
+	if audio.Content.MsgType != event.MsgAudio || audio.Content.URL != "mxc://test/reused-old-media" {
+		t.Fatal("retention changed non-image/video attachment conversion")
+	}
+}
