+func TestMediaRetentionPreservesNewerThumbnailFallback(t *testing.T) {
+	oldURL := "https://cdn.discordapp.com/attachments/1293576317773676584/1000000000000000000/old.png"
+	newURL := "https://cdn.discordapp.com/attachments/1293576317773676584/" + retentionTestID(retentionTestCutoff) + "/new.png"
+	portal := retentionTestPortal(t, newURL)
+	msg := &discordgo.Message{ID: retentionTestID(retentionTestCutoff.Add(-time.Hour)), Content: "Preserved link", Embeds: []*discordgo.MessageEmbed{{Type: discordgo.EmbedTypeLink, URL: "https://example.test/article", Image: &discordgo.MessageEmbedImage{URL: oldURL, ProxyURL: oldURL}, Thumbnail: &discordgo.MessageEmbedThumbnail{URL: newURL, ProxyURL: newURL}}}}
+	part := portal.convertDiscordTextMessage(context.Background(), nil, msg)
+	receipt := part.Extra[mediaRetentionKey].(mediaRetentionReceipt)
+	previews := part.Extra["com.beeper.linkpreviews"].([]*BeeperLinkPreview)
+	if len(receipt.Omissions) != 1 || receipt.Omissions[0].Kind != "embed_image" || len(previews) != 1 || previews[0].ImageURL != "mxc://test/reused-old-media" {
+		t.Fatal("new thumbnail fallback was omitted with its older embed image")
+	}
+}
