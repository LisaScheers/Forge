+func TestMediaRetentionURLIdentityAndNonMedia(t *testing.T) {
+	first := "HTTPS://CDN.DISCORDAPP.COM/attachments/1/2/a.png?ex=one&hm=first#fragment"
+	second := "https://cdn.discordapp.com/attachments/1/2/a.png?ex=two&hm=second"
+	if canonicalMediaURL(first) != canonicalMediaURL(second) || strings.Contains(canonicalMediaURL(first), "?") {
+		t.Fatal("signed URL changes altered asset identity")
+	}
+	for _, att := range []*discordgo.MessageAttachment{{ContentType: "audio/ogg", Filename: "voice.ogg"}, {ContentType: "text/plain", Filename: "notes.txt"}, {ContentType: "application/pdf", Filename: "guide.pdf"}} {
+		if imageVideoAttachment(att) {
+			t.Fatal("non-image/video attachment selected")
+		}
+	}
+	if !imageVideoAttachment(&discordgo.MessageAttachment{Filename: "animation.GIF"}) || !imageVideoAttachment(&discordgo.MessageAttachment{ContentType: "application/octet-stream", Filename: "video.MP4"}) {
+		t.Fatal("missing MIME fallback missed media")
+	}
+}
