+func TestMediaRetentionPreservesCachedLottieJSONConversion(t *testing.T) {
+	sticker := &discordgo.StickerItem{ID: retentionTestID(retentionTestCutoff.Add(-time.Hour)), Name: "Preserved Lottie", FormatType: discordgo.StickerFormatTypeLottie}
+	portal := retentionTestPortal(t, sticker.URL())
+	if _, err := portal.bridge.DB.Exec("UPDATE discord_file SET mime_type='image/webp' WHERE url=$1", sticker.URL()); err != nil {
+		t.Fatal(err)
+	}
+	msg := &discordgo.Message{ID: retentionTestID(retentionTestCutoff.Add(-time.Hour))}
+	// No downloader/conversion runtime is configured: a miss would fail the test.
+	part := portal.convertDiscordSticker(context.Background(), nil, msg, sticker)
+	if part.Type != event.EventSticker || part.Content.URL != "mxc://test/reused-old-media" || part.Content.Info.MimeType != "image/webp" || part.Extra[mediaRetentionKey] != nil {
+		t.Fatal("JSON source cutoff exemption did not preserve its cached converted sticker")
+	}
