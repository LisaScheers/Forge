+// Unmapping must happen while the old bridge process is drained: already queued
+// messages do not recheck guild mode. A cold process with an empty binding does.
+func TestUnboundIfPortalExistsDoesNotRecreateRoom(t *testing.T) {
+	portal := retentionTestPortal(t, "https://example.test/unused")
+	portal.Key = database.NewPortalKey("1304855606342979675", "")
+	portal.discordMessages = make(chan portalDiscordMessage, 8)
+	br := portal.bridge
+	br.Config.Bridge.Backfill.Limits.Missed.Channel = -1
+	br.Config.Bridge.Backfill.Limits.Missed.Thread = -1
+	br.portalsByID = map[database.PortalKey]*Portal{portal.Key: portal}
+	br.guildsByID = map[string]*Guild{portal.GuildID: {Guild: &database.Guild{ID: portal.GuildID, BridgingMode: database.GuildBridgeIfPortalExists}}}
+	thread := &Thread{Thread: &database.Thread{ID: "1304855606342979676", ParentID: portal.Key.ChannelID}, Parent: portal}
+	br.threadsByID = map[string]*Thread{thread.ID: thread}
+	// An absent channel lookup must really fall through to the known thread.
+	if _, err := br.DB.Exec("CREATE TABLE portal (dcid TEXT, receiver TEXT, type TEXT, other_user_id TEXT, dc_guild_id TEXT, dc_parent_id TEXT, mxid TEXT, plain_name TEXT, name TEXT, name_set TEXT, friend_nick TEXT, topic TEXT, topic_set TEXT, avatar TEXT, avatar_url TEXT, avatar_set TEXT, encrypted TEXT, in_space TEXT, first_event_id TEXT, relay_webhook_id TEXT, relay_webhook_secret TEXT)"); err != nil {
+		t.Fatal(err)
+	}
+	user := &User{User: &database.User{DiscordID: "123456789012345678"}, bridge: br, log: zerolog.Nop()}
+	for _, channelID := range []string{portal.Key.ChannelID, thread.ID} {
+		for _, kind := range []string{"message create", "message update", "reaction add"} {
+			user.pushPortalMessage(&discordgo.MessageCreate{Message: &discordgo.Message{ChannelID: channelID}}, kind, channelID, portal.GuildID)
+		}
+	}
+	user.channelCreateHandler(&discordgo.ChannelCreate{Channel: &discordgo.Channel{ID: portal.Key.ChannelID, GuildID: portal.GuildID, Type: discordgo.ChannelTypeGuildText}})
+	user.threadListSyncHandler(&discordgo.ThreadListSync{GuildID: portal.GuildID, Threads: []*discordgo.Channel{{ID: thread.ID, ParentID: portal.Key.ChannelID}}})
+	portal.ForwardBackfillMissed(user, "1304855606342979677", nil)
+	portal.ForwardBackfillMissed(user, "1304855606342979677", thread)
+	if portal.MXID != "" || len(portal.discordMessages) != 0 {
+		t.Fatal("unbound portal received work capable of recreating its room")
+	}
+	// The same guild mode still relays other rooms whose binding remains active.
+	portal.MXID = id.RoomID("!existing:test")
+	user.pushPortalMessage(&discordgo.MessageCreate{Message: &discordgo.Message{ChannelID: portal.Key.ChannelID}}, "message create", portal.Key.ChannelID, portal.GuildID)
+	if len(portal.discordMessages) != 1 {
+		t.Fatal("if-portal-exists stopped relaying an existing room")
+	}
+}
