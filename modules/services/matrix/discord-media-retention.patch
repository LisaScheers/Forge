+func TestMediaRetentionThreadReceiptAndMissingProxyURL(t *testing.T) {
+	assetURL := "https://cdn.discordapp.com/attachments/1293576317773676584/1000000000000000000/image.png?ex=signed&hm=not-a-credential"
+	portal := retentionTestPortal(t, assetURL)
+	msg := &discordgo.Message{ID: retentionTestID(retentionTestCutoff.Add(-time.Hour)), ChannelID: "1293576317773676585", Content: "Preserved thread text", Embeds: []*discordgo.MessageEmbed{{Type: discordgo.EmbedTypeRich, Image: &discordgo.MessageEmbedImage{URL: assetURL}}}}
+	part := portal.convertDiscordTextMessage(context.Background(), nil, msg)
+	receipt := part.Extra[mediaRetentionKey].(mediaRetentionReceipt)
+	expectedLink := fmt.Sprintf("https://discord.com/channels/%s/%s/%s", portal.GuildID, msg.ChannelID, msg.ID)
+	if receipt.ChannelID != msg.ChannelID || receipt.Permalink != expectedLink || !strings.Contains(part.Content.Body, expectedLink) {
+		t.Fatal("thread omission lost its actual Discord channel permalink")
+	}
+	expectedHash := sha256.Sum256([]byte(canonicalMediaURL(assetURL)))
+	if len(receipt.Omissions) != 1 || receipt.Omissions[0].URLSHA256 != hex.EncodeToString(expectedHash[:]) {
+		t.Fatal("missing proxy URL did not fall back to actual media URL identity")
+	}
+}
