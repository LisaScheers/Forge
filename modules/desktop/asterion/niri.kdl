input {
    keyboard {
        xkb { layout "us"; }
        repeat-delay 300
        repeat-rate 40
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
}

// Do not force a display mode while Asahi's M3 display support is evolving.
output "eDP-1" { scale 2; }

layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.33333; }
    focus-ring {
        width 1
        active-color "#ffffff"
        inactive-color "#444444"
    }
    border { off; }
}

workspace "code"
workspace "web"
workspace "chat"
prefer-no-csd
animations { off; }
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d-%H-%M-%S.png"

xwayland-satellite { path "@xwayland-satellite@"; }

binds {
    Mod+Return { spawn "@foot@"; }
    Mod+D { spawn "@fuzzel@"; }
    Mod+Escape { spawn "@swaylock@" "--daemonize"; }
    Mod+Shift+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+O { toggle-overview; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+V { toggle-window-floating; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+1 { focus-workspace "code"; }
    Mod+2 { focus-workspace "web"; }
    Mod+3 { focus-workspace "chat"; }
    Mod+Shift+1 { move-column-to-workspace "code"; }
    Mod+Shift+2 { move-column-to-workspace "web"; }
    Mod+Shift+3 { move-column-to-workspace "chat"; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }

    Print { screenshot; }
    Mod+Shift+S { screenshot; }
    Mod+Print { screenshot-window; }
    Mod+Shift+Print { screenshot-screen; }
    Mod+N { spawn "@makoctl@" "dismiss"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "@wpctl@" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "@wpctl@" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
}
