{
  buffer_font_family = "ComicCodeLigatures Nerd Font";
  project_panel = {
    dock = "left";
  };
  agent = {
    sidebar_side = "right";
    default_model = {
      provider = "codex";
      model = "gpt-5.6-sol";
    };
  };
  vim_mode = false;
  load_direnv = "shell_hook";
  base_keymap = "VSCode";
  autosave = "on_focus_change";
  format_on_save = "on";
  show_whitespaces = "trailing";
  ui_font_size = 14;
  buffer_font_size = 12;
}
