+//! The script editors as the control bridge sees them (forge patch): their
+//! state for `viewer_script`, and edits and saves that go through the same
+//! checks as the editor's own buttons.
+
+use super::*;
+use serde_json::{Value, json};
+
+impl Editors {
+    pub fn control_documents(&self) -> Vec<Value> {
+        self.documents
+            .iter()
+            .filter(|e| !e.closed)
+            .map(|e| {
+                json!({
+                    "item": e.target.item,
+                    "object": e.target.object,
+                    "name": e.name,
+                    "loaded": e.loaded,
+                    "loading": e.loading.is_some(),
+                    "can_read": e.can_read,
+                    "can_edit": e.can_edit,
+                    "dirty": e.dirty(),
+                    "saving": e.saving.is_some() || e.processing.is_some(),
+                    "compile_failed": e.compile_failed,
+                    "errors": e.errors,
+                    "status": e.status,
+                    "running": e.running,
+                    "source": (e.loaded && e.can_read).then_some(&e.source),
+                })
+            })
+            .collect()
+    }
+
+    fn control_editor(&mut self, target: ScriptTarget) -> Result<&mut Editor, String> {
+        self.documents
+            .iter_mut()
+            .find(|e| e.target == target && !e.closed)
+            .ok_or_else(|| "no open editor for that script; open it first".to_owned())
+    }
+
+    /// Replaces the draft; nothing is uploaded until `control_save`.
+    pub fn control_edit(&mut self, target: ScriptTarget, source: &str) -> Result<(), String> {
+        let e = self.control_editor(target)?;
+        if !e.loaded || e.loading.is_some() {
+            return Err("the script has not loaded yet".into());
+        }
+        if !e.can_edit {
+            return Err("you may not edit this script".into());
+        }
+        if e.saving.is_some() || e.processing.is_some() {
+            return Err("a save is in progress".into());
+        }
+        if source.len() > MAX_SOURCE {
+            return Err("the source is too long".into());
+        }
+        e.source = source.to_owned();
+        Ok(())
+    }
+
+    /// The editor's own Save: the preprocessor, then upload and compile.
+    pub fn control_save(&mut self, target: ScriptTarget) -> Result<Option<Action>, String> {
+        let e = self.control_editor(target)?;
+        if !e.can_save() {
+            return Err("the editor cannot save now (not loaded, not editable, unchanged, or busy)".into());
+        }
+        Ok(e.save())
+    }
+}
