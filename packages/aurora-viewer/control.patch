+    pub(super) fn control_notifications(&mut self, args: &Map<String, Value>) -> Outcome {
+        use crate::world::notifications::{Data, Response};
+        let operation = op(args)?;
+        if operation == "list" {
+            let rows = self.world.notifications.list.iter().map(query::notification).collect::<Vec<_>>();
+            return Ok(json!({"rows": rows}));
+        }
+        let id = opt_u64(args, "id")?.ok_or_else(|| ControlError::invalid("id is required"))?;
+        let n = self
+            .world
+            .notifications
+            .list
+            .iter_mut()
+            .find(|n| n.id == id)
+            .ok_or_else(|| ControlError::not_found("no such notification (answered or gone)"))?;
+        let response = match operation {
+            "button" => {
+                let index = opt_u64(args, "index")?.ok_or_else(|| ControlError::invalid("index is required"))? as usize;
+                match &n.data {
+                    Data::Dialog { buttons, .. } if index < buttons.len() => Response::Button(index),
+                    Data::Dialog { .. } => return Err(ControlError::invalid("index is out of range")),
+                    _ => return Err(ControlError::invalid("not a script dialog")),
+                }
+            }
+            "text" => {
+                if !matches!(n.data, Data::TextBox { .. }) {
+                    return Err(ControlError::invalid("not a text box"));
+                }
+                let mut text = str_arg(args, "text")?.to_owned();
+                crate::world::notifications::clamp_text_box_reply(&mut text);
+                n.text = text;
+                Response::SendText
+            }
+            "accept" => Response::Accept,
+            "decline" => Response::Decline,
+            "dismiss" => Response::Dismiss,
+            other => return Err(unknown(other, "list, button, text, accept, decline, dismiss")),
+        };
+        self.control.answers.push((id, response));
+        Ok(json!({"status": "queued"}))
+    }
+
+    pub(super) fn control_chat(&mut self, args: &Map<String, Value>, actions: &mut UiActions) -> Outcome {
+        self.require_world()?;
+        let operation = op(args)?;
+        let text = str_arg(args, "text")?;
+        if text.trim().is_empty() {
+            return Err(ControlError::invalid("text is empty"));
+        }
+        match operation {
+            "say" => {
+                if actions.chat.is_some() {
+                    return Err(ControlError::unavailable("a line is already being sent this frame; retry"));
+                }
+                let chat_type = match opt_str(args, "volume")?.unwrap_or("normal") {
+                    "normal" => aurora_net::ChatType::Normal,
+                    "whisper" => aurora_net::ChatType::Whisper,
+                    "shout" => aurora_net::ChatType::Shout,
+                    _ => return Err(ControlError::invalid("volume must be normal, whisper or shout")),
+                };
+                let channel = opt_i64(args, "channel")?.unwrap_or(0);
+                let channel = i32::try_from(channel).map_err(|_| ControlError::invalid("channel out of range"))?;
+                actions.chat = Some(ui::chat::OutgoingChat {
+                    message: text.to_owned(),
+                    channel,
+                    chat_type,
+                });
+                Ok(json!({"status": "dispatched"}))
+            }
+            "im" => {
+                let to = uuid_arg(args, "to")?;
+                if to == self.world.agent_id {
+                    return Err(ControlError::invalid("cannot message yourself"));
+                }
+                // the conversation field would unblock them (handle_actions):
+                // that is the person's choice, not the bridge's
+                if !self.world.is_group_session(&to) && self.world.mutes.is_muted_id(&to) {
+                    return Err(ControlError::refused("this resident is blocked; unblock them in the viewer first"));
+                }
+                actions.ims.push((to, text.to_owned()));
+                Ok(json!({"status": "dispatched", "group": self.world.is_group_session(&to)}))
+            }
+            other => Err(unknown(other, "say, im")),
+        }
+    }
+}
