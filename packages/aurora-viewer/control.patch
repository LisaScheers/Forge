+    pub(super) fn control_object(&mut self, args: &Map<String, Value>) -> Outcome {
+        self.require_world()?;
+        let operation = op(args)?;
+        let id = uuid_arg(args, "id")?;
+        let idx = self
+            .world
+            .objects
+            .index_of_uuid(&id)
+            .ok_or_else(|| ControlError::not_found("object not in view"))?;
+        let key = self.world.objects.get(idx).map(|o| o.key).ok_or_else(|| ControlError::not_found("object gone"))?;
+        match operation {
+            "inspect" => {
+                self.on_ctx_action(ui::context::CtxAction::Inspect(id));
+                Ok(json!({"status": "dispatched", "object": self.control_object_detail(idx)}))
+            }
+            "touch" => {
+                if !self.world.rlva_can_touch(key.region, key.local_id) {
+                    return Err(ControlError::refused("RLVa forbids touching this object"));
+                }
+                match opt_i64(args, "face")? {
+                    None => self.send(NetCommand::Touch { local_id: key.local_id }),
+                    Some(face) => {
+                        let faces = self.world.objects.get(idx).and_then(|o| o.te.as_ref().map(|te| te.faces.len()));
+                        let face = i32::try_from(face)
+                            .ok()
+                            .filter(|f| *f >= 0 && faces.is_none_or(|n| (*f as usize) < n))
+                            .ok_or_else(|| ControlError::invalid("face is not one of the object's faces"))?;
+                        let flat = |v: Option<Vec3>| v.map(|v| Vec3::new(v.x, v.y, 0.0)).unwrap_or(Vec3::splat(0.5).with_z(0.0));
+                        let surface = aurora_net::TouchSurface {
+                            uv: flat(opt_vec3(args, "uv")?),
+                            st: flat(opt_vec3(args, "st")?),
+                            face,
+                            position: opt_vec3(args, "position")?.unwrap_or_else(|| self.control_position(idx).unwrap_or_default()),
+                            ..Default::default()
+                        };
+                        self.send(NetCommand::ObjectGrab {
+                            handle: key.region,
+                            local_id: key.local_id,
+                            offset: Vec3::ZERO,
+                            surface,
+                        });
+                        self.send(NetCommand::ObjectRelease {
+                            handle: key.region,
+                            local_id: key.local_id,
+                            surface,
+                        });
+                    }
+                }
+                Ok(json!({"status": "dispatched"}))
+            }
+            "sit" => {
+                let offset = opt_vec3(args, "offset")?.unwrap_or(Vec3::ZERO);
+                self.on_ctx_action(ui::context::CtxAction::Sit { target: id, offset });
+                Ok(json!({"status": "dispatched"}))
+            }
+            other => Err(unknown(other, "inspect, touch, sit")),
+        }
+    }
