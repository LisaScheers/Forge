+    pub(super) fn control_inventory(&mut self, args: &Map<String, Value>) -> Outcome {
+        self.require_world()?;
+        if self.world.rlva.has("showinv") {
+            return Err(ControlError::refused("RLVa closes the inventory (@showinv)"));
+        }
+        let operation = op(args)?;
+        let protected = self.settings.inventory.protected.clone();
+        let worn = crate::ui::appearance::items::worn_items(&self.world);
+        let inv = &self.world.inventory;
+        match operation {
+            "fetch" => {
+                let id = opt_uuid(args, "id")?.unwrap_or(inv.root);
+                if !inv.folders.contains_key(&id) {
+                    return Err(ControlError::not_found("folder not known; fetch its parent first"));
+                }
+                self.world.inventory.request(id);
+                let state = self.world.inventory.folders.get(&id).map(|f| format!("{:?}", f.state).to_ascii_lowercase());
+                Ok(json!({"status": "dispatched", "state": state}))
+            }
+            "create_folder" => {
+                let parent = opt_uuid(args, "parent")?.unwrap_or(inv.root);
+                if !rules::destination(inv, parent) {
+                    return Err(ControlError::refused("folders cannot be created there"));
+                }
+                let change = rules::create_folder(parent, str_arg(args, "name")?);
+                self.control_inventory_edit(change)
+            }
+            "rename" => {
+                let id = uuid_arg(args, "id")?;
+                if !rules::renameable(inv, id) || protected.contains(&id) {
+                    return Err(ControlError::refused("this entry cannot be renamed"));
+                }
+                let name = rules::clean_name(str_arg(args, "name")?).map_err(ControlError::invalid)?;
+                let change = rules::patch(inv, id, aurora_llsd::llsd_map! { "name" => name });
+                self.control_inventory_edit(change)
+            }
+            "move" => {
+                let ids = uuids(args, "ids")?;
+                let to = uuid_arg(args, "to")?;
+                let change = rules::move_selection(inv, &ids, to, &protected, &worn);
+                self.control_inventory_edit(change)
+            }
+            "copy" => {
+                let id = uuid_arg(args, "id")?;
+                let to = uuid_arg(args, "to")?;
+                let change = rules::copy_tree(inv, id, to);
+                self.control_inventory_edit(change)
+            }
+            "trash" => {
+                let ids = uuids(args, "ids")?;
+                let holds_worn = rules::worn_ancestors(inv, &worn);
+                if ids.iter().any(|id| !rules::removable(inv, *id, &protected) || holds_worn.contains(id) || worn.contains(id)) {
+                    return Err(ControlError::refused("the selection holds a protected, system or worn entry"));
+                }
+                let trash = rules::system(inv, 14).ok_or_else(|| ControlError::unavailable("Trash folder not found"))?;
+                let change = rules::move_selection(inv, &ids, trash, &protected, &worn);
+                self.control_inventory_edit(change)
+            }
+            "purge" => {
+                // permanent: only entries already in Trash (ui/inventory/delete.rs::plan)
+                let ids = rules::roots(inv, &uuids(args, "ids")?);
+                let holds_worn = rules::worn_ancestors(inv, &worn);
+                let eligible = |id: &Uuid| {
+                    rules::removable(inv, *id, &protected) && rules::in_type(inv, *id, 14) && !holds_worn.contains(id) && !worn.contains(id)
+                };
+                if !ids.iter().all(eligible) || ids.iter().any(|id| Some(*id) == rules::system(inv, 14)) {
+                    return Err(ControlError::refused("purge only accepts removable entries already in Trash"));
+                }
+                let change = Mutation {
+                    operations: ids
+                        .iter()
+                        .map(|id| Operation::Delete {
+                            id: *id,
+                            folder: inv.folders.contains_key(id),
+                        })
+                        .collect(),
+                    refresh: ids.iter().filter_map(|id| rules::parent(inv, *id)).collect(),
+                    removed: ids,
+                    ..Default::default()
+                };
+                self.control_inventory_edit(Ok(change))
+            }
+            "wear" | "add" | "take_off" => {
+                let id = uuid_arg(args, "id")?;
+                if !inv.items.contains_key(&id) && !inv.folders.contains_key(&id) {
+                    return Err(ControlError::not_found("not in the cached inventory"));
+                }
+                use crate::world::appearance::Action as Look;
+                let action = match operation {
+                    "wear" => Look::WearItem {
+                        item: id,
+                        replace: true,
+                        point: opt_u64(args, "point")?.unwrap_or(0).min(255) as u8,
+                    },
+                    "add" => Look::Add(id),
+                    _ => Look::Remove(id),
+                };
+                self.apply_inventory_action(ui::inventory::InvAction::Appearance(action));
+                Ok(json!({"status": "dispatched"}))
+            }
+            other => Err(unknown(other, "fetch, create_folder, rename, move, copy, trash, purge, wear, add, take_off")),
+        }
+    }
+
+    pub(super) fn control_contents(&mut self, args: &Map<String, Value>) -> Outcome {
+        self.require_world()?;
+        let operation = op(args)?;
+        let id = uuid_arg(args, "id")?;
+        let idx = self
+            .world
+            .objects
+            .index_of_uuid(&id)
+            .ok_or_else(|| ControlError::not_found("object not in view"))?;
+        match operation {
+            "fetch" => {
+                self.build.request_contents(&self.world, idx, true);
+                self.flush_build();
+                Ok(json!({"status": "dispatched"}))
+            }
+            "copy_to_inventory" => {
+                let listing = self
+                    .build
+                    .contents
+                    .objects
+                    .get(&id)
+                    .filter(|c| !c.loading)
+                    .ok_or_else(|| ControlError::unavailable("contents not loaded; fetch and wait for loading=false"))?;
+                let wanted = match crate::control::arg(args, "items") {
+                    None => None,
+                    Some(_) => Some(uuids(args, "items")?),
+                };
+                let items: Vec<_> = listing
+                    .items
+                    .iter()
+                    .filter(|i| wanted.as_ref().is_none_or(|w| w.contains(&i.item_id)))
+                    .cloned()
+                    .collect();
+                if items.is_empty() {
+                    return Err(ControlError::not_found("no matching contents"));
+                }
+                self.build.copy_contents_to_inventory(&self.world, idx, &items);
+                Ok(json!({"status": "dispatched", "items": items.len()}))
+            }
+            other => Err(unknown(other, "fetch, copy_to_inventory")),
+        }
+    }
