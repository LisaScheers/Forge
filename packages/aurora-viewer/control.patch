+use super::journal::{EVENTS, LEASE, RECEIPTS, Receipt};
+use super::*;
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::fs::PermissionsExt;
+use std::time::{Duration, Instant, SystemTime};
+
+/// A short private parent for test endpoints (socket paths are short).
+fn scratch() -> PathBuf {
+    let base = PathBuf::from("/tmp").join(format!("acb-{}-{}", std::process::id(), uuid::Uuid::new_v4().simple()));
+    let base = PathBuf::from(&base.to_string_lossy()[..30]);
+    std::fs::create_dir(&base).unwrap();
+    base
+}
+
+#[test]
+fn a_request_line_gives_its_id_tool_and_arguments() {
+    let (id, tool, args) = parse_request(r#"{"request_id":"r1","tool":"viewer_query","arguments":{"topic":"chat"}}"#).unwrap();
+    assert_eq!((id.as_str(), tool.as_str()), ("r1", "viewer_query"));
+    assert_eq!(args["topic"], "chat");
+    let (id, _, args) = parse_request(r#"{"tool":"viewer_state"}"#).unwrap();
+    assert_eq!(id.len(), 36, "an id is assigned when absent");
+    assert!(args.is_empty());
+}
+
+#[test]
+fn malformed_requests_are_refused_with_an_id() {
+    for line in ["not json", "[1]", r#"{"request_id":"r2"}"#, r#"{"tool":"x","arguments":[]}"#, r#"{"request_id":5,"tool":"x"}"#] {
+        let (id, error) = parse_request(line).unwrap_err();
+        assert!(!id.is_empty());
+        assert_eq!(error.code, "invalid_argument", "{line}");
+    }
+    let (id, _) = parse_request(r#"{"request_id":"r2"}"#).unwrap_err();
+    assert_eq!(id, "r2", "a known id is kept for the error reply");
+}
+
+#[test]
+fn replies_carry_result_or_error_and_the_request_id() {
+    let ok = envelope("a", &Ok(json!({"x": 1})));
+    assert_eq!(ok, json!({"request_id": "a", "result": {"x": 1}}));
+    let err = envelope("b", &Err(ControlError::refused("no")));
+    assert_eq!(err, json!({"request_id": "b", "error": {"code": "refused", "message": "no"}}));
+}
+
+#[test]
+fn receipts_keep_the_last_128_commands() {
+    let mut journal = Journal::default();
+    for i in 0..RECEIPTS + 10 {
+        journal.record(Receipt {
+            request_id: format!("r{i}"),
+            tool: "viewer_chat".into(),
+            op: Some("say".into()),
+            time: SystemTime::now(),
+            outcome: json!({"status": "dispatched"}),
+            ok: true,
+        });
+    }
+    assert_eq!(journal.receipt_count(), 128);
+    assert!(journal.receipt("r9").is_none(), "the oldest receipts are gone");
+    assert_eq!(journal.receipt("r10").unwrap().op.as_deref(), Some("say"));
+    assert!(journal.receipt(&format!("r{}", RECEIPTS + 9)).is_some());
+}
+
+#[test]
+fn events_keep_512_and_report_a_gap() {
+    let mut journal = Journal::default();
+    assert_eq!(journal.cursor(), 0);
+    for i in 0..EVENTS + 88 {
+        journal.push("chat", (i % 2 == 0).then_some("even"), json!({"i": i}));
+    }
+    assert_eq!(journal.cursor(), 600);
+    assert_eq!(journal.oldest(), 89);
+    let page = journal.after(0, 10, None);
+    assert_eq!(page["gap"], true, "events after the cursor were dropped");
+    assert_eq!(page["events"][0]["seq"], 89);
+    assert_eq!(page["next"], 98);
+    assert_eq!(page["more"], true);
+    let page = journal.after(590, 100, None);
+    assert_eq!(page["gap"], false);
+    assert_eq!(page["events"].as_array().unwrap().len(), 10);
+    assert_eq!(page["next"], 600);
+    assert_eq!(page["more"], false);
+    let page = journal.after(600, 100, None);
+    assert!(page["events"].as_array().unwrap().is_empty());
+    let page = journal.after(u64::MAX, 100, None);
+    assert!(page["events"].as_array().unwrap().is_empty() && page["gap"] == false, "a future cursor is no gap");
+    assert_eq!(page["next"], 600);
+    // one request's events; the cursor still advances over the others
+    let page = journal.after(590, 100, Some("even"));
+    assert!(page["events"].as_array().unwrap().iter().all(|e| e["request_id"] == "even"));
+    assert_eq!(page["events"].as_array().unwrap().len(), 5);
+    assert_eq!(page["next"], 600);
+}
+
+#[test]
+fn leases_end_within_ten_seconds() {
+    let now = Instant::now();
+    let mut lease = Lease::default();
+    assert!(!lease.active(now));
+    assert_eq!(lease.renew(now, Duration::from_secs(60)), LEASE, "a long hold is cut to the lease");
+    assert!(lease.active(now + Duration::from_secs(9)));
+    assert!(!lease.expired(now + Duration::from_secs(9)));
+    assert!(lease.expired(now + Duration::from_secs(10)));
+    assert!(!lease.expired(now + Duration::from_secs(11)), "expiry is reported once");
+    lease.renew(now, Duration::from_millis(500));
+    assert_eq!(lease.remaining_ms(now), 500);
+    lease.release();
+    assert!(!lease.active(now));
+}
+
+#[test]
+fn settings_pointers_hide_logins_secrets_and_rlva() {
+    use super::settings::hidden;
+    for p in ["/username", "/last_login", "/remember_password", "/grids/0", "/proxy/http", "/rlva", "/rlva_enabled", "/update_channel", "/login_screen", "/audio/stream_password", "/a/apiToken"] {
+        assert!(hidden(p), "{p}");
+    }
+    for p in ["/draw_distance", "/audio/master", "/camera/fov", ""] {
+        assert!(!hidden(p), "{p}");
+    }
+    assert!(hidden("draw_distance"), "a pointer without a leading slash is refused");
+}
+
+#[test]
+fn settings_writes_keep_the_type() {
+    use super::settings::{get, list, set};
+    let mut tree = json!({"draw_distance": 128.0, "fps_limit": 60, "show_chat": true, "font": "x", "username": "a", "opt": null});
+    assert_eq!(list(&tree), ["draw_distance", "font", "fps_limit", "opt", "show_chat"]);
+    assert_eq!(set(&mut tree, "/draw_distance", json!(256)).unwrap(), json!(128.0), "an integer may stand for a number");
+    assert_eq!(get(&tree, "/draw_distance").unwrap(), json!(256));
+    assert_eq!(set(&mut tree, "/fps_limit", json!(30.5)).unwrap_err().code, "invalid_argument");
+    assert_eq!(set(&mut tree, "/show_chat", json!("yes")).unwrap_err().code, "invalid_argument");
+    assert_eq!(set(&mut tree, "/missing", json!(1)).unwrap_err().code, "not_found");
+    assert_eq!(set(&mut tree, "/username", json!("b")).unwrap_err().code, "refused");
+    assert!(set(&mut tree, "/opt", json!({"a": 1})).is_ok(), "an unset option takes a value");
+    assert_eq!(get(&tree, "").unwrap_err().code, "invalid_argument");
+}
+
+#[test]
+fn hidden_settings_stay_hidden_below_a_visible_parent() {
+    use super::settings::{get, set};
+    let mut tree = json!({"audio": {"master": 0.5, "stream_password": "x", "list": [{"token": "t", "url": "u"}]}});
+    assert_eq!(get(&tree, "/audio").unwrap(), json!({"master": 0.5, "list": [{"url": "u"}]}));
+    let refused = set(&mut tree, "/audio", json!({"master": 1.0})).unwrap_err();
+    assert_eq!(refused.code, "refused", "replacing the parent would drop the hidden child");
+    assert_eq!(set(&mut tree, "/audio/master", json!(1.0)).unwrap(), json!(0.5));
+    assert_eq!(tree["audio"]["stream_password"], "x");
+}
+
+#[test]
+fn numbers_must_stay_finite_as_f32() {
+    let args = json!({"p": [1e100, 0, 0], "x": 1e100, "y": 2.5}).as_object().unwrap().clone();
+    assert!(opt_vec3(&args, "p").is_err());
+    assert!(opt_f32(&args, "x").is_err());
+    assert_eq!(opt_f32(&args, "y").unwrap(), Some(2.5));
+}
+
+#[test]
+fn the_directory_must_be_new_absolute_and_short() {
+    assert!(validate_dir(Path::new("relative/dir")).is_err());
+    assert!(validate_dir(Path::new("/tmp/../tmp/x")).is_err());
+    assert!(validate_dir(Path::new("/nonexistent-parent-acb/x")).is_err());
+    assert!(validate_dir(Path::new("/tmp")).is_err(), "an existing directory is refused");
+    let long = format!("/tmp/{}", "x".repeat(100));
+    assert!(validate_dir(Path::new(&long)).unwrap_err().contains("too long"));
+    assert!(validate_dir(Path::new("/tmp/acb-not-there")).is_ok());
+}
+
+#[test]
+fn the_endpoint_is_private_answers_lines_and_cleans_up() {
+    let base = scratch();
+    let dir = base.join("c");
+    let endpoint = Endpoint::open(&dir).unwrap();
+    assert_eq!(std::fs::metadata(&dir).unwrap().permissions().mode() & 0o777, 0o700);
+    assert_eq!(std::fs::metadata(endpoint.socket()).unwrap().permissions().mode() & 0o777, 0o600);
+    assert!(Endpoint::open(&dir).is_err(), "a second viewer cannot take the same directory");
+
+    let socket = endpoint.socket().to_path_buf();
+    let client = std::thread::spawn(move || {
+        let stream = std::os::unix::net::UnixStream::connect(socket).unwrap();
+        let mut writer = stream.try_clone().unwrap();
+        let mut reader = BufReader::new(stream);
+        let mut replies = Vec::new();
+        for line in [
+            "{\"request_id\":\"one\",\"tool\":\"viewer_state\"}\n",
+            "garbage\n",
+            "{\"request_id\":\"two\",\"tool\":\"viewer_chat\",\"arguments\":{\"op\":\"say\"}}\n",
+        ] {
+            writer.write_all(line.as_bytes()).unwrap();
+            let mut reply = String::new();
+            reader.read_line(&mut reply).unwrap();
+            replies.push(serde_json::from_str::<Value>(&reply).unwrap());
+        }
+        replies
+    });
+    // the frame thread's side
+    let deadline = Instant::now() + Duration::from_secs(10);
+    let mut answered = 0;
+    while answered < 2 && Instant::now() < deadline {
+        if let Some(pending) = endpoint.try_recv() {
+            let outcome = if pending.tool == "viewer_state" {
+                Ok(json!({"pid": 1}))
+            } else {
+                Err(ControlError::refused(format!("{} {}", pending.tool, pending.arguments["op"])))
+            };
+            pending.answer(&outcome);
+            answered += 1;
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let replies = client.join().unwrap();
+    assert_eq!(replies[0], json!({"request_id": "one", "result": {"pid": 1}}));
+    assert_eq!(replies[1]["error"]["code"], "invalid_argument");
+    assert_eq!(replies[2]["request_id"], "two");
+    assert_eq!(replies[2]["error"]["message"], "viewer_chat \"say\"");
+    drop(endpoint);
+    assert!(!dir.exists(), "the endpoint removes its directory");
+    std::fs::remove_dir(&base).unwrap();
+}
