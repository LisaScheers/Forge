+    pub(super) fn control_script(&mut self, args: &Map<String, Value>) -> Outcome {
+        self.require_world()?;
+        let operation = op(args)?;
+        let target = aurora_net::scripts::ScriptTarget {
+            object: opt_uuid(args, "object")?.unwrap_or(Uuid::nil()),
+            item: uuid_arg(args, "item")?,
+        };
+        let open = |app: &App| app.script_editors.documents.iter().any(|e| e.target == target);
+        match operation {
+            "open" => {
+                if self.world.rlva.has("viewscript") {
+                    return Err(ControlError::refused("RLVa forbids viewing scripts (@viewscript)"));
+                }
+                self.open_script(target);
+                if !open(self) {
+                    return Err(ControlError::refused("the script cannot be opened (permissions or a locked attachment)"));
+                }
+            }
+            "read" => {}
+            "edit" => {
+                let source = str_arg(args, "source")?;
+                self.script_editors.control_edit(target, source).map_err(ControlError::refused)?;
+            }
+            "save" => {
+                if let Some(action) = self.script_editors.control_save(target).map_err(ControlError::refused)? {
+                    self.apply_script_action(action);
+                }
+            }
+            other => return Err(unknown(other, "open, read, edit, save")),
+        }
+        if !open(self) {
+            return Err(ControlError::not_found("no open editor for that script; open it first"));
+        }
+        self.script_editors
+            .control_documents()
+            .into_iter()
+            .find(|d| d["item"] == json!(target.item) && d["object"] == json!(target.object))
+            .ok_or_else(|| ControlError::not_found("editor closed"))
+    }
