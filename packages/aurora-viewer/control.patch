+    pub(super) fn control_documents_query(&self, args: &Map<String, Value>) -> Outcome {
+        let id = opt_uuid(args, "id")?;
+        let object = opt_uuid(args, "object")?.unwrap_or(Uuid::nil());
+        let rows: Vec<Value> = self
+            .script_editors
+            .control_documents()
+            .into_iter()
+            .filter(|d| id.is_none_or(|id| d["item"] == json!(id) && d["object"] == json!(object)))
+            .collect();
+        match id {
+            Some(_) => rows
+                .into_iter()
+                .next()
+                .ok_or_else(|| ControlError::not_found("no open document for that item; open it first")),
+            None => Ok(json!({"rows": rows.into_iter().map(|mut d| {
+                d.as_object_mut().map(|m| m.remove("source"));
+                d
+            }).collect::<Vec<_>>()})),
+        }
+    }
