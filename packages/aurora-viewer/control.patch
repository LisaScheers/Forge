+    pub(super) fn control_camera(&mut self, args: &Map<String, Value>) -> Outcome {
+        self.require_world()?;
+        let operation = op(args)?;
+        if operation != "get" && self.world.rlva.camera_owner().is_some() {
+            return Err(ControlError::refused("RLVa controls the camera"));
+        }
+        match operation {
+            "get" => {}
+            "reset" => self.run_shortcut(Action::ResetCamera),
+            "mouselook" => self.run_shortcut(Action::Mouselook),
+            "zoom" => {
+                let fraction = opt_f64(args, "fraction")?.ok_or_else(|| ControlError::invalid("fraction is required"))?;
+                if !(0.0..=1.0).contains(&fraction) {
+                    return Err(ControlError::invalid("fraction must be within [0, 1]"));
+                }
+                self.camera.set_zoom_fraction(fraction as f32);
+            }
+            "focus" => {
+                let (point, avatar) = if let Some(id) = opt_uuid(args, "id")? {
+                    let idx = self
+                        .world
+                        .objects
+                        .index_of_uuid(&id)
+                        .ok_or_else(|| ControlError::not_found("object not in view"))?;
+                    let avatar = self.world.objects.get(idx).is_some_and(|o| o.is_avatar()).then_some(id);
+                    (self.control_position(idx).unwrap_or_default(), avatar)
+                } else {
+                    (crate::control::vec3_arg(args, "position")?, None)
+                };
+                self.on_ctx_action(ui::context::CtxAction::Zoom(point, avatar));
+            }
+            other => return Err(unknown(other, "get, reset, mouselook, zoom, focus")),
+        }
+        Ok(json!({
+            "position": vec3_json(self.camera.position),
+            "target": vec3_json(self.camera.target),
+            "mouselook": self.camera.mouselook(),
+            "zoom": self.camera.zoom_fraction(),
+        }))
+    }
