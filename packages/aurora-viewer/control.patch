diff --git a/crates/aurora-viewer/src/app/control_bridge.rs b/crates/aurora-viewer/src/app/control_bridge.rs
new file mode 100644
index 00000000..1f9fb03e
--- /dev/null
+++ b/crates/aurora-viewer/src/app/control_bridge.rs
@@ -0,0 +1,386 @@
+//! The control bridge in the frame (forge patch): requests from
+//! `crate::control` are answered here, on the frame thread, through the
+//! viewer's own paths. Every network command goes through `App::send`, so
+//! RLVa's send boundary and the viewer's permission checks apply; the tools
+//! add no way around them.
+
+mod act;
+mod input;
+mod query;
+
+use super::*;
+use crate::control::{ControlError, Journal, Lease, Outcome, Pending, journal::Receipt};
+use serde_json::{Map, Value, json};
+use glam::Quat;
+use std::collections::{HashMap, HashSet, VecDeque};
+use uuid::Uuid;
+
+/// Requests answered per frame; the rest wait for the next one.
+const PER_FRAME: usize = 32;
+/// With requests waiting and no frame for this long (an occluded window on
+/// macOS gets no redraws), the bridge runs a frame itself.
+const STALL: Duration = Duration::from_millis(250);
+/// A capture asked for and not delivered in this time is asked again.
+const CAPTURE_RETRY: Duration = Duration::from_secs(5);
+
+/// A synthetic native input event, sent through `window_event` from
+/// `about_to_wait` once the frame counter reaches `frame`.
+pub(super) enum Native {
+    Move(f32, f32),
+    Button(winit::event::MouseButton, bool),
+}
+
+#[derive(Default)]
+pub(super) enum Capture {
+    #[default]
+    Idle,
+    Requested {
+        id: u64,
+        max_width: u32,
+        /// When the renderer was asked for the picture (once; again after
+        /// `CAPTURE_RETRY` without one), and the interface scale then.
+        asked: Option<(Instant, f32)>,
+    },
+    Done {
+        id: u64,
+        result: Value,
+    },
+}
+
+#[derive(Default)]
+struct Cursors {
+    started: bool,
+    chat: Option<(u64, u64)>,
+    ims: HashMap<uuid::Uuid, (u64, u64)>,
+    notifications: HashSet<u64>,
+    screen: &'static str,
+    region: Option<String>,
+    seated: bool,
+    flying: bool,
+}
+
+#[derive(Default)]
+pub(super) struct State {
+    endpoint: Option<crate::control::Endpoint>,
+    journal: Journal,
+    hold: Lease,
+    held: Vec<Action>,
+    drag: Lease,
+    drag_at: Option<(f32, f32)>,
+    answers: Vec<(u64, crate::world::notifications::Response)>,
+    egui: VecDeque<(u64, egui::Event)>,
+    native: VecDeque<(u64, Native)>,
+    capture: Capture,
+    captures: u64,
+    cursors: Cursors,
+    /// The request being answered, for the events it causes.
+    current: Option<String>,
+    /// The window's logical size and scale, read in the frame.
+    window: (f32, f32, f32, u32, u32),
+}
+
+impl State {
+    pub(super) fn from_env() -> State {
+        State {
+            endpoint: crate::control::Endpoint::from_env(),
+            ..State::default()
+        }
+    }
+
+    pub(super) fn enabled(&self) -> bool {
+        self.endpoint.is_some()
+    }
+
+    /// An automation hold of `action` (`viewer_move` op `hold`).
+    pub(super) fn holds(&self, action: Action) -> bool {
+        self.hold.active(Instant::now()) && self.held.contains(&action)
+    }
+
+    /// Notification answers chosen through `viewer_notifications`, handled
+    /// with the cards' own answers.
+    pub(super) fn take_answers(&mut self) -> Vec<(u64, crate::world::notifications::Response)> {
+        std::mem::take(&mut self.answers)
+    }
+
+    pub(super) fn event(&mut self, kind: &'static str, data: Value) {
+        let request = self.current.clone();
+        self.journal.push(kind, request.as_deref(), data);
+    }
+}
+
+pub(super) fn screen_name(screen: &Screen) -> &'static str {
+    match screen {
+        Screen::Login => "login",
+        Screen::Loading { .. } => "loading",
+        Screen::World => "world",
+    }
+}
+
+impl App {
+    /// `about_to_wait`: synthetic native input, and a frame when requests
+    /// wait while the window gets none.
+    pub(super) fn control_idle(&mut self, event_loop: &ActiveEventLoop) {
+        if !self.control.enabled() {
+            return;
+        }
+        self.control_pump_native(event_loop);
+        let waiting = self.control.endpoint.as_ref().is_some_and(|e| e.waiting());
+        if waiting && self.gfx.as_ref().is_some_and(|g| g.shown) && self.last_frame.elapsed() > STALL {
+            self.frame(event_loop);
+        }
+    }
+
+    /// The frame, before the interface's actions apply: the requests, the
+    /// leases, the capture and the events.
+    pub(super) fn control_frame(&mut self, actions: &mut UiActions, gfx: &mut Gfx) {
+        if !self.control.enabled() {
+            return;
+        }
+        let size = gfx.window.inner_size();
+        let ppp = self.egui_ctx.pixels_per_point();
+        self.control.window = (size.width as f32 / ppp, size.height as f32 / ppp, ppp, size.width, size.height);
+        self.control_capture_frame(&mut gfx.renderer);
+        let now = Instant::now();
+        if self.control.hold.expired(now) {
+            self.control.held.clear();
+            self.control.journal.push("lease_expired", None, json!({"lease": "hold"}));
+        }
+        if self.control.drag.expired(now) {
+            self.control_release_drag();
+            self.control.journal.push("lease_expired", None, json!({"lease": "drag"}));
+        }
+        for _ in 0..PER_FRAME {
+            let Some(pending) = self.control.endpoint.as_ref().and_then(|e| e.try_recv()) else {
+                break;
+            };
+            self.control_answer(pending, actions);
+        }
+        self.control_watch();
+    }
+
+    fn control_answer(&mut self, pending: Pending, actions: &mut UiActions) {
+        let op = pending.arguments.get("op").and_then(Value::as_str).map(str::to_owned);
+        self.control.current = Some(pending.request_id.clone());
+        let outcome = self.control_call(&pending.tool, &pending.arguments, &pending.request_id, actions);
+        let ok = outcome.is_ok();
+        // the receipt keeps what was answered; a capture's picture stays out
+        let kept = match &outcome {
+            Ok(result) if pending.tool == "viewer_capture" => json!({"status": result.get("status")}),
+            Ok(result) => result.clone(),
+            Err(error) => error.to_value(),
+        };
+        if !matches!(pending.tool.as_str(), "viewer_state" | "viewer_query" | "viewer_events") {
+            let data = json!({"tool": pending.tool, "op": op, "ok": ok, "error": outcome.as_ref().err().map(ControlError::to_value)});
+            self.control.event("command", data);
+            log::info!(
+                "control bridge: {} {} {}",
+                pending.tool,
+                op.as_deref().unwrap_or("-"),
+                if ok { "ok" } else { "refused or failed" }
+            );
+        }
+        self.control.journal.record(Receipt {
+            request_id: pending.request_id.clone(),
+            tool: pending.tool.clone(),
+            op,
+            time: std::time::SystemTime::now(),
+            outcome: kept,
+            ok,
+        });
+        self.control.current = None;
+        pending.answer(&outcome);
+    }
+
+    fn control_call(&mut self, tool: &str, args: &Map<String, Value>, request_id: &str, actions: &mut UiActions) -> Outcome {
+        match tool {
+            "viewer_state" => Ok(self.control_state()),
+            "viewer_query" => self.control_query(args),
+            "viewer_events" => self.control_events(args),
+            "viewer_settings" => self.control_settings(args, actions),
+            "viewer_move" => self.control_move(args),
+            "viewer_camera" => self.control_camera(args),
+            "viewer_object" => self.control_object(args),
+            "viewer_build" => self.control_build(args),
+            "viewer_inventory" => self.control_inventory(args),
+            "viewer_contents" => self.control_contents(args),
+            "viewer_script" => self.control_script(args),
+            "viewer_notifications" => self.control_notifications(args),
+            "viewer_chat" => self.control_chat(args, actions),
+            "viewer_ui" => self.control_ui(args),
+            "viewer_input" => self.control_input(args),
+            "viewer_capture" => self.control_capture(args, request_id),
+            other => Err(ControlError::new("unknown_tool", format!("no tool named {other}"))),
+        }
+    }
+
+    fn control_events(&mut self, args: &Map<String, Value>) -> Outcome {
+        let after = crate::control::opt_u64(args, "after")?.unwrap_or(0);
+        let limit = crate::control::opt_u64(args, "limit")?.unwrap_or(100).clamp(1, 512) as usize;
+        let request_id = crate::control::opt_str(args, "request_id")?;
+        let mut page = self.control.journal.after(after, limit, request_id);
+        if let Some(id) = request_id {
+            page["receipt"] = self.control.journal.receipt(id).map_or(Value::Null, Receipt::to_value);
+        }
+        Ok(page)
+    }
+
+    /// Events from what changed since the last frame: nearby chat and
+    /// conversation lines, notifications, the screen, region and posture.
+    fn control_watch(&mut self) {
+        let screen = screen_name(&self.screen);
+        let first = !self.control.cursors.started;
+        self.control.cursors.started = true;
+        if self.control.cursors.screen != screen {
+            if !first {
+                self.control.journal.push("screen", None, json!({"screen": screen}));
+            }
+            self.control.cursors.screen = screen;
+        }
+        let region = self.world.main().map(|r| r.name.clone());
+        if self.control.cursors.region != region {
+            if !first && region.is_some() {
+                // RLVa @showloc: the change is reported, not where to
+                let shown = if self.world.rlva.has("showloc") { None } else { region.clone() };
+                self.control.journal.push("region", None, json!({"region": shown}));
+            }
+            self.control.cursors.region = region;
+        }
+        let (seated, flying) = (self.world.agent.seated, self.world.agent.flying);
+        if (seated, flying) != (self.control.cursors.seated, self.control.cursors.flying) {
+            if !first {
+                self.control.journal.push("posture", None, json!({"seated": seated, "flying": flying}));
+            }
+            self.control.cursors.seated = seated;
+            self.control.cursors.flying = flying;
+        }
+        // nearby chat: the lines numbered after the last one seen
+        let clock = self.world.chat_clock;
+        let last = clock.first + self.world.chat.len() as u64;
+        let since = match self.control.cursors.chat {
+            Some((token, seen)) if token == clock.token => seen,
+            _ => last,
+        };
+        if since < last {
+            let skip = since.saturating_sub(clock.first) as usize;
+            let lines: Vec<Value> = self
+                .world
+                .chat
+                .iter()
+                .enumerate()
+                .skip(skip)
+                .filter(|(_, l)| !l.blocked)
+                .map(|(i, l)| query::chat_line(clock.first + i as u64, l))
+                .collect();
+            for line in lines {
+                self.control.journal.push("chat", None, line);
+            }
+        }
+        self.control.cursors.chat = Some((clock.token, last));
+        // conversations
+        let mut seen = HashMap::with_capacity(self.world.social.ims.len());
+        let mut new_lines = Vec::new();
+        for session in &self.world.social.ims {
+            let last = session.clock.first + session.lines.len() as u64;
+            let since = match self.control.cursors.ims.get(&session.other) {
+                Some((token, seen)) if *token == session.clock.token => *seen,
+                Some(_) => last,
+                // a conversation that opens with lines: those after the
+                // history it loaded are new
+                None if first => last,
+                None => session.clock.first + session.lines.len().saturating_sub(session.unread) as u64,
+            };
+            let skip = since.saturating_sub(session.clock.first) as usize;
+            for (i, line) in session.lines.iter().enumerate().skip(skip) {
+                if line.blocked {
+                    continue;
+                }
+                let mut value = query::chat_line(session.clock.first + i as u64, line);
+                value["session"] = json!(session.other);
+                value["group"] = json!(self.world.is_group_session(&session.other));
+                new_lines.push(value);
+            }
+            seen.insert(session.other, (session.clock.token, last));
+        }
+        self.control.cursors.ims = seen;
+        for line in new_lines {
+            self.control.journal.push("im", None, line);
+        }
+        // notifications that came or went
+        let listed: HashSet<u64> = self.world.notifications.list.iter().map(|n| n.id).collect();
+        if !first {
+            let arrived: Vec<Value> = self
+                .world
+                .notifications
+                .list
+                .iter()
+                .filter(|n| !self.control.cursors.notifications.contains(&n.id))
+                .map(query::notification)
+                .collect();
+            for n in arrived {
+                self.control.journal.push("notification", None, n);
+            }
+            let mut gone: Vec<u64> = self.control.cursors.notifications.difference(&listed).copied().collect();
+            gone.sort_unstable();
+            for id in gone {
+                self.control.journal.push("notification_closed", None, json!({"id": id}));
+            }
+        }
+        self.control.cursors.notifications = listed;
+    }
+
+    /// Releases the automation drag, if one is held (cleanup, lease end).
+    fn control_release_drag(&mut self) {
+        if self.control.drag_at.take().is_some() {
+            let frame = self.frame_count;
+            self.control
+                .native
+                .push_back((frame, Native::Button(winit::event::MouseButton::Left, false)));
+        }
+        self.control.drag.release();
+    }
+
+    /// Feeds the queued synthetic native input through the window's own
+    /// event handler, as the system would.
+    fn control_pump_native(&mut self, event_loop: &ActiveEventLoop) {
+        let Some(id) = self.gfx.as_ref().map(|g| g.window.id()) else { return };
+        let scale = self.control.window.2.max(0.1);
+        while self.control.native.front().is_some_and(|(frame, _)| *frame <= self.frame_count) {
+            let Some((_, input)) = self.control.native.pop_front() else { break };
+            let device_id = winit::event::DeviceId::dummy();
+            let event = match input {
+                Native::Move(x, y) => WindowEvent::CursorMoved {
+                    device_id,
+                    position: winit::dpi::PhysicalPosition::new(f64::from(x * scale), f64::from(y * scale)),
+                },
+                Native::Button(button, pressed) => WindowEvent::MouseInput {
+                    device_id,
+                    state: if pressed {
+                        winit::event::ElementState::Pressed
+                    } else {
+                        winit::event::ElementState::Released
+                    },
+                    button,
+                },
+            };
+            ApplicationHandler::window_event(self, event_loop, id, event);
+        }
+    }
+
+    /// Appends the synthetic egui events due this frame (`viewer_input`'s
+    /// UI-only operations).
+    pub(super) fn control_egui_input(&mut self, raw: &mut egui::RawInput) {
+        while self.control.egui.front().is_some_and(|(frame, _)| *frame <= self.frame_count) {
+            if let Some((_, event)) = self.control.egui.pop_front() {
+                raw.events.push(event);
+            }
+        }
+    }
+
+    fn require_world(&self) -> Result<(), ControlError> {
+        if matches!(self.screen, Screen::World) {
+            Ok(())
+        } else {
+            Err(ControlError::unavailable("not in world: a person must log in first (or use the offline demo)"))
+        }
+    }
+}
diff --git a/crates/aurora-viewer/src/app/control_bridge/act.rs b/crates/aurora-viewer/src/app/control_bridge/act.rs
new file mode 100644
index 00000000..09cd68e2
--- /dev/null
+++ b/crates/aurora-viewer/src/app/control_bridge/act.rs
@@ -0,0 +1,685 @@
+//! The tools that act: each takes the viewer's own path for the action, so
+//! its permission checks, protections and RLVa apply.
+
+use super::*;
+use crate::control::{opt_bool, opt_f64, opt_i64, opt_str, opt_u64, opt_uuid, opt_vec3, str_arg, uuid_arg, vec3_json};
+use crate::world::inventory::actions as rules;
+use aurora_net::inventory::operations::{Mutation, Operation};
+
+fn op(args: &Map<String, Value>) -> Result<&str, ControlError> {
+    str_arg(args, "op")
+}
+
+fn unknown(op: &str, known: &str) -> ControlError {
+    ControlError::new("unknown_op", format!("unknown op {op}; ops: {known}"))
+}
+
+fn uuids(args: &Map<String, Value>, name: &str) -> Result<Vec<Uuid>, ControlError> {
+    match crate::control::arg(args, name) {
+        Some(Value::Array(a)) if !a.is_empty() && a.len() <= 256 => a
+            .iter()
+            .map(|v| {
+                v.as_str()
+                    .and_then(|s| Uuid::parse_str(s).ok())
+                    .ok_or_else(|| ControlError::invalid(format!("{name} must hold UUIDs")))
+            })
+            .collect(),
+        Some(Value::String(_)) => Ok(vec![uuid_arg(args, name)?]),
+        _ => Err(ControlError::invalid(format!("{name} must be a UUID or a list of 1 to 256 UUIDs"))),
+    }
+}
+
+/// The runtime-only settings (`#[serde(skip)]`) a JSON round trip resets:
+/// carried over from the settings in use.
+fn carry_runtime(old: &mut crate::settings::Settings, new: &mut crate::settings::Settings) {
+    std::mem::swap(&mut new.debug, &mut old.debug);
+    std::mem::swap(&mut new.hover_height_account, &mut old.hover_height_account);
+    std::mem::swap(&mut new.draw_stepping, &mut old.draw_stepping);
+    std::mem::swap(&mut new.autotune_hold, &mut old.autotune_hold);
+    std::mem::swap(&mut new.photo_held, &mut old.photo_held);
+    std::mem::swap(&mut new.newer_file, &mut old.newer_file);
+    std::mem::swap(&mut new.mfa_hash, &mut old.mfa_hash);
+    new.new_profile = old.new_profile;
+    new.camera_limits_restored = old.camera_limits_restored;
+    new.beacons.light_boxes = old.beacons.light_boxes;
+    new.world_overlays.land_owners = old.world_overlays.land_owners;
+    new.world_overlays.hide_particles = old.world_overlays.hide_particles;
+    new.radar.alert_sounds = old.radar.alert_sounds;
+    new.build.show_probe_volumes = old.build.show_probe_volumes;
+    new.build.select_probes = old.build.select_probes;
+    new.weather.touched = old.weather.touched;
+}
+
+const DIRECTIONS: [(&str, Action); 8] = [
+    ("forward", Action::Forward),
+    ("back", Action::Back),
+    ("left", Action::Left),
+    ("right", Action::Right),
+    ("strafe_left", Action::StrafeLeft),
+    ("strafe_right", Action::StrafeRight),
+    ("up", Action::Up),
+    ("down", Action::Down),
+];
+
+impl App {
+    pub(super) fn control_settings(&mut self, args: &Map<String, Value>, actions: &mut UiActions) -> Outcome {
+        use crate::control::settings;
+        let tree = serde_json::to_value(&self.settings).map_err(|e| ControlError::new("internal", e.to_string()))?;
+        match op(args)? {
+            "list" => Ok(json!({"keys": settings::list(&tree)})),
+            "get" => {
+                let pointer = str_arg(args, "pointer")?;
+                Ok(json!({"pointer": pointer, "value": settings::get(&tree, pointer)?}))
+            }
+            "set" => {
+                let pointer = str_arg(args, "pointer")?;
+                let value = args
+                    .get("value")
+                    .cloned()
+                    .ok_or_else(|| ControlError::invalid("value is required"))?;
+                let persist = opt_bool(args, "persist")?.unwrap_or(false);
+                let mut tree = tree;
+                let previous = settings::set(&mut tree, pointer, value)?;
+                let new: crate::settings::Settings =
+                    serde_json::from_value(tree).map_err(|e| ControlError::invalid(format!("the viewer refused the value: {e}")))?;
+                let mut old = std::mem::replace(&mut self.settings, new);
+                carry_runtime(&mut old, &mut self.settings);
+                let stored = serde_json::to_value(&self.settings)
+                    .ok()
+                    .and_then(|t| t.pointer(pointer).cloned())
+                    .unwrap_or(Value::Null);
+                actions.settings_changed = true;
+                let saved = persist && !self.demo;
+                if saved {
+                    self.settings.save();
+                }
+                Ok(json!({"pointer": pointer, "previous": previous, "value": stored, "persisted": saved}))
+            }
+            other => Err(unknown(other, "list, get, set")),
+        }
+    }
+
+    pub(super) fn control_move(&mut self, args: &Map<String, Value>) -> Outcome {
+        self.require_world()?;
+        match op(args)? {
+            "hold" => {
+                let wanted = match crate::control::arg(args, "directions") {
+                    Some(Value::Array(a)) => a,
+                    _ => return Err(ControlError::invalid("directions must be a list")),
+                };
+                let mut held = Vec::new();
+                for d in wanted {
+                    let name = d.as_str().unwrap_or_default();
+                    let (_, action) = DIRECTIONS.iter().find(|(n, _)| *n == name).ok_or_else(|| {
+                        ControlError::invalid(format!("unknown direction {name}; directions: forward, back, left, right, strafe_left, strafe_right, up, down"))
+                    })?;
+                    held.push(*action);
+                }
+                let duration = opt_u64(args, "duration_ms")?.unwrap_or(1000);
+                let held_for = self.control.hold.renew(Instant::now(), Duration::from_millis(duration));
+                self.control.held = held;
+                Ok(json!({"status": "holding", "duration_ms": held_for.as_millis() as u64, "position": vec3_json(self.world.agent.position)}))
+            }
+            "stop" => {
+                self.control.held.clear();
+                self.control.hold.release();
+                if self.autopilot.is_some() {
+                    self.stop_autopilot(true);
+                }
+                if self.world.following_avatar.is_some() {
+                    self.on_ctx_action(ui::context::CtxAction::StopFollowing);
+                }
+                Ok(json!({"status": "stopped", "position": vec3_json(self.world.agent.position)}))
+            }
+            "goto" => {
+                let target = crate::control::vec3_arg(args, "position")?;
+                let run = opt_bool(args, "run")?.unwrap_or(false);
+                self.walk_to(target, run);
+                Ok(json!({"status": "dispatched", "autopilot": self.autopilot.is_some()}))
+            }
+            "fly" => {
+                let before = self.world.agent.flying;
+                self.run_shortcut(Action::Fly);
+                Ok(json!({"status": "dispatched", "flying_before": before, "flying": self.world.agent.flying}))
+            }
+            "sit" => {
+                let target = uuid_arg(args, "id")?;
+                self.world
+                    .objects
+                    .index_of_uuid(&target)
+                    .ok_or_else(|| ControlError::not_found("object not in view"))?;
+                let offset = opt_vec3(args, "offset")?.unwrap_or(Vec3::ZERO);
+                self.on_ctx_action(ui::context::CtxAction::Sit { target, offset });
+                Ok(json!({"status": "dispatched"}))
+            }
+            "stand" => {
+                self.on_ctx_action(ui::context::CtxAction::StandUp);
+                Ok(json!({"status": "dispatched"}))
+            }
+            "sit_ground" => {
+                self.on_ctx_action(ui::context::CtxAction::SitGround);
+                Ok(json!({"status": "dispatched"}))
+            }
+            other => Err(unknown(other, "hold, stop, goto, fly, sit, stand, sit_ground")),
+        }
+    }
