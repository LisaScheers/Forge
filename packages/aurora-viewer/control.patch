+    pub(super) fn control_build(&mut self, args: &Map<String, Value>) -> Outcome {
+        self.require_world()?;
+        match op(args)? {
+            "select" => {
+                let ids = uuids(args, "ids")?;
+                let mut idxs = Vec::new();
+                for id in &ids {
+                    idxs.push(
+                        self.world
+                            .objects
+                            .index_of_uuid(id)
+                            .ok_or_else(|| ControlError::not_found(format!("{id} not in view")))?,
+                    );
+                }
+                self.build.select_many(&mut self.world, &self.settings.build, &idxs);
+                self.flush_build();
+                Ok(json!({"selected": self.build.sel_prims(&self.world).len()}))
+            }
+            "deselect" => {
+                self.build.deselect_all(&self.world);
+                self.flush_build();
+                Ok(json!({"selected": 0}))
+            }
+            "set" => {
+                let prims = self.build.sel_prims(&self.world);
+                if prims.is_empty() {
+                    return Err(ControlError::unavailable("nothing selected; select first"));
+                }
+                if !prims.iter().any(|&idx| self.build.can_modify(&self.world, idx)) {
+                    return Err(ControlError::refused("you may not modify the selection"));
+                }
+                let position = opt_vec3(args, "position")?;
+                let scale = opt_vec3(args, "scale")?;
+                let rotation = opt_vec3(args, "rotation")?.map(|d| {
+                    Quat::from_euler(glam::EulerRot::ZYX, d.z.to_radians(), d.y.to_radians(), d.x.to_radians())
+                });
+                if position.is_some() || scale.is_some() || rotation.is_some() {
+                    self.build
+                        .set_transform(&mut self.world, &self.settings.build, position, scale, rotation, true);
+                }
+                if let Some(name) = opt_str(args, "name")? {
+                    self.build.set_name(&self.world, name, false);
+                }
+                if let Some(description) = opt_str(args, "description")? {
+                    self.build.set_name(&self.world, description, true);
+                }
+                self.flush_build();
+                Ok(json!({"status": "dispatched", "status_text": self.build.status}))
+            }
+            other => Err(unknown(other, "select, deselect, set")),
+        }
+    }
