+mod tests {
+    use super::carry_runtime;
+    use crate::control::settings;
+    use crate::settings::Settings;
+
+    #[test]
+    fn a_setting_survives_the_round_trip_and_runtime_state_is_kept() {
+        let mut current = Settings {
+            new_profile: true,
+            camera_limits_restored: true,
+            ..Settings::default()
+        };
+        current.world_overlays.hide_particles = true;
+        current.weather.touched = true;
+        let mut tree = serde_json::to_value(&current).unwrap();
+        let before = current.draw_distance;
+        let previous = settings::set(&mut tree, "/draw_distance", serde_json::json!(before + 32.0)).unwrap();
+        assert_eq!(previous, serde_json::json!(before));
+        let new: Settings = serde_json::from_value(tree).unwrap();
+        let mut old = std::mem::replace(&mut current, new);
+        carry_runtime(&mut old, &mut current);
+        assert_eq!(current.draw_distance, before + 32.0);
+        assert!(current.new_profile && current.camera_limits_restored);
+        assert!(current.world_overlays.hide_particles && current.weather.touched);
+        // every other setting reads back unchanged
+        let mut expected = serde_json::to_value(&old).unwrap();
+        expected["draw_distance"] = serde_json::json!(before + 32.0);
+        assert_eq!(serde_json::to_value(&current).unwrap(), expected);
+    }
+
+    #[test]
+    fn login_and_rlva_settings_stay_out_of_reach() {
+        let tree = serde_json::to_value(Settings::default()).unwrap();
+        let keys = settings::list(&tree);
+        for hidden in ["username", "last_login", "grids", "proxy", "rlva", "rlva_enabled", "mfa_hash"] {
+            assert!(!keys.iter().any(|k| k == hidden), "{hidden}");
+        }
+        assert!(keys.iter().any(|k| k == "draw_distance"));
+    }
+}
diff --git a/crates/aurora-viewer/src/app/control_bridge/input.rs b/crates/aurora-viewer/src/app/control_bridge/input.rs
new file mode 100644
index 00000000..3d329d21
--- /dev/null
+++ b/crates/aurora-viewer/src/app/control_bridge/input.rs
@@ -0,0 +1,415 @@
+//! `viewer_ui`, `viewer_input` and `viewer_capture`: panels and shortcuts,
+//! synthetic pointer and keyboard input, and pictures of the window.
+
+use super::*;
+use crate::control::{opt_f32, opt_str, opt_u64, str_arg};
+
+/// Panels by name, with the shortcut that guards them under RLVa.
+macro_rules! panels {
+    ($($name:ident $(=> $action:ident)?),* $(,)?) => {
+        const PANELS: &[&str] = &[$(stringify!($name)),*];
+
+        fn panel_open(p: &ui::Panels, name: &str) -> Option<bool> {
+            match name {
+                $(stringify!($name) => Some(p.$name),)*
+                _ => None,
+            }
+        }
+
+        fn panel_slot<'a>(p: &'a mut ui::Panels, name: &str) -> Option<&'a mut bool> {
+            match name {
+                $(stringify!($name) => Some(&mut p.$name),)*
+                _ => None,
+            }
+        }
+
+        fn panel_action(name: &str) -> Option<Action> {
+            match name {
+                $($(stringify!($name) => Some(Action::$action),)?)*
+                _ => None,
+            }
+        }
+    };
+}
+
+panels! {
+    chat => NearbyChat,
+    people => People,
+    minimap => Minimap,
+    world_map => WorldMap,
+    region_tracker,
+    beacons => Beacons,
+    settings => Preferences,
+    environment,
+    inventory => Inventory,
+    texture_library => TextureLibrary,
+    gestures => Gestures,
+    appearance => Appearance,
+    ao,
+    contacts => Contacts,
+    about_land,
+    region_estate => RegionEstate,
+    places,
+    search => Search,
+    area_search,
+    snapshot => PhotoWindow,
+    perf => Performance,
+    debug_settings => DebugSettings,
+    conversation_log,
+    camera_controls => CameraControls,
+    movement_controls,
+    money_tracker,
+    experiences,
+    grid_status,
+    voice_controls,
+    destinations,
+    quick_prefs,
+    omnifilter,
+    about,
+}
+
+/// The shortcut actions (`keybinds::Action`) a request may run: the held
+/// movement keys go through `viewer_move` instead.
+const SHORTCUTS: &[&str] = &[
+    "StopMoving", "Fly", "FlyOverride", "AlwaysRun", "SitGround", "Mouselook", "ResetCamera", "ResetCameraAngles",
+    "FocusSelection", "ZoomSelection", "LookAtLastChatter", "CameraControls", "LensZoomIn", "LensZoomOut", "LensZoomDefault",
+    "Conversations", "Contacts", "NearbyChat", "People", "Friends", "Groups", "ContactSets", "Inventory", "NewInventoryWindow",
+    "Appearance", "Gestures", "Minimap", "WorldMap", "TeleportHistory", "RegionEstate", "TextureLibrary", "Search",
+    "Performance", "Preferences", "ToggleInterface", "HoverTips", "ShowHuds", "ShowTransparency", "SelectionOutlines",
+    "Beacons", "ContactMarkers", "PropertyLines", "LandOwners", "HideParticles", "DebugSettings", "Rebake", "StopAnimations",
+    "ResyncAnimations", "RefreshAttachments", "PhotoWindow", "EnvSunrise", "EnvMidday", "EnvSunset", "EnvMidnight", "EnvShared",
+];
+
+fn pointer_button(name: Option<&str>) -> Result<(egui::PointerButton, winit::event::MouseButton), ControlError> {
+    match name.unwrap_or("left") {
+        "left" => Ok((egui::PointerButton::Primary, winit::event::MouseButton::Left)),
+        "right" => Ok((egui::PointerButton::Secondary, winit::event::MouseButton::Right)),
+        "middle" => Ok((egui::PointerButton::Middle, winit::event::MouseButton::Middle)),
+        _ => Err(ControlError::invalid("button must be left, right or middle")),
+    }
+}
+
+fn modifiers(args: &Map<String, Value>) -> Result<egui::Modifiers, ControlError> {
+    let mut m = egui::Modifiers::default();
+    if let Some(Value::Array(list)) = crate::control::arg(args, "modifiers") {
+        for name in list {
+            match name.as_str() {
+                Some("shift") => m.shift = true,
+                Some("ctrl") => m.ctrl = true,
+                Some("alt") => m.alt = true,
+                Some("command") => {
+                    m.command = true;
+                    m.mac_cmd = cfg!(target_os = "macos");
+                }
+                _ => return Err(ControlError::invalid("modifiers: shift, ctrl, alt, command")),
+            }
+        }
+    }
+    if !cfg!(target_os = "macos") && m.ctrl {
+        m.command = true;
+    }
+    Ok(m)
+}
+
+impl App {
+    pub(super) fn control_ui(&mut self, args: &Map<String, Value>) -> Outcome {
+        match str_arg(args, "op")? {
+            "list" => {
+                let mut rows: Vec<Value> = PANELS
+                    .iter()
+                    .map(|name| json!({"name": name, "open": panel_open(&self.panels, name)}))
+                    .collect();
+                rows.push(json!({"name": "notifications", "open": self.notif_ui.open}));
+                Ok(json!({"panels": rows}))
+            }
+            "actions" => {
+                let actions: Vec<Value> = SHORTCUTS
+                    .iter()
+                    .filter_map(|name| {
+                        let action: Action = serde_json::from_value(json!(name)).ok()?;
+                        Some(json!({
+                            "name": name,
+                            "label": crate::keybinds::label(action),
+                            "refused": self.rlva_refuses_shortcut(action),
+                        }))
+                    })
+                    .collect();
+                Ok(json!({"actions": actions, "note": "shortcut actions may toggle; read their effect afterwards"}))
+            }
+            "run" => {
+                self.require_world()?;
+                let name = str_arg(args, "action")?;
+                let action: Action = SHORTCUTS
+                    .contains(&name)
+                    .then(|| serde_json::from_value(json!(name)).ok())
+                    .flatten()
+                    .ok_or_else(|| ControlError::invalid("unknown action; see op actions"))?;
+                if self.rlva_refuses_shortcut(action) {
+                    return Err(ControlError::refused("RLVa refuses this action"));
+                }
+                self.run_shortcut(action);
+                Ok(json!({"status": "dispatched"}))
+            }
+            op @ ("open" | "close") => {
+                let name = str_arg(args, "name")?;
+                let open = op == "open";
+                if name == "notifications" {
+                    self.notif_ui.open = open;
+                    return Ok(json!({"name": name, "open": open}));
+                }
+                if open
+                    && let Some(action) = panel_action(name)
+                    && self.rlva_refuses_shortcut(action)
+                {
+                    return Err(ControlError::refused("RLVa refuses this panel"));
+                }
+                let slot = panel_slot(&mut self.panels, name).ok_or_else(|| ControlError::not_found("unknown panel; see op list"))?;
+                *slot = open;
+                Ok(json!({"name": name, "open": open}))
+            }
+            other => Err(ControlError::new("unknown_op", format!("unknown op {other}; ops: list, open, close, actions, run"))),
+        }
+    }
+
+    fn point(&self, args: &Map<String, Value>) -> Result<(f32, f32), ControlError> {
+        let x = opt_f32(args, "x")?.ok_or_else(|| ControlError::invalid("x is required"))?;
+        let y = opt_f32(args, "y")?.ok_or_else(|| ControlError::invalid("y is required"))?;
+        let (w, h, ..) = self.control.window;
+        if x < 0.0 || y < 0.0 || x > w || y > h {
+            return Err(ControlError::invalid(format!("({x}, {y}) is outside the window ({w} × {h} points)")));
+        }
+        Ok((x, y))
+    }
+
+    pub(super) fn control_input(&mut self, args: &Map<String, Value>) -> Outcome {
+        let op = str_arg(args, "op")?;
+        let next = self.frame_count + 1;
+        let human_gesture = self.left_down && self.control.drag_at.is_none();
+        // an earlier gesture's press or release still queued holds the pointer
+        let gesture_queued = self.control.native.iter().any(|(_, n)| matches!(n, Native::Button(..)));
+        match op {
+            "move" | "click" | "double_click" | "scroll" => {
+                // everything is checked before anything is queued
+                let (x, y) = self.point(args)?;
+                let pos = egui::pos2(x, y);
+                let mods = modifiers(args)?;
+                let (button, _) = pointer_button(opt_str(args, "button")?)?;
+                let dx = opt_f32(args, "dx")?.unwrap_or(0.0);
+                let dy = opt_f32(args, "dy")?.unwrap_or(0.0);
+                let egui = &mut self.control.egui;
+                egui.push_back((next, egui::Event::PointerMoved(pos)));
+                match op {
+                    "click" | "double_click" => {
+                        let clicks = if op == "double_click" { 2 } else { 1 };
+                        for i in 0..clicks {
+                            let frame = next + 1 + 2 * i;
+                            for pressed in [true, false] {
+                                egui.push_back((
+                                    frame + u64::from(!pressed),
+                                    egui::Event::PointerButton {
+                                        pos,
+                                        button,
+                                        pressed,
+                                        modifiers: mods,
+                                    },
+                                ));
+                            }
+                        }
+                    }
+                    "scroll" => {
+                        egui.push_back((
+                            next,
+                            egui::Event::MouseWheel {
+                                unit: egui::MouseWheelUnit::Line,
+                                delta: egui::vec2(dx, dy),
+                                phase: egui::TouchPhase::Move,
+                                source: egui::MouseWheelSource::Wheel,
+                                modifiers: mods,
+                            },
+                        ));
+                    }
+                    _ => {}
+                }
+                Ok(json!({"status": "queued", "route": "egui"}))
+            }
+            "key" => {
+                let name = str_arg(args, "key")?;
+                let key = egui::Key::from_name(name).ok_or_else(|| ControlError::invalid("unknown key name (egui names: Enter, Escape, Tab, A…)"))?;
+                let mods = modifiers(args)?;
+                for (offset, pressed) in [(0, true), (1, false)] {
+                    self.control.egui.push_back((
+                        next + offset,
+                        egui::Event::Key {
+                            key,
+                            physical_key: None,
+                            pressed,
+                            repeat: false,
+                            modifiers: mods,
+                        },
+                    ));
+                }
+                Ok(json!({"status": "queued", "route": "egui"}))
+            }
+            "text" => {
+                let text = str_arg(args, "text")?;
+                if text.len() > 4096 {
+                    return Err(ControlError::invalid("text longer than 4096 bytes"));
+                }
+                self.control.egui.push_back((next, egui::Event::Text(text.to_owned())));
+                Ok(json!({"status": "queued", "route": "egui"}))
+            }
+            "game_click" => {
+                if human_gesture || gesture_queued || self.control.drag_at.is_some() || self.clicks.waiting() {
+                    return Err(ControlError::unavailable("a gesture or pick is in progress; wait for pointer_down=false and pick_pending=false"));
+                }
+                let (x, y) = self.point(args)?;
+                let (_, button) = pointer_button(opt_str(args, "button")?)?;
+                let native = &mut self.control.native;
+                native.push_back((self.frame_count, Native::Move(x, y)));
+                native.push_back((next, Native::Button(button, true)));
+                native.push_back((next + 2, Native::Button(button, false)));
+                Ok(json!({"status": "queued", "route": "native"}))
+            }
+            "drag_start" => {
+                if human_gesture || gesture_queued || self.control.drag_at.is_some() || self.clicks.waiting() {
+                    return Err(ControlError::unavailable("a gesture or pick is in progress"));
+                }
+                let (x, y) = self.point(args)?;
+                self.control.native.push_back((self.frame_count, Native::Move(x, y)));
+                self.control.native.push_back((next, Native::Button(winit::event::MouseButton::Left, true)));
+                self.control.drag_at = Some((x, y));
+                self.control.drag.renew(Instant::now(), crate::control::journal::LEASE);
+                Ok(json!({"status": "queued", "route": "native", "lease_ms": crate::control::journal::LEASE.as_millis() as u64}))
+            }
+            "drag_move" => {
+                if self.control.drag_at.is_none() {
+                    return Err(ControlError::unavailable("no automation drag; drag_start first"));
+                }
+                let (x, y) = self.point(args)?;
+                self.control.native.push_back((self.frame_count, Native::Move(x, y)));
+                self.control.drag_at = Some((x, y));
+                self.control.drag.renew(Instant::now(), crate::control::journal::LEASE);
+                Ok(json!({"status": "queued", "route": "native"}))
+            }
+            "drag_end" => {
+                if self.control.drag_at.is_none() {
+                    return Err(ControlError::unavailable("no automation drag"));
+                }
+                if crate::control::arg(args, "x").is_some() {
+                    let (x, y) = self.point(args)?;
+                    self.control.native.push_back((self.frame_count, Native::Move(x, y)));
+                }
+                self.control_release_drag();
+                Ok(json!({"status": "queued", "route": "native"}))
+            }
+            other => Err(ControlError::new(
+                "unknown_op",
+                format!("unknown op {other}; ops: move, click, double_click, scroll, key, text, game_click, drag_start, drag_move, drag_end"),
+            )),
+        }
+    }
+
+    pub(super) fn control_capture(&mut self, args: &Map<String, Value>, _request_id: &str) -> Outcome {
+        match str_arg(args, "op")? {
+            "start" => {
+                let max_width = opt_u64(args, "max_width")?.unwrap_or(1600).clamp(64, 8192) as u32;
+                self.control.captures += 1;
+                let id = self.control.captures;
+                // a pending capture is replaced; the picture already asked
+                // for serves the new one
+                let asked = match self.control.capture {
+                    Capture::Requested { asked, .. } => asked,
+                    _ => None,
+                };
+                self.control.capture = Capture::Requested { id, max_width, asked };
+                Ok(json!({"status": "pending", "capture_id": id, "occluded": self.occluded}))
+            }
+            "poll" => {
+                let wanted = opt_u64(args, "capture_id")?;
+                match &self.control.capture {
+                    Capture::Idle => Err(ControlError::not_found("no capture; start one")),
+                    Capture::Requested { id, .. } if wanted.is_none_or(|w| w == *id) => Ok(json!({
+                        "status": "pending",
+                        "capture_id": id,
+                        // macOS draws nothing for a covered window
+                        "occluded": self.occluded,
+                    })),
+                    Capture::Done { id, result } if wanted.is_none_or(|w| w == *id) => Ok(result.clone()),
+                    _ => Err(ControlError::not_found("that capture was replaced by a newer one")),
+                }
+            }
+            other => Err(ControlError::new("unknown_op", format!("unknown op {other}; ops: start, poll"))),
+        }
+    }
+
+    /// Asks the renderer for the next frame's picture when no other capture
+    /// is waiting for one, and encodes it once it is back.
+    pub(super) fn control_capture_frame(&mut self, renderer: &mut aurora_render::Renderer) {
+        let Capture::Requested { id, max_width, asked } = self.control.capture else { return };
+        let others = self.inventory_images.capturing.is_some()
+            || self.inventory_images.auto_capture_pending
+            || self.scene_capture_pending
+            || self.capture.is_some();
+        if others {
+            return;
+        }
+        let picture = if asked.is_some() { renderer.captured.take() } else { None };
+        let Some((w, h, pixels)) = picture else {
+            // one request at a time: a second picture would be left for
+            // another capture's owner to take
+            if asked.is_none_or(|(at, _)| at.elapsed() >= super::CAPTURE_RETRY) {
+                renderer.capture_request = true;
+                self.control.capture = Capture::Requested {
+                    id,
+                    max_width,
+                    asked: Some((Instant::now(), self.control.window.2)),
+                };
+            }
+            return;
+        };
+        // The picture's own size is the window's at capture; the scale is the
+        // one when it was asked for, and a change since makes the mapping
+        // unknown.
+        let ppp = asked.map_or(self.control.window.2, |(_, ppp)| ppp);
+        if (self.control.window.2 - ppp).abs() > f32::EPSILON {
+            self.control.capture = Capture::Done {
+                id,
+                result: json!({"status": "failed", "capture_id": id, "error": "the interface scale changed during the capture; start another"}),
+            };
+            return;
+        }
+        let (window_w, window_h) = (w, h);
+        let result = match encode_png(w, h, pixels, max_width) {
+            Ok((png, width, height)) => {
+                use base64::Engine;
+                json!({
+                    "status": "done",
+                    "capture_id": id,
+                    "width": width,
+                    "height": height,
+                    "window_pixels": [window_w, window_h],
+                    "ui_pixels_per_point": ppp,
+                    "png_base64": base64::engine::general_purpose::STANDARD.encode(png),
+                })
+            }
+            Err(e) => json!({"status": "failed", "capture_id": id, "error": e}),
+        };
+        self.control.capture = Capture::Done { id, result };
+    }
+}
+
+fn encode_png(w: u32, h: u32, pixels: Vec<u8>, max_width: u32) -> Result<(Vec<u8>, u32, u32), String> {
+    let image = image::RgbaImage::from_raw(w, h, pixels).ok_or("the capture has the wrong size")?;
+    let image = if w > max_width {
+        let height = ((h as u64 * max_width as u64) / w as u64).max(1) as u32;
+        image::imageops::resize(&image, max_width, height, image::imageops::FilterType::Triangle)
+    } else {
+        image
+    };
+    let (width, height) = image.dimensions();
+    let mut png = Vec::new();
+    image::DynamicImage::ImageRgba8(image)
+        .write_to(&mut std::io::Cursor::new(&mut png), image::ImageFormat::Png)
+        .map_err(|e| e.to_string())?;
+    Ok((png, width, height))
+}
diff --git a/crates/aurora-viewer/src/app/control_bridge/query.rs b/crates/aurora-viewer/src/app/control_bridge/query.rs
new file mode 100644
index 00000000..e1986bea
--- /dev/null
+++ b/crates/aurora-viewer/src/app/control_bridge/query.rs
@@ -0,0 +1,522 @@
+//! `viewer_state` and `viewer_query`: observation only.
+
+use super::*;
+use crate::control::{opt_bool, opt_f64, opt_str, opt_uuid, page, paging, quat_json, str_arg, unix_ms, vec3_json};
+use crate::world::{ChatKind, ChatLine};
+
+pub(super) fn chat_kind(kind: &ChatKind) -> String {
+    let volume = |t: &aurora_net::ChatType| format!("{t:?}").to_ascii_lowercase();
+    match kind {
+        ChatKind::Local(t) => format!("local:{}", volume(t)),
+        ChatKind::Object(t) => format!("object:{}", volume(t)),
+        ChatKind::System => "system".into(),
+        ChatKind::Im => "im".into(),
+        ChatKind::ObjectIm => "object_im".into(),
+        ChatKind::Own(t) => format!("own:{}", volume(t)),
+        ChatKind::Invite(_) => "card:teleport".into(),
+        ChatKind::InventoryOffer(_) => "card:inventory".into(),
+        ChatKind::Payment(_) => "card:payment".into(),
+    }
+}
+
+/// A chat or conversation line: `n` is its stable line number.
+pub(super) fn chat_line(n: u64, line: &ChatLine) -> Value {
+    json!({
+        "n": n,
+        "time_ms": unix_ms(line.time),
+        "from": line.from,
+        "source": line.source,
+        "kind": chat_kind(&line.kind),
+        "text": line.text,
+    })
+}
+
+pub(super) fn notification(n: &crate::world::notifications::Notification) -> Value {
+    use crate::world::notifications::Data;
+    let (buttons, text_box, object) = match &n.data {
+        Data::Dialog { buttons, object, .. } => (buttons.clone(), false, Some(*object)),
+        Data::TextBox { object, .. } => (Vec::new(), true, Some(*object)),
+        _ => (Vec::new(), false, None),
+    };
+    json!({
+        "id": n.id,
+        "time_ms": unix_ms(n.time),
+        "kind": format!("{:?}", n.kind).to_ascii_lowercase(),
+        "title": n.title,
+        "body": n.body,
+        "read": n.read,
+        "interactive": n.interactive(),
+        "buttons": buttons,
+        "text_box": text_box,
+        "object": object,
+        "text": n.text,
+    })
+}
+
+impl App {
+    pub(super) fn control_state(&self) -> Value {
+        let now = Instant::now();
+        let (width, height, ppp, pixels_w, pixels_h) = self.control.window;
+        let agent = &self.world.agent;
+        let in_world = matches!(self.screen, Screen::World);
+        let unread_ims: usize = self.world.social.ims.iter().map(|s| s.unread).sum();
+        // RLVa @showloc hides where the avatar is, as the viewer's own bars do
+        let location = !self.world.rlva.has("showloc");
+        json!({
+            "api": 1,
+            "pid": std::process::id(),
+            "version": aurora_version::version(),
+            "demo": self.demo,
+            "screen": super::screen_name(&self.screen),
+            "in_world": in_world,
+            "agent": in_world.then(|| json!({
+                "id": self.world.agent_id,
+                "name": self.world.own_name(),
+                "position": vec3_json(agent.position),
+                "velocity": vec3_json(agent.velocity),
+                "yaw": agent.yaw,
+                "flying": agent.flying,
+                "seated": agent.seated,
+                "autopilot": self.autopilot.is_some(),
+                "following": self.world.following_avatar,
+            })),
+            "region": self.world.main().filter(|_| location).map(|r| json!({"name": r.name, "handle": r.handle})),
+            "parcel": (in_world && location).then(|| json!({"name": self.world.parcel_name})),
+            "location_hidden": !location,
+            "camera": in_world.then(|| json!({
+                "position": vec3_json(self.camera.position),
+                "target": vec3_json(self.camera.target),
+                "mouselook": self.camera.mouselook(),
+                "zoom": self.camera.zoom_fraction(),
+                "rlva_owned": self.world.rlva.camera_owner().is_some(),
+            })),
+            "inventory_root": (!self.world.inventory.root.is_nil()).then_some(self.world.inventory.root),
+            "library_root": (!self.world.inventory.lib_root.is_nil()).then_some(self.world.inventory.lib_root),
+            "unread": {
+                "nearby": self.world.chat_unread,
+                "conversations": unread_ims,
+                "notifications": self.world.notifications.unread(),
+            },
+            "window": {
+                "width_points": width,
+                "height_points": height,
+                "ui_pixels_per_point": ppp,
+                "window_pixels": [pixels_w, pixels_h],
+                "focused": self.focused,
+                "occluded": self.occluded,
+            },
+            "input": {
+                "pointer_down": self.left_down,
+                "pick_pending": self.clicks.waiting(),
+                "drag": self.control.drag_at.is_some(),
+                "drag_ms": self.control.drag.remaining_ms(now),
+                "hold": self.control.held.iter().map(|a| format!("{a:?}")).collect::<Vec<_>>(),
+                "hold_ms": self.control.hold.remaining_ms(now),
+            },
+            "rlva": self.settings.rlva_enabled,
+            "events": {"cursor": self.control.journal.cursor(), "oldest": self.control.journal.oldest()},
+            "receipts": self.control.journal.receipt_count(),
+            "endpoint": self.control.endpoint.as_ref().map(|e| e.socket().display().to_string()),
+        })
+    }
+
+    /// Region-local position of an object (its parents applied), in the
+    /// main region's frame.
+    pub(super) fn control_position(&self, idx: usize) -> Option<Vec3> {
+        let mut o = self.world.objects.get(idx)?;
+        let mut position = o.position;
+        for _ in 0..16 {
+            let Some(parent) = self.world.objects.parent_of(o).and_then(|p| self.world.objects.get(p)) else {
+                break;
+            };
+            if parent.is_avatar() && o.is_attachment() {
+                // attachments follow their wearer's body: report the wearer
+                position = parent.position;
+            } else {
+                position = parent.position + parent.rotation * position;
+            }
+            o = parent;
+        }
+        Some(position + self.world.region_offset(o.key.region).unwrap_or(Vec3::ZERO))
+    }
+
+    /// A group or conference session's name, or the resident's.
+    pub(super) fn control_conversation_name(&self, id: Uuid) -> String {
+        match self.world.groups.sessions.get(&id) {
+            Some(session) if !session.name.is_empty() => session.name.clone(),
+            _ => self.world.social.name_of(&id),
+        }
+    }
+
+    pub(super) fn control_name(&self, idx: usize) -> Option<String> {
+        let o = self.world.objects.get(idx)?;
+        if o.is_avatar() {
+            // RLVa @shownames: the same rule as the avatars topic
+            return (!self.world.rlva.has("shownames") || o.full_id == self.world.agent_id).then(|| self.world.social.name_of(&o.full_id));
+        }
+        self.build
+            .props
+            .get(&o.full_id)
+            .map(|p| p.name.clone())
+            .or_else(|| o.display_name())
+    }
+
+    fn control_object_row(&self, idx: usize) -> Option<Value> {
+        let o = self.world.objects.get(idx)?;
+        let position = self.control_position(idx)?;
+        Some(json!({
+            "id": o.full_id,
+            "local_id": o.key.local_id,
+            "name": self.control_name(idx),
+            "position": vec3_json(position),
+            "distance": (position - self.world.agent.position).length(),
+            "owner": o.owner_id,
+            "click_action": o.click_action,
+            "text": (!o.text.is_empty()).then_some(&o.text),
+        }))
+    }
+
+    pub(super) fn control_object_detail(&self, idx: usize) -> Option<Value> {
+        let o = self.world.objects.get(idx)?;
+        let props = self.build.props.get(&o.full_id);
+        let parent = self.world.objects.parent_of(o).and_then(|p| self.world.objects.get(p)).map(|p| p.full_id);
+        let children: Vec<Uuid> = self
+            .world
+            .objects
+            .children_of(&o.key)
+            .iter()
+            .filter_map(|&c| self.world.objects.get(c).map(|c| c.full_id))
+            .collect();
+        let faces = o.te.as_ref().map(|te| te.faces.len());
+        Some(json!({
+            "id": o.full_id,
+            "local_id": o.key.local_id,
+            "name": self.control_name(idx),
+            "description": props.map(|p| &p.description),
+            "properties_loaded": props.is_some(),
+            "position": self.control_position(idx).map(vec3_json),
+            "local_position": vec3_json(o.position),
+            "rotation": quat_json(o.rotation),
+            "scale": vec3_json(o.scale),
+            "parent": parent,
+            "children": children,
+            "owner": o.owner_id,
+            "creator": props.map(|p| p.creator_id),
+            "group": props.map(|p| p.group_id),
+            "permissions": props.map(|p| json!({
+                "owner": perm_names(p.owner_mask),
+                "next_owner": perm_names(p.next_owner_mask),
+                "group": perm_names(p.group_mask),
+                "everyone": perm_names(p.everyone_mask),
+            })),
+            "touch_name": props.map(|p| &p.touch_name),
+            "sit_name": props.map(|p| &p.sit_name),
+            "click_action": o.click_action,
+            "faces": faces,
+            "avatar": o.is_avatar(),
+            "attachment": o.is_attachment(),
+            "attachment_point": o.is_attachment().then(|| o.attachment_point()),
+            "hud": self.world.objects.worn_on_hud(idx),
+            "text": o.text,
+        }))
+    }
+
+    pub(super) fn control_query(&mut self, args: &Map<String, Value>) -> Outcome {
+        let topic = str_arg(args, "topic")?;
+        let (offset, limit) = paging(args)?;
+        let rlva = &self.world.rlva;
+        match topic {
+            "chat" => {
+                let first = self.world.chat_clock.first;
+                let rows: Vec<Value> = self
+                    .world
+                    .chat
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, l)| !l.blocked)
+                    .map(|(i, l)| chat_line(first + i as u64, l))
+                    .collect();
+                Ok(latest_page(rows, offset, limit, opt_bool(args, "latest")?.unwrap_or(true)))
+            }
+            "conversations" => {
+                let rows = self
+                    .world
+                    .social
+                    .ims
+                    .iter()
+                    .map(|s| {
+                        json!({
+                            "id": s.other,
+                            "name": self.control_conversation_name(s.other),
+                            "group": self.world.is_group_session(&s.other),
+                            "unread": s.unread,
+                            "lines": s.lines.len(),
+                            "last": s.lines.back().map(|l| unix_ms(l.time)),
+                        })
+                    })
+                    .collect();
+                Ok(page(rows, offset, limit))
+            }
+            "im" => {
+                let id = crate::control::uuid_arg(args, "id")?;
+                let session = self
+                    .world
+                    .social
+                    .ims
+                    .iter()
+                    .find(|s| s.other == id)
+                    .ok_or_else(|| ControlError::not_found("no conversation with that id; see topic conversations"))?;
+                let rows = session
+                    .lines
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, l)| !l.blocked)
+                    .map(|(i, l)| chat_line(session.clock.first + i as u64, l))
+                    .collect();
+                let mut result = latest_page(rows, offset, limit, opt_bool(args, "latest")?.unwrap_or(true));
+                result["unread"] = json!(session.unread);
+                Ok(result)
+            }
+            "avatars" => {
+                self.require_world()?;
+                if rlva.has("shownearby") {
+                    return Err(ControlError::refused("RLVa hides nearby residents (@shownearby)"));
+                }
+                let names = !rlva.has("shownames");
+                let me = self.world.agent.position;
+                let mut rows: Vec<(f32, Value)> = self
+                    .world
+                    .objects
+                    .avatars()
+                    .filter(|(_, o)| o.full_id != self.world.agent_id)
+                    .filter_map(|(idx, o)| {
+                        let position = self.control_position(idx)?;
+                        let distance = (position - me).length();
+                        Some((
+                            distance,
+                            json!({
+                                "id": o.full_id,
+                                "name": names.then(|| self.world.social.name_of(&o.full_id)),
+                                "position": vec3_json(position),
+                                "distance": distance,
+                            }),
+                        ))
+                    })
+                    .collect();
+                rows.sort_by(|a, b| a.0.total_cmp(&b.0));
+                Ok(page(rows.into_iter().map(|r| r.1).collect(), offset, limit))
+            }
+            "objects" => {
+                self.require_world()?;
+                let radius = opt_f64(args, "radius")?.unwrap_or(32.0).clamp(1.0, 256.0) as f32;
+                let search = opt_str(args, "search")?.map(str::to_lowercase);
+                let me = self.world.agent.position;
+                let mut rows: Vec<(f32, Value)> = self
+                    .world
+                    .objects
+                    .iter()
+                    .filter(|(_, o)| !o.is_avatar() && !o.is_attachment() && o.parent_id == 0)
+                    .filter_map(|(idx, _)| {
+                        let position = self.control_position(idx)?;
+                        let distance = (position - me).length();
+                        if distance > radius {
+                            return None;
+                        }
+                        let row = self.control_object_row(idx)?;
+                        if let Some(search) = &search {
+                            let name = row["name"].as_str().unwrap_or_default().to_lowercase();
+                            if !name.contains(search.as_str()) {
+                                return None;
+                            }
+                        }
+                        Some((distance, row))
+                    })
+                    .collect();
+                rows.sort_by(|a, b| a.0.total_cmp(&b.0));
+                Ok(page(rows.into_iter().map(|r| r.1).collect(), offset, limit))
+            }
+            "object" => {
+                self.require_world()?;
+                let id = crate::control::uuid_arg(args, "id")?;
+                let idx = self
+                    .world
+                    .objects
+                    .index_of_uuid(&id)
+                    .ok_or_else(|| ControlError::not_found("object not in view (not cached is not proof it does not exist)"))?;
+                self.control_object_detail(idx).ok_or_else(|| ControlError::not_found("object gone"))
+            }
+            "huds" | "attachments" => {
+                self.require_world()?;
+                let me = self.world.agent_id;
+                let hud = topic == "huds";
+                let rows = self
+                    .world
+                    .objects
+                    .iter()
+                    .filter(|(idx, o)| {
+                        o.is_attachment()
+                            && self.world.objects.worn_on_hud(*idx) == hud
+                            && crate::ui::context::wearer(&self.world, *idx) == Some(me)
+                    })
+                    .filter_map(|(idx, o)| {
+                        let root = self.world.objects.linkset_root(idx);
+                        let mut row = self.control_object_row(idx)?;
+                        row["root"] = json!(self.world.objects.get(root).map(|r| r.full_id));
+                        row["attachment_point"] = json!(self.world.objects.get(root).map(|r| r.attachment_point()));
+                        row["local_position"] = vec3_json(o.position);
+                        row["scale"] = vec3_json(o.scale);
+                        row["faces"] = json!(o.te.as_ref().map(|te| te.faces.len()));
+                        if hud {
+                            row.as_object_mut().map(|m| m.remove("distance"));
+                        }
+                        Some(row)
+                    })
+                    .collect();
+                Ok(page(rows, offset, limit))
+            }
+            "parcel" => {
+                self.require_world()?;
+                if rlva.has("showloc") {
+                    return Err(ControlError::refused("RLVa hides the location (@showloc)"));
+                }
+                Ok(json!({
+                    "name": self.world.parcel_name,
+                    "info": self.world.parcel.as_deref().map(|p| json!({
+                        "local_id": p.local_id,
+                        "name": p.name,
+                        "description": p.desc,
+                        "owner": p.owner_id,
+                        "area": p.area,
+                    })),
+                    "region": self.world.main().map(|r| &r.name),
+                }))
+            }
+            "friends" => {
+                let rows = self
+                    .world
+                    .social
+                    .friends
+                    .iter()
+                    .map(|f| json!({"id": f.id, "name": self.world.social.name_of(&f.id), "online": f.online}))
+                    .collect();
+                Ok(page(rows, offset, limit))
+            }
+            "groups" => {
+                let rows = self
+                    .world
+                    .groups
+                    .groups
+                    .iter()
+                    .map(|g| json!({"id": g.id, "name": g.name, "accept_notices": g.accept_notices}))
+                    .collect();
+                Ok(page(rows, offset, limit))
+            }
+            "notifications" => {
+                let rows = self.world.notifications.list.iter().map(notification).collect();
+                Ok(page(rows, offset, limit))
+            }
+            "inventory" => self.control_inventory_query(args, offset, limit),
+            "contents" => self.control_contents_query(args),
+            "documents" => self.control_documents_query(args),
+            other => Err(ControlError::invalid(format!(
+                "unknown topic {other}; topics: chat, conversations, im, avatars, objects, object, huds, attachments, parcel, friends, groups, notifications, inventory, contents, documents"
+            ))),
+        }
+    }
+
+    fn control_inventory_query(&self, args: &Map<String, Value>, offset: usize, limit: usize) -> Outcome {
+        if self.world.rlva.has("showinv") {
+            return Err(ControlError::refused("RLVa closes the inventory (@showinv)"));
+        }
+        let inv = &self.world.inventory;
+        if inv.root.is_nil() {
+            return Err(ControlError::unavailable("no inventory yet"));
+        }
+        let worn = crate::ui::appearance::items::worn_items(&self.world);
+        if let Some(id) = opt_uuid(args, "id")? {
+            return inventory_row(inv, &worn, id).ok_or_else(|| ControlError::not_found("not in the cached inventory; fetch its folder"));
+        }
+        if let Some(search) = opt_str(args, "search")? {
+            let needle = search.to_lowercase();
+            let mut rows: Vec<Value> = inv
+                .folders
+                .values()
+                .filter(|f| f.info.name.to_lowercase().contains(&needle))
+                .filter_map(|f| inventory_row(inv, &worn, f.info.id))
+                .chain(
+                    inv.items
+                        .values()
+                        .filter(|i| i.name.to_lowercase().contains(&needle))
+                        .filter_map(|i| inventory_row(inv, &worn, i.id)),
+                )
+                .collect();
+            rows.sort_by(|a, b| a["name"].as_str().cmp(&b["name"].as_str()));
+            return Ok(page(rows, offset, limit));
+        }
+        let parent = opt_uuid(args, "parent")?.unwrap_or(inv.root);
+        let folder = inv
+            .folders
+            .get(&parent)
+            .ok_or_else(|| ControlError::not_found("folder not known; fetch its parent first"))?;
+        let rows: Vec<Value> = folder
+            .children
+            .iter()
+            .chain(&folder.items)
+            .filter_map(|id| inventory_row(inv, &worn, *id))
+            .collect();
+        let mut result = page(rows, offset, limit);
+        result["state"] = json!(format!("{:?}", folder.state).to_ascii_lowercase());
+        result["parent"] = json!(parent);
+        Ok(result)
+    }
+}
+
+/// Newest lines by default: `offset` counts back from the latest line.
+fn latest_page(rows: Vec<Value>, offset: usize, limit: usize, latest: bool) -> Value {
+    if !latest {
+        return page(rows, offset, limit);
+    }
+    let total = rows.len();
+    let end = total.saturating_sub(offset);
+    let start = end.saturating_sub(limit);
+    let next = (start > 0).then_some(offset + (end - start));
+    json!({"rows": rows[start..end], "total": total, "offset": offset, "next_offset": next, "latest": true})
+}
+
+pub(super) fn perm_names(mask: u32) -> Vec<&'static str> {
+    // PERM_TRANSFER, PERM_MODIFY, PERM_COPY, PERM_MOVE (llpermissionsflags.h)
+    [(0x2000, "transfer"), (0x4000, "modify"), (0x8000, "copy"), (0x80000, "move")]
+        .into_iter()
+        .filter(|(bit, _)| mask & bit != 0)
+        .map(|(_, name)| name)
+        .collect()
+}
+
+fn inventory_row(inv: &crate::world::inventory::Inventory, worn: &HashSet<Uuid>, id: Uuid) -> Option<Value> {
+    if let Some(f) = inv.folders.get(&id) {
+        return Some(json!({
+            "id": id,
+            "parent": f.info.parent,
+            "name": f.info.name,
+            "folder": true,
+            "type": f.info.type_default,
+            "state": format!("{:?}", f.state).to_ascii_lowercase(),
+            "library": f.library,
+            "children": f.children.len() + f.items.len(),
+        }));
+    }
+    let item = inv.items.get(&id)?;
+    Some(json!({
+        "id": id,
+        "parent": item.parent,
+        "name": item.name,
+        "description": item.desc,
+        "folder": false,
+        "asset_type": item.asset_type,
+        "inv_type": item.inv_type,
+        "permissions": perm_names(crate::world::inventory::actions::held(inv, item)),
+        "worn": worn.contains(&id),
+        "creator": item.creator,
+        "created_ms": item.created_at.max(0) as u64 * 1000,
+    }))
+}
diff --git a/crates/aurora-viewer/src/control/journal.rs b/crates/aurora-viewer/src/control/journal.rs
new file mode 100644
index 00000000..3a0a5720
--- /dev/null
+++ b/crates/aurora-viewer/src/control/journal.rs
@@ -0,0 +1,177 @@
+//! What the bridge remembers between requests: a receipt for each of the last
+//! commands, a bounded ring of numbered events, and the leases that end
+//! automation input nobody renews.
+
+use serde_json::{Value, json};
+use std::collections::VecDeque;
+use std::time::{Duration, Instant, SystemTime};
+
+pub const RECEIPTS: usize = 128;
+pub const EVENTS: usize = 512;
+/// The longest an automation hold or drag lasts without renewal.
+pub const LEASE: Duration = Duration::from_secs(10);
+
+#[derive(Debug, Clone)]
+pub struct Receipt {
+    pub request_id: String,
+    pub tool: String,
+    pub op: Option<String>,
+    pub time: SystemTime,
+    /// The reply's `result` or `error`, as sent.
+    pub outcome: Value,
+    pub ok: bool,
+}
+
+impl Receipt {
+    pub fn to_value(&self) -> Value {
+        json!({
+            "request_id": self.request_id,
+            "tool": self.tool,
+            "op": self.op,
+            "time_ms": super::unix_ms(self.time),
+            "ok": self.ok,
+            "outcome": self.outcome,
+        })
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct Event {
+    pub seq: u64,
+    pub time: SystemTime,
+    pub kind: &'static str,
+    pub request_id: Option<String>,
+    pub data: Value,
+}
+
+impl Event {
+    pub fn to_value(&self) -> Value {
+        json!({
+            "seq": self.seq,
+            "time_ms": super::unix_ms(self.time),
+            "kind": self.kind,
+            "request_id": self.request_id,
+            "data": self.data,
+        })
+    }
+}
+
+pub struct Journal {
+    receipts: VecDeque<Receipt>,
+    events: VecDeque<Event>,
+    next_seq: u64,
+}
+
+impl Default for Journal {
+    fn default() -> Self {
+        Journal {
+            receipts: VecDeque::with_capacity(RECEIPTS),
+            events: VecDeque::with_capacity(EVENTS),
+            next_seq: 1,
+        }
+    }
+}
+
+impl Journal {
+    pub fn record(&mut self, receipt: Receipt) {
+        if self.receipts.len() == RECEIPTS {
+            self.receipts.pop_front();
+        }
+        self.receipts.push_back(receipt);
+    }
+
+    pub fn receipt(&self, request_id: &str) -> Option<&Receipt> {
+        self.receipts.iter().rev().find(|r| r.request_id == request_id)
+    }
+
+    pub fn receipt_count(&self) -> usize {
+        self.receipts.len()
+    }
+
+    pub fn push(&mut self, kind: &'static str, request_id: Option<&str>, data: Value) -> u64 {
+        if self.events.len() == EVENTS {
+            self.events.pop_front();
+        }
+        let seq = self.next_seq;
+        self.next_seq += 1;
+        self.events.push_back(Event {
+            seq,
+            time: SystemTime::now(),
+            kind,
+            request_id: request_id.map(str::to_owned),
+            data,
+        });
+        seq
+    }
+
+    /// The cursor a client keeps: the last event's number (0 before any).
+    pub fn cursor(&self) -> u64 {
+        self.next_seq - 1
+    }
+
+    pub fn oldest(&self) -> u64 {
+        self.events.front().map_or(self.next_seq, |e| e.seq)
+    }
+
+    /// Events after `after`, at most `limit`, optionally for one request.
+    /// `gap` says events after the cursor were already dropped: the client
+    /// must read fresh state instead of assuming what happened.
+    pub fn after(&self, after: u64, limit: usize, request_id: Option<&str>) -> Value {
+        let gap = after < self.oldest().saturating_sub(1) && after < self.cursor();
+        let mut next = after.max(self.oldest().saturating_sub(1)).min(self.cursor());
+        let mut events = Vec::new();
+        for event in self.events.iter().filter(|e| e.seq > after) {
+            if events.len() == limit {
+                break;
+            }
+            next = event.seq;
+            if request_id.is_none_or(|id| event.request_id.as_deref() == Some(id)) {
+                events.push(event.to_value());
+            }
+        }
+        json!({
+            "events": events,
+            "next": next,
+            "oldest": self.oldest(),
+            "cursor": self.cursor(),
+            "gap": gap,
+            "more": next < self.cursor(),
+        })
+    }
+}
+
+/// An automation input that ends on its own `LEASE` after its last renewal.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Lease {
+    until: Option<Instant>,
+}
+
+impl Lease {
+    /// Held for `wanted`, at most `LEASE`, from `now`.
+    pub fn renew(&mut self, now: Instant, wanted: Duration) -> Duration {
+        let held = wanted.min(LEASE);
+        self.until = Some(now + held);
+        held
+    }
+
+    pub fn active(&self, now: Instant) -> bool {
+        self.until.is_some_and(|until| now < until)
+    }
+
+    /// True once when a held lease ran out (the caller releases its input).
+    pub fn expired(&mut self, now: Instant) -> bool {
+        if self.until.is_some_and(|until| now >= until) {
+            self.until = None;
+            return true;
+        }
+        false
+    }
+
+    pub fn release(&mut self) {
+        self.until = None;
+    }
+
+    pub fn remaining_ms(&self, now: Instant) -> u64 {
+        self.until.map_or(0, |until| until.saturating_duration_since(now).as_millis() as u64)
+    }
+}
diff --git a/crates/aurora-viewer/src/control/mod.rs b/crates/aurora-viewer/src/control/mod.rs
new file mode 100644
index 00000000..d2ecc254
--- /dev/null
+++ b/crates/aurora-viewer/src/control/mod.rs
@@ -0,0 +1,428 @@
+//! The local control bridge (forge patch, not upstream Aurora).
+//!
+//! With `AURORA_CONTROL_DIR` set to a short absolute path that does not exist
+//! yet, the viewer creates that directory with owner-only permissions and
+//! listens on `control.sock` inside it. Each connection carries one JSON
+//! request per line and receives one JSON reply per line:
+//!
+//! ```text
+//! {"request_id": "…", "tool": "viewer_state", "arguments": {}}
+//! {"request_id": "…", "result": {…}}            or
+//! {"request_id": "…", "error": {"code": "…", "message": "…"}}
+//! ```
+//!
+//! Connection threads only parse and forward requests; the frame thread
+//! answers them (`app/control.rs`) so every action takes the viewer's own
+//! paths, permission checks and RLVa boundary. Without the variable nothing
+//! here runs.
+
+pub mod journal;
+pub mod settings;
+#[cfg(test)]
+mod tests;
+
+use serde_json::{Map, Value, json};
+use std::io::{BufRead, BufReader, Read, Write};
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+pub use journal::{Journal, Lease};
+
+pub const ENV: &str = "AURORA_CONTROL_DIR";
+pub const SOCKET: &str = "control.sock";
+/// The longest request line read; captures travel the other way.
+const MAX_LINE: u64 = 4 << 20;
+/// How long a connection waits for the frame thread before it answers
+/// `timeout`. The command may still run: its receipt says what happened.
+const REPLY_WAIT: Duration = Duration::from_secs(30);
+/// sockaddr_un's path on macOS holds 104 bytes with its terminator.
+const MAX_SOCKET_PATH: usize = 103;
+/// Requests admitted but not yet answered; more are refused as `busy`.
+const QUEUE: usize = 64;
+
+/// A failed command: a stable code and a human-readable message.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ControlError {
+    pub code: &'static str,
+    pub message: String,
+}
+
+impl ControlError {
+    pub fn new(code: &'static str, message: impl Into<String>) -> ControlError {
+        ControlError {
+            code,
+            message: message.into(),
+        }
+    }
+    pub fn invalid(message: impl Into<String>) -> ControlError {
+        ControlError::new("invalid_argument", message)
+    }
+    pub fn not_found(message: impl Into<String>) -> ControlError {
+        ControlError::new("not_found", message)
+    }
+    /// Native permissions, RLVa, protection or a safety rule said no.
+    pub fn refused(message: impl Into<String>) -> ControlError {
+        ControlError::new("refused", message)
+    }
+    /// The viewer is not in a state that allows it (not in world, busy).
+    pub fn unavailable(message: impl Into<String>) -> ControlError {
+        ControlError::new("unavailable", message)
+    }
+    pub fn to_value(&self) -> Value {
+        json!({"code": self.code, "message": self.message})
+    }
+}
+
+pub type Outcome = Result<Value, ControlError>;
+
+/// One request waiting for the frame thread.
+pub struct Pending {
+    pub request_id: String,
+    pub tool: String,
+    pub arguments: Map<String, Value>,
+    reply: crossbeam_channel::Sender<Value>,
+}
+
+impl Pending {
+    pub fn answer(self, outcome: &Outcome) {
+        let _ = self.reply.send(envelope(&self.request_id, outcome));
+    }
+}
+
+pub fn envelope(request_id: &str, outcome: &Outcome) -> Value {
+    match outcome {
+        Ok(result) => json!({"request_id": request_id, "result": result}),
+        Err(error) => json!({"request_id": request_id, "error": error.to_value()}),
+    }
+}
+
+/// A request line: its id (assigned when absent), tool and arguments.
+pub fn parse_request(line: &str) -> Result<(String, String, Map<String, Value>), (String, ControlError)> {
+    let fresh = || uuid::Uuid::new_v4().to_string();
+    let value: Value = serde_json::from_str(line).map_err(|e| (fresh(), ControlError::invalid(format!("request is not JSON: {e}"))))?;
+    let Value::Object(mut object) = value else {
+        return Err((fresh(), ControlError::invalid("request must be a JSON object")));
+    };
+    let request_id = match object.remove("request_id") {
+        None | Some(Value::Null) => fresh(),
+        Some(Value::String(id)) if !id.is_empty() && id.len() <= 128 => id,
+        Some(_) => return Err((fresh(), ControlError::invalid("request_id must be a string of 1 to 128 bytes"))),
+    };
+    let tool = match object.remove("tool") {
+        Some(Value::String(tool)) => tool,
+        _ => return Err((request_id, ControlError::invalid("tool must be a string"))),
+    };
+    let arguments = match object.remove("arguments") {
+        None | Some(Value::Null) => Map::new(),
+        Some(Value::Object(arguments)) => arguments,
+        Some(_) => return Err((request_id, ControlError::invalid("arguments must be a JSON object"))),
+    };
+    Ok((request_id, tool, arguments))
+}
+
+/// Checks `AURORA_CONTROL_DIR` before anything is created.
+pub fn validate_dir(dir: &Path) -> Result<PathBuf, String> {
+    if !dir.is_absolute() {
+        return Err(format!("{ENV} must be an absolute path"));
+    }
+    if dir.components().any(|c| matches!(c, std::path::Component::ParentDir)) {
+        return Err(format!("{ENV} must not contain '..'"));
+    }
+    let socket = dir.join(SOCKET);
+    if socket.as_os_str().len() > MAX_SOCKET_PATH {
+        return Err(format!("{ENV} is too long for a local socket ({} bytes allowed for the socket path)", MAX_SOCKET_PATH));
+    }
+    if std::fs::symlink_metadata(dir).is_ok() {
+        return Err(format!("{ENV} {} already exists; the viewer creates it", dir.display()));
+    }
+    match dir.parent().map(std::fs::metadata) {
+        Some(Ok(meta)) if meta.is_dir() => Ok(socket),
+        _ => Err(format!("the parent of {ENV} {} must be an existing directory", dir.display())),
+    }
+}
+
+/// The listening endpoint; dropping it removes the socket and directory.
+pub struct Endpoint {
+    dir: PathBuf,
+    socket: PathBuf,
+    requests: crossbeam_channel::Receiver<Pending>,
+}
+
+impl Endpoint {
+    /// The endpoint `AURORA_CONTROL_DIR` asks for; none without it or when it
+    /// cannot be made safely (the reason is logged, the viewer runs on).
+    pub fn from_env() -> Option<Endpoint> {
+        let dir = PathBuf::from(std::env::var_os(ENV)?);
+        match Endpoint::open(&dir) {
+            Ok(endpoint) => {
+                log::info!("control bridge listening at {}", endpoint.socket.display());
+                Some(endpoint)
+            }
+            Err(error) => {
+                log::error!("control bridge not started: {error}");
+                None
+            }
+        }
+    }
+
+    pub fn open(dir: &Path) -> Result<Endpoint, String> {
+        use std::os::unix::fs::{DirBuilderExt, PermissionsExt};
+        let socket = validate_dir(dir)?;
+        // create, not create_all: an existing directory (or one made between
+        // the check and here) is refused rather than reused
+        std::fs::DirBuilder::new()
+            .mode(0o700)
+            .create(dir)
+            .map_err(|e| format!("cannot create {}: {e}", dir.display()))?;
+        let cleanup = |message: String| {
+            let _ = std::fs::remove_dir(dir);
+            message
+        };
+        let meta = std::fs::symlink_metadata(dir).map_err(|e| cleanup(e.to_string()))?;
+        if !meta.is_dir() || meta.permissions().mode() & 0o077 != 0 {
+            return Err(cleanup(format!("{} is not a private directory", dir.display())));
+        }
+        let listener = std::os::unix::net::UnixListener::bind(&socket).map_err(|e| cleanup(format!("cannot listen: {e}")))?;
+        let _ = std::fs::set_permissions(&socket, std::fs::Permissions::from_mode(0o600));
+        let (sender, requests) = crossbeam_channel::bounded(QUEUE);
+        std::thread::Builder::new()
+            .name("aurora-control".into())
+            .spawn(move || accept(listener, sender))
+            .map_err(|e| {
+                let _ = std::fs::remove_file(&socket);
+                cleanup(format!("cannot start the listener: {e}"))
+            })?;
+        Ok(Endpoint {
+            dir: dir.to_path_buf(),
+            socket,
+            requests,
+        })
+    }
+
+    pub fn try_recv(&self) -> Option<Pending> {
+        self.requests.try_recv().ok()
+    }
+
+    pub fn waiting(&self) -> bool {
+        !self.requests.is_empty()
+    }
+
+    pub fn socket(&self) -> &Path {
+        &self.socket
+    }
+}
+
+impl Drop for Endpoint {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.socket);
+        let _ = std::fs::remove_dir(&self.dir);
+    }
+}
+
+fn accept(listener: std::os::unix::net::UnixListener, sender: crossbeam_channel::Sender<Pending>) {
+    for stream in listener.incoming() {
+        let Ok(stream) = stream else { continue };
+        if !same_user(&stream) {
+            log::warn!("control bridge: refused a connection from another user");
+            continue;
+        }
+        let sender = sender.clone();
+        let _ = std::thread::Builder::new()
+            .name("aurora-control-conn".into())
+            .spawn(move || serve(stream, sender));
+    }
+}
+
+/// The directory is already owner-only; the peer's uid is checked as well.
+fn same_user(stream: &std::os::unix::net::UnixStream) -> bool {
+    use std::os::fd::AsRawFd;
+    let (mut uid, mut gid) = (0, 0);
+    // SAFETY: getpeereid writes two integers through valid pointers for an
+    // open socket descriptor.
+    let ok = unsafe { libc::getpeereid(stream.as_raw_fd(), &mut uid, &mut gid) } == 0;
+    // SAFETY: geteuid has no preconditions.
+    ok && uid == unsafe { libc::geteuid() }
+}
+
+fn serve(stream: std::os::unix::net::UnixStream, sender: crossbeam_channel::Sender<Pending>) {
+    let Ok(writer) = stream.try_clone() else { return };
+    let mut writer = std::io::BufWriter::new(writer);
+    let mut reader = BufReader::new(stream);
+    loop {
+        let mut line = String::new();
+        match (&mut reader).take(MAX_LINE).read_line(&mut line) {
+            Ok(0) | Err(_) => return,
+            Ok(_) => {}
+        }
+        if !line.ends_with('\n') && line.len() as u64 >= MAX_LINE {
+            let reply = envelope("", &Err(ControlError::invalid("request line too long")));
+            let _ = writeln!(writer, "{reply}").and_then(|_| writer.flush());
+            return;
+        }
+        if line.trim().is_empty() {
+            continue;
+        }
+        let reply = match parse_request(line.trim()) {
+            Err((request_id, error)) => envelope(&request_id, &Err(error)),
+            Ok((request_id, tool, arguments)) => {
+                let (reply, answer) = crossbeam_channel::bounded(1);
+                let pending = Pending {
+                    request_id: request_id.clone(),
+                    tool,
+                    arguments,
+                    reply,
+                };
+                match sender.try_send(pending) {
+                    Ok(()) => {}
+                    Err(crossbeam_channel::TrySendError::Full(_)) => {
+                        let busy = ControlError::new("busy", "the viewer has too many requests waiting; nothing was run, retry later");
+                        if writeln!(writer, "{}", envelope(&request_id, &Err(busy))).and_then(|_| writer.flush()).is_err() {
+                            return;
+                        }
+                        continue;
+                    }
+                    Err(crossbeam_channel::TrySendError::Disconnected(_)) => return,
+                }
+                answer.recv_timeout(REPLY_WAIT).unwrap_or_else(|_| {
+                    envelope(
+                        &request_id,
+                        &Err(ControlError::new(
+                            "timeout",
+                            "the viewer did not answer in time; inspect viewer_events with this request_id before any retry",
+                        )),
+                    )
+                })
+            }
+        };
+        if writeln!(writer, "{reply}").and_then(|_| writer.flush()).is_err() {
+            return;
+        }
+    }
+}
+
+// Argument helpers shared by the tools.
+
+pub fn arg<'a>(args: &'a Map<String, Value>, name: &str) -> Option<&'a Value> {
+    args.get(name).filter(|v| !v.is_null())
+}
+
+pub fn str_arg<'a>(args: &'a Map<String, Value>, name: &str) -> Result<&'a str, ControlError> {
+    opt_str(args, name)?.ok_or_else(|| ControlError::invalid(format!("{name} is required")))
+}
+
+pub fn opt_str<'a>(args: &'a Map<String, Value>, name: &str) -> Result<Option<&'a str>, ControlError> {
+    match arg(args, name) {
+        None => Ok(None),
+        Some(Value::String(s)) => Ok(Some(s)),
+        Some(_) => Err(ControlError::invalid(format!("{name} must be a string"))),
+    }
+}
+
+pub fn uuid_arg(args: &Map<String, Value>, name: &str) -> Result<uuid::Uuid, ControlError> {
+    opt_uuid(args, name)?.ok_or_else(|| ControlError::invalid(format!("{name} is required")))
+}
+
+pub fn opt_uuid(args: &Map<String, Value>, name: &str) -> Result<Option<uuid::Uuid>, ControlError> {
+    opt_str(args, name)?
+        .map(|s| uuid::Uuid::parse_str(s).map_err(|_| ControlError::invalid(format!("{name} must be a UUID"))))
+        .transpose()
+}
+
+pub fn opt_bool(args: &Map<String, Value>, name: &str) -> Result<Option<bool>, ControlError> {
+    match arg(args, name) {
+        None => Ok(None),
+        Some(Value::Bool(b)) => Ok(Some(*b)),
+        Some(_) => Err(ControlError::invalid(format!("{name} must be a boolean"))),
+    }
+}
+
+pub fn opt_f64(args: &Map<String, Value>, name: &str) -> Result<Option<f64>, ControlError> {
+    match arg(args, name) {
+        None => Ok(None),
+        Some(v) => v
+            .as_f64()
+            .filter(|f| f.is_finite())
+            .map(Some)
+            .ok_or_else(|| ControlError::invalid(format!("{name} must be a finite number"))),
+    }
+}
+
+/// A number that stays finite as an `f32` (1e100 does not).
+pub fn opt_f32(args: &Map<String, Value>, name: &str) -> Result<Option<f32>, ControlError> {
+    match opt_f64(args, name)? {
+        None => Ok(None),
+        Some(f) if (f as f32).is_finite() => Ok(Some(f as f32)),
+        Some(_) => Err(ControlError::invalid(format!("{name} is out of range"))),
+    }
+}
+
+pub fn opt_u64(args: &Map<String, Value>, name: &str) -> Result<Option<u64>, ControlError> {
+    match arg(args, name) {
+        None => Ok(None),
+        Some(v) => v
+            .as_u64()
+            .map(Some)
+            .ok_or_else(|| ControlError::invalid(format!("{name} must be a non-negative integer"))),
+    }
+}
+
+pub fn opt_i64(args: &Map<String, Value>, name: &str) -> Result<Option<i64>, ControlError> {
+    match arg(args, name) {
+        None => Ok(None),
+        Some(v) => v
+            .as_i64()
+            .map(Some)
+            .ok_or_else(|| ControlError::invalid(format!("{name} must be an integer"))),
+    }
+}
+
+pub fn opt_vec3(args: &Map<String, Value>, name: &str) -> Result<Option<glam::Vec3>, ControlError> {
+    match arg(args, name) {
+        None => Ok(None),
+        Some(Value::Array(a)) if a.len() == 3 => {
+            let mut out = [0.0f32; 3];
+            for (slot, v) in out.iter_mut().zip(a) {
+                *slot = v
+                    .as_f64()
+                    .map(|f| f as f32)
+                    .filter(|f| f.is_finite())
+                    .ok_or_else(|| ControlError::invalid(format!("{name} must hold three finite numbers")))?;
+            }
+            Ok(Some(glam::Vec3::from_array(out)))
+        }
+        Some(_) => Err(ControlError::invalid(format!("{name} must be [x, y, z]"))),
+    }
+}
+
+pub fn vec3_arg(args: &Map<String, Value>, name: &str) -> Result<glam::Vec3, ControlError> {
+    opt_vec3(args, name)?.ok_or_else(|| ControlError::invalid(format!("{name} is required")))
+}
+
+/// `offset`/`limit` paging: limit defaults to 50, at most 200.
+pub fn paging(args: &Map<String, Value>) -> Result<(usize, usize), ControlError> {
+    let offset = opt_u64(args, "offset")?.unwrap_or(0) as usize;
+    let limit = opt_u64(args, "limit")?.unwrap_or(50).clamp(1, 200) as usize;
+    Ok((offset, limit))
+}
+
+/// One page of `rows`, with `total` and `next_offset` (null on the last page).
+pub fn page(rows: Vec<Value>, offset: usize, limit: usize) -> Value {
+    let total = rows.len();
+    let shown: Vec<Value> = rows.into_iter().skip(offset).take(limit).collect();
+    let next = (offset + shown.len() < total).then_some(offset + shown.len());
+    json!({"rows": shown, "total": total, "offset": offset, "next_offset": next})
+}
+
+pub fn vec3_json(v: glam::Vec3) -> Value {
+    let round = |f: f32| (f64::from(f) * 1000.0).round() / 1000.0;
+    json!([round(v.x), round(v.y), round(v.z)])
+}
+
+pub fn quat_json(q: glam::Quat) -> Value {
+    let round = |f: f32| (f64::from(f) * 10000.0).round() / 10000.0;
+    json!([round(q.x), round(q.y), round(q.z), round(q.w)])
+}
+
+pub fn unix_ms(time: std::time::SystemTime) -> u64 {
+    time.duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as u64).unwrap_or(0)
+}
diff --git a/crates/aurora-viewer/src/control/settings.rs b/crates/aurora-viewer/src/control/settings.rs
new file mode 100644
index 00000000..0218cee9
--- /dev/null
+++ b/crates/aurora-viewer/src/control/settings.rs
@@ -0,0 +1,149 @@
+//! `viewer_settings`: JSON Pointer reads and type-preserving writes over the
+//! serialized preferences. Login, account, proxy, update and RLVa settings
+//! are not reachable: the bridge never handles credentials or lifts
+//! restrictions.
+
+use super::ControlError;
+use serde_json::Value;
+
+/// Top-level settings the bridge neither reads nor writes.
+const HIDDEN: &[&str] = &[
+    "username",
+    "remember_username",
+    "last_login",
+    "remember_password",
+    "grid",
+    "custom_login_uri",
+    "grids",
+    "start_location",
+    "start_region",
+    "mfa_hash",
+    "proxy",
+    "rlva_enabled",
+    "rlva",
+    "crash_reports",
+];
+
+/// Words that mark a secret anywhere in a pointer.
+const SECRET_WORDS: &[&str] = &["password", "token", "secret", "credential", "mfa"];
+
+fn segments(pointer: &str) -> Result<Vec<String>, ControlError> {
+    if pointer.is_empty() {
+        return Ok(Vec::new());
+    }
+    let Some(rest) = pointer.strip_prefix('/') else {
+        return Err(ControlError::invalid("pointer must be empty or start with '/'"));
+    };
+    Ok(rest.split('/').map(|s| s.replace("~1", "/").replace("~0", "~")).collect())
+}
+
+pub fn hidden(pointer: &str) -> bool {
+    let Ok(parts) = segments(pointer) else { return true };
+    let Some(first) = parts.first() else { return false };
+    HIDDEN.contains(&first.as_str())
+        || first.starts_with("login")
+        || first.starts_with("update")
+        || parts.iter().any(|p| {
+            let lower = p.to_ascii_lowercase();
+            SECRET_WORDS.iter().any(|w| lower.contains(w))
+        })
+}
+
+/// The visible top-level keys, sorted.
+pub fn list(tree: &Value) -> Vec<String> {
+    let mut keys: Vec<String> = tree
+        .as_object()
+        .map(|o| o.keys().filter(|k| !hidden(&format!("/{k}"))).cloned().collect())
+        .unwrap_or_default();
+    keys.sort();
+    keys
+}
+
+fn escape(key: &str) -> String {
+    key.replace('~', "~0").replace('/', "~1")
+}
+
+/// Removes the hidden keys below `pointer` from `value`; true if any was.
+fn redact(value: &mut Value, pointer: &str) -> bool {
+    match value {
+        Value::Object(map) => {
+            let before = map.len();
+            map.retain(|k, _| !hidden(&format!("{pointer}/{}", escape(k))));
+            let mut removed = map.len() != before;
+            for (k, v) in map.iter_mut() {
+                removed |= redact(v, &format!("{pointer}/{}", escape(k)));
+            }
+            removed
+        }
+        Value::Array(items) => {
+            let mut removed = false;
+            for (i, v) in items.iter_mut().enumerate() {
+                removed |= redact(v, &format!("{pointer}/{i}"));
+            }
+            removed
+        }
+        _ => false,
+    }
+}
+
+fn read(tree: &Value, pointer: &str) -> Result<Value, ControlError> {
+    if pointer.is_empty() {
+        return Err(ControlError::invalid("read a specific pointer; list shows the top-level keys"));
+    }
+    if hidden(pointer) {
+        return Err(ControlError::refused("this setting is not available through the control bridge"));
+    }
+    tree.pointer(pointer)
+        .cloned()
+        .ok_or_else(|| ControlError::not_found(format!("no setting at {pointer}")))
+}
+
+/// The value at `pointer`, without the hidden settings below it.
+pub fn get(tree: &Value, pointer: &str) -> Result<Value, ControlError> {
+    let mut value = read(tree, pointer)?;
+    redact(&mut value, pointer);
+    Ok(value)
+}
+
+fn kind(v: &Value) -> &'static str {
+    match v {
+        Value::Null => "null",
+        Value::Bool(_) => "boolean",
+        Value::Number(n) if n.is_f64() => "number",
+        Value::Number(_) => "integer",
+        Value::String(_) => "string",
+        Value::Array(_) => "array",
+        Value::Object(_) => "object",
+    }
+}
+
+/// Replaces the value at `pointer`, which must exist, with one of the same
+/// JSON type (an integer may stand for a number, not the reverse). Returns
+/// the previous value.
+pub fn set(tree: &mut Value, pointer: &str, value: Value) -> Result<Value, ControlError> {
+    let previous = read(tree, pointer)?;
+    // a hidden setting below would be replaced with its parent: set the
+    // visible children one by one instead
+    if redact(&mut previous.clone(), pointer) || redact(&mut value.clone(), pointer) {
+        return Err(ControlError::refused("this value holds settings that are not available through the control bridge"));
+    }
+    let compatible = match (&previous, &value) {
+        (Value::Number(old), Value::Number(new)) => old.is_f64() || !new.is_f64(),
+        // an optional setting that is unset accepts any value; the
+        // deserializer decides
+        (Value::Null, _) => true,
+        (old, new) => kind(old) == kind(new),
+    };
+    if !compatible {
+        return Err(ControlError::invalid(format!(
+            "{pointer} holds a {}, not a {}",
+            kind(&previous),
+            kind(&value)
+        )));
+    }
+    let slot = tree
+        .pointer_mut(pointer)
+        .ok_or_else(|| ControlError::not_found(format!("no setting at {pointer}")))?;
+    *slot = value;
+    Ok(previous)
+}
