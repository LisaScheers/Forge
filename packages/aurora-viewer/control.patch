+    pub(super) fn control_contents_query(&self, args: &Map<String, Value>) -> Outcome {
+        let id = uuid_arg(args, "id")?;
+        let Some(listing) = self.build.contents.objects.get(&id) else {
+            return Ok(json!({"id": id, "known": false, "loading": false, "items": []}));
+        };
+        let items: Vec<Value> = listing
+            .items
+            .iter()
+            .map(|i| {
+                json!({
+                    "id": i.item_id,
+                    "name": i.name,
+                    "description": i.description,
+                    "asset_type": i.asset_type,
+                    "inv_type": i.inv_type,
+                    "owner_permissions": query::perm_names(i.owner_mask),
+                    "next_owner_permissions": query::perm_names(i.next_owner_mask),
+                    "creator": i.creator_id,
+                })
+            })
+            .collect();
+        Ok(json!({"id": id, "known": listing.requested.is_some() || !listing.items.is_empty(), "loading": listing.loading, "items": items}))
