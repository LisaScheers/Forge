+// Discord reactions remain chat reactions, including double-puppeted accounts.
+export function isBridgedReaction(sender: string, content: Record<string, unknown>, domain: string): boolean {
+  const localpart = sender.split(':', 1)[0];
+  const ghost = localpart.startsWith('@discord_') && /^\d+$/.test(localpart.slice(9)) && sender.endsWith(`:${domain}`);
+  return ghost || sender === `@discordbot:${domain}` || content['fi.mau.discord.source_reaction'] === true ||
+    content['fi.mau.discord.imported_reaction'] != null;
+}
