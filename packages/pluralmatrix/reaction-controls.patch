@@ -0,0 +1,21 @@
+import { isBridgedReaction } from '../deploymentPolicy';
+
+describe('Discord reaction provenance', () => {
+  test('recognizes local Discord ghosts and the dedicated bridge bot', () => {
+    expect(isBridgedReaction('@discord_123:test', {}, 'test')).toBe(true);
+    expect(isBridgedReaction('@discordbot:test', {}, 'test')).toBe(true);
+    expect(isBridgedReaction('@discord_123:remote', {}, 'test')).toBe(false);
+    expect(isBridgedReaction('@discord_alice:test', {}, 'test')).toBe(false);
+  });
+  test('preserves source reactions from a linked real Matrix account', () => {
+    expect(isBridgedReaction('@alice:test', {'fi.mau.discord.source_reaction': true}, 'test')).toBe(true);
+    expect(isBridgedReaction('@alice:test', {'fi.mau.discord.source_reaction': false}, 'test')).toBe(false);
+  });
+  test('recognizes already imported historical reactions', () => {
+    expect(isBridgedReaction('@alice:test', {'fi.mau.discord.imported_reaction': {types: [0]}}, 'test')).toBe(true);
+  });
+  test('ordinary Matrix reactions retain PluralMatrix control eligibility', () => {
+    expect(isBridgedReaction('@alice:test', {}, 'test')).toBe(false);
+    expect(isBridgedReaction('@_plural_system_member:test', {}, 'test')).toBe(false);
+  });
+});
