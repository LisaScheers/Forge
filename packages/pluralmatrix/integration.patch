+    await prisma.inboundEvent.updateMany({where: {id: event.event_id}, data: {done: true, payload: '', delivery: null, isProxy: true, cancelledReason: 'membership_removed'}});
+  } finally { processingEvents.delete(event.event_id); }
+}
+const scheduledEvents = new Set<string>();
+const roomWork = new Map<string, Promise<void>>();
+async function processRoomEvent(event: WeakEvent) {
+  if (scheduledEvents.has(event.event_id)) return;
+  scheduledEvents.add(event.event_id);
+  const previous = roomWork.get(event.room_id) || Promise.resolve();
+  const current = previous.catch(() => {}).then(() => processEventData(event));
+  roomWork.set(event.room_id, current);
+  try { await current; } finally {
+    scheduledEvents.delete(event.event_id);
+    if (roomWork.get(event.room_id) === current) roomWork.delete(event.room_id);
+  }
+}
+async function processEvent(request: Request<WeakEvent>) { return processRoomEvent(request.getData()); }
