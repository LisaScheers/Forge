+export class RoomMembershipRemoved extends Error {}
+
+export async function requireJoinedAccount(bridge: Bridge, roomId: string, sender: string) {
+  if (!isEnabledRoom(roomId)) throw new Error('PluralMatrix is not enabled in this room');
+  const state = await bridge.getIntent().matrixClient.getRoomStateEvent(roomId, 'm.room.member', sender);
+  if (state?.membership !== 'join') throw new RoomMembershipRemoved('The account is no longer a room member');
+}
