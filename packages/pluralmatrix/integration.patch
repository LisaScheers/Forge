diff --git a/src/inboundEvents.ts b/src/inboundEvents.ts
new file mode 100644
index 0000000..0102558
--- /dev/null
+++ b/src/inboundEvents.ts
@@ -0,0 +1,38 @@
+import { PrismaClient } from '@prisma/client';
+import { z } from 'zod';
+import { isEnabledRoom } from './deploymentPolicy';
+import { PluralMatrixEventContent } from './types';
+
+const contentSchema: z.ZodType<PluralMatrixEventContent> = z.object({
+  body: z.string().optional(), msgtype: z.string().optional(), format: z.string().optional(),
+  formatted_body: z.string().optional(), url: z.string().optional(),
+  'm.relates_to': z.object({rel_type: z.string().optional(), event_id: z.string().optional(),
+    is_falling_back: z.boolean().optional(), key: z.string().optional(),
+    'm.in_reply_to': z.object({event_id: z.string().optional()}).optional(),
+  }).loose().optional(),
+  'm.new_content': z.lazy(() => contentSchema).optional(),
+}).loose();
+export const deliverySchema = z.object({ghostUserId: z.string(), content: contentSchema, redactionTarget: z.string()});
+
+const eventSchema = z.object({
+  event_id: z.string(), room_id: z.string(), sender: z.string(), type: z.string(),
+  content: contentSchema,
+  origin_server_ts: z.number().default(0), state_key: z.string().optional(),
+  unsigned: z.record(z.string(), z.unknown()).optional(),
+}).loose();
+export type IncomingEvent = z.infer<typeof eventSchema>;
+const transactionSchema = z.object({events: z.array(eventSchema).default([])}).loose();
+
+// Commit before acknowledging the homeserver; pending work survives service restarts.
+export async function retainTransaction(prisma: PrismaClient, body: unknown) {
+  const parsed = transactionSchema.parse(body);
+  const events = parsed.events.filter(event => isEnabledRoom(event.room_id) && event.type === 'm.room.message');
+  if (events.length) await prisma.inboundEvent.createMany({
+    data: events.map(event => ({id: event.event_id, payload: JSON.stringify(event)})), skipDuplicates: true,
+  });
+  return parsed;
+}
+
+export function parseRetainedEvent(payload: string): IncomingEvent {
+  return eventSchema.parse(JSON.parse(payload));
+}
