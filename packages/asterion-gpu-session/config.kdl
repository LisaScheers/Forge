input {
    keyboard {
        xkb { layout "us"; }
        repeat-delay 300
        repeat-rate 40
    }
    touchpad { tap; natural-scroll; dwt; }
}

output "eDP-1" { scale 2; }

layout {
    background-color "#000000"
    gaps 5
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 1
        active-color "#ffffff"
        inactive-color "#444444"
    }
    border { off; }
}

workspace "code"
workspace "web"
workspace "chat"
prefer-no-csd
animations { off; }
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d-%H-%M-%S.png"
cursor {
    xcursor-theme "DMZ-White"
    xcursor-size 24
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

layer-rule {
    match namespace="^noctalia-"
    background-effect { blur false; }
}

debug {
    render-drm-device "@renderDevice@"
    disable-cursor-plane
    disable-direct-scanout
    honor-xdg-activation-with-invalid-serial
}

@terminalStartup@
spawn-at-startup "@noctalia@"

binds {
    @installedBindings@
    Mod+Return { spawn "@terminal@"; }
    Mod+D { spawn "@noctalia@" "msg" "panel-toggle" "launcher"; }
    Mod+Space { spawn "@noctalia@" "msg" "panel-toggle" "launcher"; }
    Mod+S { spawn "@noctalia@" "msg" "panel-toggle" "control-center"; }
    Mod+Comma { spawn "@noctalia@" "msg" "settings-toggle"; }
    Mod+Shift+D { spawn "@launcher@"; }
    Mod+Shift+Q { close-window; }
    Mod+Q { close-window; }
    Mod+Shift+E { spawn "@noctalia@" "msg" "panel-toggle" "session"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+O { toggle-overview; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+V { toggle-window-floating; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+1 { focus-workspace "code"; }
    Mod+2 { focus-workspace "web"; }
    Mod+3 { focus-workspace "chat"; }
    Mod+Shift+1 { move-column-to-workspace "code"; }
    Mod+Shift+2 { move-column-to-workspace "web"; }
    Mod+Shift+3 { move-column-to-workspace "chat"; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Print { screenshot; }
    Mod+Shift+S { screenshot; }
    Mod+Print { screenshot-window; }
    Mod+Shift+Print { screenshot-screen; }
}
