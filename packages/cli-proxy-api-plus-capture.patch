+package logging
+
+import (
+	"testing"
+	"time"
+)
+
+func TestForgeFullCaptureQueueAppliesBackpressure(t *testing.T) {
+	writer := &FileStreamingLogWriter{chunkChan: make(chan []byte, 1)}
+	writer.WriteChunkAsync([]byte("first"))
+	done := make(chan struct{})
+	go func() {
+		writer.WriteChunkAsync([]byte("second"))
+		close(done)
+	}()
+	select {
+	case <-done:
+		t.Fatal("full capture queue discarded a chunk")
+	case <-time.After(20 * time.Millisecond):
+	}
+	if got := string(<-writer.chunkChan); got != "first" {
+		t.Fatalf("first chunk = %q", got)
+	}
+	select {
+	case chunk := <-writer.chunkChan:
+		if string(chunk) != "second" {
+			t.Fatalf("second chunk = %q", chunk)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("second chunk was not captured")
+	}
+	<-done
+}
