+struct CapturingSseTelemetry {
+    inner: Arc<dyn SseTelemetry>,
+    observer: codex_api::RawResponseObserver,
+}
+
+impl SseTelemetry for CapturingSseTelemetry {
+    fn on_sse_poll(
+        &self,
+        result: &std::result::Result<
+            Option<std::result::Result<Event, EventStreamError<TransportError>>>,
+            tokio::time::error::Elapsed,
+        >,
+        duration: Duration,
+    ) {
+        if let Ok(Some(Ok(event))) = result {
+            (self.observer)(&event.data);
+        }
+        self.inner.on_sse_poll(result, duration);
