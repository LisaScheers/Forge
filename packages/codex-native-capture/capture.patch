+    /// Preserve original provider JSON, including deltas and future usage fields.
+    pub fn raw_response_observer(&self) -> Option<Arc<dyn Fn(&str) + Send + Sync>> {
+        let InferenceTraceAttemptState::Enabled(attempt) = &self.state else {
+            return None;
+        };
+        let context = attempt.context.clone();
+        let inference_call_id = attempt.inference_call_id.clone();
+        Some(Arc::new(move |data| {
+            let Some(payload) = write_json_payload_best_effort(
+                &context.writer,
+                RawPayloadKind::InferenceResponse,
+                &serde_json::json!({"data": data}),
+            ) else {
+                return;
+            };
+            append_with_context_best_effort(
+                &context,
+                RawTraceEventPayload::Other {
+                    kind: "raw_response".to_owned(),
+                    summary: String::new(),
+                    payloads: vec![payload],
+                    metadata: serde_json::json!({"inference_call_id": inference_call_id}),
+                },
+            );
+        }))
+    }
