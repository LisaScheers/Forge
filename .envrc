#!/usr/bin/env bash

if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

watch_file flake.nix
watch_file flake.lock

# Watch directories too, so adding or removing a feature reloads the environment.
while IFS= read -r -d '' module_file; do
  watch_file "$module_file"
done < <(find modules packages \( -type d -o -name '*.nix' \) -print0)

if ! use flake .#dev --accept-flake-config --override-input devenv-root "file+file://"<(printf %s "$PWD"); then
  echo "devenv could not be built. Check modules/development/shell.nix and retry." >&2
fi
