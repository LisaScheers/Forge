          "url": "https://beta.ng.bylisa.dev/jacuzzi-onderhoud/",
          "name": "Jacuzzi & wellness",
          "description": "Voor uw jacuzzi of spa vindt u in de winkel waterverzorging en onderhoudsproducten, met advies over wat u wanneer gebruikt.",
          "provider": {
            "@id": "https://beta.ng.bylisa.dev/#business"
          }
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "@id": "https://beta.ng.bylisa.dev/zwembad-overwinteren/#service",
          "url": "https://beta.ng.bylisa.dev/zwembad-overwinteren/",
          "name": "Overwinteren",
          "description": "Zwembad actief overwinteren: de pomp draait regelmatig om bevriezing te voorkomen. Advies en producten bij N&G Pool Service, Heist-op-den-Berg.",
          "provider": {
            "@id": "https://beta.ng.bylisa.dev/#business"
          }
        }
      },
