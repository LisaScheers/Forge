      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "@id": "https://beta.ng.bylisa.dev/zwembad-zelf-bouwen/#service",
          "url": "https://beta.ng.bylisa.dev/zwembad-zelf-bouwen/",
          "name": "Zelfbouwzwembaden",
          "description": "U bouwt zelf, want zelf plaatsen we geen zwembaden. We denken budgetbewust mee en leveren pomp, filter, zeswegkraan en inbouwdelen, van eerste schets tot onderhoud.",
          "provider": {
            "@id": "https://beta.ng.bylisa.dev/#business"
          }
        }
      },
      {
        "@type": "Offer",
